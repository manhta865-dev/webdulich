@*
    Màn hình chờ "lá dừa" (trang của khách, mỗi lần tải trang): hai hàng tàu lá dừa từ hai mép che trang một chút,
    trang dựng xong thì lá tỏa ra hai bên để vào trang.
    Hình lá có sẵn trong HTML nên hiện cùng lúc với nền ngay khung hình đầu (không đợi script vẽ, tránh lá "nhảy" ra sau).
    Chỉ một tàu lá (path tvLaDua, sinh sẵn bằng công thức cuống cong + hai dãy lá chét rủ) dùng lại bằng <use>.
    Mỗi hàng lá là một tấm riêng để trình duyệt chỉ việc trượt tấm khi mở (card đồ họa làm), không vẽ lại lá.
    CSS ở wwwroot/css/man-hinh-cho.css, việc mở ở wwwroot/js/man-hinh-cho.js. Script lỗi thì lớp phủ tự ẩn sau vài giây.
*@
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // Vị trí các tàu trong khung 600 x 1000 của mỗi bên: (x gốc, y gốc, góc xoay, tỉ lệ).
    // Bên phải là bản lật của bên trái (CSS) nhưng xếp khác để hai bên không giống soi gương.
    var hang = new Dictionary<string, (double X, double Y, double Goc, double TiLe)[]>
    {
        ["trai-sau"] = new[] { (-30d, 60d, 22d, 0.86), (-40d, 380d, 4d, 0.92), (-30d, 700d, -12d, 0.9), (-40d, 990d, -26d, 0.84) },
        ["trai-truoc"] = new[] { (-50d, 220d, 12d, 0.78), (-60d, 540d, -4d, 0.82), (-50d, 850d, -18d, 0.78) },
        ["phai-sau"] = new[] { (-40d, -10d, 26d, 0.84), (-30d, 300d, 8d, 0.9), (-40d, 620d, -8d, 0.92), (-30d, 930d, -22d, 0.86) },
        ["phai-truoc"] = new[] { (-60d, 150d, 16d, 0.78), (-50d, 460d, 0d, 0.82), (-60d, 780d, -14d, 0.8) }
    };

    // Hai bộ: màn rộng và màn hẹp (màn hẹp khung bị co theo chiều cao nên tàu lá thu nhỏ còn 62%); CSS chọn bộ hiện
    Microsoft.AspNetCore.Html.IHtmlContent Hang(string ten)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var (lop, heSo) in new[] { ("lon", 1.0), ("nho", 0.62) })
        {
            sb.Append($"<g class=\"{lop}\">");
            foreach (var t in hang[ten])
            {
                sb.Append(string.Create(inv, $"<use href=\"#tvLaDua\" transform=\"translate({t.X} {t.Y}) rotate({t.Goc}) scale({Math.Round(t.TiLe * heSo, 2)})\" />"));
            }
            sb.Append("</g>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}
