@* Thẻ tour dạng ảnh dọc, dùng ở trang chủ và danh sách tour. Model: Tour *@
@model webdulich.Models.Tour
@using Microsoft.AspNetCore.Http
@{
    var item = Model;
    var laAdmin = Context.Session.GetString("role") == "admin";
    var tags = new[] { item.PhuongTienHienThi, item.PhongCachHienThi, item.LoaiDiaHinhHienThi }
        .Where(x => !string.IsNullOrWhiteSpace(x) && x != "Chưa cập nhật")
        .Take(2)
        .ToList();
    var diaDiem = item.TenDiaDiemHienThi;
    var coDiaDiem = !string.IsNullOrWhiteSpace(diaDiem) && diaDiem != "Chưa cập nhật";
}

@if (laAdmin)
{
    <div class="tv-photo-card">
        <img src="~/images/dulich/@item.HinhAnh" alt="@item.TenTour" loading="lazy" />
        <div class="tv-photo-top">
            @if (item.SoNgay.HasValue)
            {
                <span class="tv-pill-tren">@item.SoNgay ngày</span>
            }
        </div>
        <div class="tv-photo-body">
            <h3 class="tv-photo-title">@item.TenTour</h3>
            <div class="tv-photo-gia">@item.Gia.ToString("N0") VNĐ</div>
        </div>
    </div>
}
else
{
    <a asp-controller="DiaDiem" asp-action="ChiTiet" asp-route-id="@item.Id" class="tv-photo-card" aria-label="Xem chi tiết @item.TenTour">
        <img src="~/images/dulich/@item.HinhAnh" alt="" loading="lazy" />
        <div class="tv-photo-top">
            @if (item.SoNgay.HasValue)
            {
                <span class="tv-pill-tren">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-clock" /></svg>
                    @item.SoNgay ngày
                </span>
            }
        </div>
        <div class="tv-photo-body">
            @if (tags.Any())
            {
                <div class="tv-photo-tags">
                    @foreach (var tag in tags)
                    {
                        <span>@tag</span>
                    }
                </div>
            }
            <h3 class="tv-photo-title">@item.TenTour</h3>
            @if (coDiaDiem)
            {
                <div class="tv-photo-place">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-pin" /></svg>
                    @diaDiem
                </div>
            }
            <div class="tv-photo-foot">
                <div>
                    <span class="tv-photo-nho">Giá trọn gói từ</span>
                    <span class="tv-photo-gia">@item.Gia.ToString("N0") VNĐ</span>
                </div>
                <span class="tv-photo-mui" aria-hidden="true"><svg class="tv-icon"><use href="#i-arrow" /></svg></span>
            </div>
        </div>
    </a>
}
