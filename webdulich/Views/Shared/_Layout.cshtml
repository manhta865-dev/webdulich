                font-size: 0.92rem;
            }

            .chat-row.user .chat-bubble {
                background: linear-gradient(135deg, #0d1b3e, #1d4ed8);
                color: #fff;
                border-bottom-right-radius: 5px;
            }

            .chat-row.admin .chat-bubble {
                background: #ffffff;
