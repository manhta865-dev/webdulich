            }

                .ai-help-row.bot {
                    justify-content: flex-start;
                }

                .ai-help-row.user {
                    justify-content: flex-end;
                }

            .ai-help-bubble {
                max-width: 82%;
                padding: 10px 12px;
                border-radius: 16px;
                line-height: 1.45;
                font-size: 0.92rem;
                font-weight: 650;
                white-space: pre-line;
            }

            .ai-help-row.bot .ai-help-bubble {
                background: #eef2ff;
                color: #0f172a;
                border-bottom-left-radius: 5px;
            }

            .ai-help-row.user .ai-help-bubble {
                background: linear-gradient(135deg, #2563eb, #1d4ed8);
                color: #fff;
                border-bottom-right-radius: 5px;
            }

            .ai-help-suggest {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
