    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @* Đã bỏ SweetAlert2 (26/11/2026): không còn chỗ nào gọi Swal, hộp xác nhận dùng xac-nhan.js bên dưới *@
    @* Hộp xác nhận cho mọi form có data-xac-nhan (thay confirm() của trình duyệt) *@
    <script src="~/js/xac-nhan.js" asp-append-version="true"></script>
    <script>
        (function () {
            var nav = document.getElementById("tvNav");
            var navBtn = document.getElementById("tvNavToggle");
            if (nav && navBtn) {
                navBtn.addEventListener("click", function () {
                    var open = nav.classList.toggle("is-open");
                    navBtn.setAttribute("aria-expanded", open ? "true" : "false");
                });

                // Trang chủ: menu nằm trong suốt trên ảnh, đổi sang nền trắng khi cuộn xuống
                if (nav.classList.contains("tv-nav--over")) {
                    var doiNenMenu = function () {
                        nav.classList.toggle("is-solid", window.scrollY > 40);
                    };
                    doiNenMenu();
                    window.addEventListener("scroll", doiNenMenu, { passive: true });
                }
            }
            // Nút sáng/tối: đổi ngay và nhớ lựa chọn cho lần sau
            var goc = document.documentElement;
            function capNhatNutGiaoDien() {
                var toi = goc.getAttribute("data-theme") === "dark";
                document.querySelectorAll("[data-giao-dien]").forEach(function (nut) {
                    nut.setAttribute("aria-pressed", toi ? "true" : "false");
                    nut.setAttribute("aria-label", toi ? "Bật nền sáng" : "Bật nền tối");
                    nut.title = toi ? "Bật nền sáng" : "Bật nền tối";
                });
            }
            document.querySelectorAll("[data-giao-dien]").forEach(function (nut) {
                nut.addEventListener("click", function () {
                    var toi = goc.getAttribute("data-theme") !== "dark";
                    if (toi) {
                        goc.setAttribute("data-theme", "dark");
                        goc.setAttribute("data-bs-theme", "dark");
                    } else {
                        goc.removeAttribute("data-theme");
                        goc.removeAttribute("data-bs-theme");
                    }
                    try { localStorage.setItem("tv-giao-dien", toi ? "toi" : "sang"); } catch (e) { }
                    capNhatNutGiaoDien();
                });
            });
            capNhatNutGiaoDien();

            // Menu tài khoản: bấm ra ngoài hoặc nhấn Esc thì đóng
            var taiKhoan = document.getElementById("tvTaiKhoan");
            if (taiKhoan) {
                document.addEventListener("click", function (e) {
                    if (taiKhoan.open && !taiKhoan.contains(e.target)) taiKhoan.open = false;
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && taiKhoan.open) {
                        taiKhoan.open = false;
                        taiKhoan.querySelector("summary").focus();
                    }
                });
            }

            var admin = document.getElementById("tvAdmin");
            var sideBtn = document.getElementById("tvSideToggle");
            var scrim = document.getElementById("tvScrim");
            if (admin && sideBtn) {
                sideBtn.addEventListener("click", function () { admin.classList.toggle("is-open"); });
                if (scrim) { scrim.addEventListener("click", function () { admin.classList.remove("is-open"); }); }
            }
        })();
    </script>

    @if (currentUser != null && currentRole != "admin" && currentRole != "huongdanvien" && currentRole != "taixe")
    {
        var chatTaiKhoanId = Context.Session.GetInt32("taiKhoanId");
        var chatTinNhans = chatTaiKhoanId.HasValue
        ? ChatDb.TinNhanLienHes
        .Where(x => x.TaiKhoanId == chatTaiKhoanId.Value)
        .OrderBy(x => x.NgayGui)
        .ToList()
        : new List<TinNhanLienHe>();

        var chatSuccess = TempData["ChatSuccess"] as string;
        var chatError = TempData["ChatError"] as string;
        var moChat = !string.IsNullOrWhiteSpace(chatSuccess) || !string.IsNullOrWhiteSpace(chatError);


        <div class="chat-widget">
            <div class="chat-box @(moChat ? "active" : "")" id="chatBox">
                <div class="chat-header">
                    <button type="button" class="chat-close" onclick="toggleChatBox()" aria-label="Đóng">×</button>
                    <h4><svg class="tv-icon" aria-hidden="true"><use href="#i-chat" /></svg> Chat với admin</h4>
                    <p>Admin TravelVN sẽ phản hồi tại đây.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(chatSuccess))
                {
                    <div class="chat-status success">@chatSuccess</div>
                }

                @if (!string.IsNullOrWhiteSpace(chatError))
                {
                    <div class="chat-status error">@chatError</div>
                }

                <div class="chat-messages-user" id="chatMessagesUser">
                    @if (chatTinNhans.Any())
                    {
                        foreach (var item in chatTinNhans)
                        {
                            var laUser = item.NguoiGui == "user";

                            <div class="chat-row @(laUser ? "user" : "admin")">
                                <div class="chat-bubble">
                                    <div>@item.NoiDung</div>

                                    <div class="chat-time">
                                        @(laUser ? "Bạn" : "Admin") · @item.NgayGui.ToString("dd/MM HH:mm")
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="chat-empty">
                            Bạn chưa có tin nhắn nào. Hãy gửi câu hỏi để admin hỗ trợ nhé.
                        </div>
                    }
                </div>

                <div id="userChatForm" class="chat-compose">
                    @Html.AntiForgeryToken()

                    <textarea name="noiDung"
                          id="userChatInput"
                          class="chat-textarea"
                          required
                          placeholder="Nhập tin nhắn của bạn..."></textarea>

                    <button type="button" id="userChatSendBtn" class="chat-submit">
                        Gửi tin nhắn
                    </button>
                </div>
            </div>

            <button type="button" class="chat-toggle" onclick="toggleChatBox()" aria-label="Chat với TravelVN" data-nhan="Chat với TravelVN">
                <svg class="tv-icon" aria-hidden="true"><use href="#i-tro-chuyen" /></svg>
            </button>
        </div>

        <script>
            function toggleChatBox() {
                const chatBox = document.getElementById("chatBox");

                if (chatBox) {
                    // Mỗi lần chỉ mở một khung: mở chat admin thì đóng trợ lý
                    const moRa = chatBox.classList.toggle("active");
                    if (moRa) document.getElementById("aiHelpBox")?.classList.remove("active");
                    setTimeout(scrollUserChatToBottom, 80);
                }
            }

            function scrollUserChatToBottom() {
                const box = document.getElementById("chatMessagesUser");

                if (box) {
                    box.scrollTop = box.scrollHeight;
                }
            }

            function renderUserMessages(messages) {
                const box = document.getElementById("chatMessagesUser");

                if (!box) {
                    return;
                }

                if (!messages || messages.length === 0) {
                    box.innerHTML =
                        '<div class="chat-empty">Bạn chưa có tin nhắn nào. Hãy gửi câu hỏi để admin hỗ trợ nhé.</div>';
                    return;
                }

                box.innerHTML = "";

                messages.forEach(function (item) {
                    const laUser = item.nguoiGui === "user";

                    const row = document.createElement("div");
                    row.className = "chat-row " + (laUser ? "user" : "admin");

                    const bubble = document.createElement("div");
                    bubble.className = "chat-bubble";

                    const content = document.createElement("div");
                    content.textContent = item.noiDung;

                    const time = document.createElement("div");
                    time.className = "chat-time";
                    time.textContent = (laUser ? "Bạn" : "Admin") + " · " + item.thoiGian;

                    bubble.appendChild(content);
                    bubble.appendChild(time);
                    row.appendChild(bubble);
                    box.appendChild(row);
                });

                scrollUserChatToBottom();
            }

            function loadUserMessages() {
                fetch('@Url.Action("LayTinNhan", "LienHe")', {
                    cache: "no-store"
                })
                    .then(function (res) {
                        return res.json();
                    })
                    .then(function (data) {
                        renderUserMessages(data);
                    })
                    .catch(function () {
                    });
            }

            document.addEventListener("DOMContentLoaded", function () {
                const userChatFormElement = document.getElementById("userChatForm");
                const input = document.getElementById("userChatInput");
                const sendBtn = document.getElementById("userChatSendBtn");

                if (userChatFormElement && input && sendBtn) {
                    sendBtn.addEventListener("click", function () {
                        const noiDung = input.value.trim();

                        if (!noiDung) {
                            return;
                        }

                        const formData = new FormData();
                        formData.append("noiDung", noiDung);
                        formData.append("__RequestVerificationToken", userChatFormElement.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "");

                        fetch('@Url.Action("GuiTinNhanAjax", "LienHe")', {
                            method: "POST",
                            body: formData
                        })
                            .then(function (res) {
                                return res.json();
                            })
                            .then(function (data) {
                                if (data.success) {
                                    input.value = "";
                                    loadUserMessages();
                                }
                            });
                    });
                }

                loadUserMessages();
                setInterval(loadUserMessages, 3000);
            });
        </script>
    }

    @if (Context.Session.GetString("role") != "admin" && Context.Session.GetString("role") != "huongdanvien" && Context.Session.GetString("role") != "taixe")
    {

        <div class="ai-help-widget">
            <div class="ai-help-box" id="aiHelpBox">
                <div class="ai-help-header">
                    <div class="ai-help-header-top">
                        <div>
                            <div class="ai-help-title"><svg class="tv-icon" aria-hidden="true"><use href="#i-help" /></svg> Trợ lý TravelVN</div>
                            <div class="ai-help-status">Đang hỗ trợ khách hàng</div>
                        </div>

                        <button type="button" class="ai-help-close" onclick="toggleAiHelpBox()" aria-label="Đóng">×</button>
                    </div>
                </div>

                <div class="ai-help-messages" id="aiHelpMessages" aria-live="polite"></div>

                <div class="ai-help-suggest">
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Gợi ý cho mình tour đi núi cho nhóm bạn')">Tour núi</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Hiện có mã khuyến mãi nào?')">Ưu đãi</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Đặt tour cho nhóm như thế nào?')">Đặt nhóm</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Tôi muốn hủy tour')">Hủy tour</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Hotline là gì')">Hotline</button>
                </div>

                @* Mã chống giả mạo cho lời gọi TroLy/Hoi (gửi trong header RequestVerificationToken) *@
                <span id="aiHelpToken" hidden>@Html.AntiForgeryToken()</span>
                <div class="ai-help-compose">
                    <input id="aiHelpInput"
                           class="ai-help-input"
                           type="text"
                           maxlength="500"
                           aria-label="Câu hỏi cho trợ lý"
                           placeholder="Nhập câu hỏi..." />

                    <button type="button" class="ai-help-send" onclick="sendAiHelpMessage()" aria-label="Gửi"><svg class="tv-icon" aria-hidden="true"><use href="#i-send" /></svg></button>
                </div>
                @if (new webdulich.Services.GoiYBangGemini(CauHinh).CoKhoa)
                {
                    <p class="ai-help-chu-y">Trợ lý AI hỗ trợ chọn tour, đặt nhóm, khuyến mãi và thanh toán. Đừng nhập thông tin cá nhân. Cần hỗ trợ thêm, bạn nhắn admin qua nút chat.</p>
                }
                else
                {
                    <p class="ai-help-chu-y">Trợ lý trả lời theo câu mẫu. Giá, lịch, chỗ còn xem đúng ở trang tour.</p>
                }
            </div>

            <button type="button" class="ai-help-toggle" onclick="toggleAiHelpBox()" aria-label="Hỏi nhanh trợ lý" data-nhan="Hỏi nhanh trợ lý">
                <svg class="tv-icon" aria-hidden="true"><use href="#i-tro-ly" /></svg>
            </button>
        </div>

        @* Nhắn Zalo trực tiếp: trên máy tính zalo.me mở trang có mã QR để quét, trên điện thoại mở thẳng ứng dụng Zalo.
           Cùng link với chân trang (_Footer.cshtml); đổi số thì sửa cả hai chỗ. *@
        <a class="zalo-noi" href="https://zalo.me/0342500619" target="_blank" rel="noopener" aria-label="Nhắn Zalo cho TravelVN" data-nhan="Nhắn Zalo">
            <span aria-hidden="true">Zalo</span>
        </a>

        <script>
            function toggleAiHelpBox() {
                const box = document.getElementById("aiHelpBox");
                // Mỗi lần chỉ mở một khung: mở trợ lý thì đóng chat admin
                const moRa = box.classList.toggle("active");
                if (moRa) document.getElementById("chatBox")?.classList.remove("active");
                setTimeout(scrollAiHelpBottom, 80);
            }

            function scrollAiHelpBottom() {
                const box = document.getElementById("aiHelpMessages");
                if (box) {
                    box.scrollTop = box.scrollHeight;
                }
            }

            // Các lượt hỏi đáp trong khung, gửi kèm vài lượt gần nhất cho AI để hỏi tiếp được
            const aiHelpLichSu = [];

            // dsTour: [{ ten, url }] do máy chủ trả về, thành nút "Xem tour" dưới câu trả lời
            function addAiHelpMessage(text, sender, dsTour) {
                const box = document.getElementById("aiHelpMessages");
                if (!box) return null;

                const row = document.createElement("div");
                row.className = "ai-help-row " + sender;

                const bubble = document.createElement("div");
                bubble.className = "ai-help-bubble";
                bubble.textContent = text;

                if (dsTour && dsTour.length) {
                    const nhom = document.createElement("div");
                    nhom.className = "ai-help-tour";
                    dsTour.forEach(function (t) {
                        const a = document.createElement("a");
                        a.href = t.url;
                        a.textContent = "Xem tour: " + t.ten;
                        nhom.appendChild(a);
                    });
                    bubble.appendChild(nhom);
                }

                row.appendChild(bubble);
                box.appendChild(row);

                scrollAiHelpBottom();
                return row;
            }

            function addAiHelpDangTraLoi() {
                const row = addAiHelpMessage("Đang trả lời", "bot");
                if (row) row.classList.add("dang-tra-loi");
                return row;
            }

            function normalizeAiText(text) {
                return (text || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d");
            }

            function getAiHelpAnswer(question) {
                const q = normalizeAiText(question);

                // Câu trả lời dự phòng khi AI chưa bật hoặc lỗi: chỉ nói điều web thật sự có
                if (q.includes("khuyen mai") || q.includes("ma giam") || q.includes("voucher") || q.includes("uu dai")) {
                    return "Các mã khuyến mãi đang chạy hiện ở trang chủ. Bạn nhập mã ở bước thanh toán (hoặc lúc tạo đơn nhóm) để được giảm.";
                }

                if (q.includes("nhom")) {
                    return "Đặt cho nhóm: ở trang tour chọn lịch rồi bấm Đặt cho nhóm. Bạn giữ chỗ và gửi link mời, mỗi người tự nhận ghế, tự điền thông tin và tự trả phần mình bằng mã QR riêng.";
                }

                if (q.includes("huy") || q.includes("hoan tien") || q.includes("doi lich")) {
                    return "Bạn vào mục Lịch sử đặt tour. Đơn đặt riêng còn giữ chỗ, chưa thanh toán và chưa tới ngày đi thì tự hủy được. Đã thanh toán hoặc cần hoàn tiền thì bạn chat với admin hoặc gọi hotline 0342500619.";
                }

                if (q.includes("thanh toan") || q.includes("momo") || q.includes("chuyen khoan") || q.includes("qr")) {
                    return "TravelVN nhận chuyển khoản bằng mã QR (số tiền và nội dung điền sẵn), ví MoMo hoặc tiền mặt. Chuyển đúng tiền, đúng nội dung thì hệ thống tự xác nhận khi nhận được tiền.";
                }

                if (q.includes("dat tour") || q.includes("chon tour") || q.includes("chon ngay")) {
                    return "Bạn mở trang tour, bấm Chọn ngày khởi hành, chọn lịch còn chỗ, nhập thông tin hành khách rồi thanh toán.";
                }

                if (q.includes("lich trinh") || q.includes("lich khoi hanh") || q.includes("ngay di")) {
                    return "Trang tour có lịch trình từng ngày và các lịch khởi hành kèm giờ đi, giá, số chỗ còn. Bạn cũng xem được Lịch khởi hành theo tháng ở trang Danh sách tour.";
                }

                if (q.includes("bien") || q.includes("nui") || q.includes("goi y") || q.includes("kham pha")) {
                    return "Bạn vào trang Gợi ý tour để chọn địa hình (biển, núi...), ngân sách, số ngày, hoặc lọc theo địa hình ở trang Danh sách tour.";
                }

                if (q.includes("hotline") || q.includes("lien he") || q.includes("sdt") || q.includes("so dien thoai") || q.includes("zalo")) {
                    return "Hotline và Zalo TravelVN: 0342500619. Bạn cũng có thể bấm nút chat với admin ở góc phải.";
                }

                if (q.includes("xin chao") || q.includes("hello") || q.includes("hi")) {
                    return "Xin chào bạn, mình là trợ lý ảo TravelVN. Mình hỗ trợ về chọn tour, đặt nhóm, khuyến mãi, thanh toán và hủy tour.";
                }

                return "Mình chưa hiểu rõ câu hỏi này. Bạn có thể hỏi về cách đặt tour, đặt nhóm, mã khuyến mãi, hủy tour, thanh toán hoặc hotline.";
            }

            let aiHelpDangHoi = false;

            // Hỏi máy chủ (TroLy/Hoi, dùng Gemini). Máy chủ báo duPhong hoặc lỗi mạng thì trả lời theo từ khóa như cũ.
            async function sendAiHelpMessage(text) {
                const input = document.getElementById("aiHelpInput");
                const question = (text || (input ? input.value : "")).trim().slice(0, 500);

                if (!question || aiHelpDangHoi) return;
                aiHelpDangHoi = true;

                addAiHelpMessage(question, "user");
                if (input) {
                    input.value = "";
                }

                const dangTraLoi = addAiHelpDangTraLoi();
                let traLoi = null, dsTour = null, lyDo = null;
                try {
                    const token = document.querySelector("#aiHelpToken input[name='__RequestVerificationToken']");
                    const phanHoi = await fetch("@Url.Action("Hoi", "TroLy")", {
                        method: "POST",
                        headers: { "Content-Type": "application/json", "RequestVerificationToken": token ? token.value : "" },
                        body: JSON.stringify({ cauHoi: question, lichSu: aiHelpLichSu.slice(-6) }),
                        signal: AbortSignal.timeout(40000)
                    });
                    const kq = phanHoi.ok ? await phanHoi.json() : null;
                    if (kq && kq.ok) {
                        traLoi = kq.traLoi;
                        dsTour = kq.tour;
                    } else if (kq && kq.loi) {
                        lyDo = kq.loi;
                    } else if (!phanHoi.ok) {
                        lyDo = "Trợ lý AI chưa trả lời được (mã " + phanHoi.status + "). Bạn tải lại trang rồi thử lại.";
                    }
                } catch (e) {
                    traLoi = null;
                    lyDo = e && e.name === "TimeoutError"
                        ? "AI trả lời quá lâu. Bạn thử lại sau."
                        : "Không kết nối được tới trợ lý AI.";
                }

                if (dangTraLoi) dangTraLoi.remove();
                if (!traLoi) traLoi = getAiHelpAnswer(question);
                const dongTraLoi = addAiHelpMessage(traLoi, "bot", dsTour);
                // Đang dùng câu mẫu vì AI lỗi: nói rõ lý do để khách và người quản trị biết
                if (lyDo && dongTraLoi) {
                    const ghiChu = document.createElement("p");
                    ghiChu.className = "ai-help-ly-do";
                    ghiChu.textContent = "Câu trả lời mẫu. " + lyDo;
                    dongTraLoi.querySelector(".ai-help-bubble").appendChild(ghiChu);
                    scrollAiHelpBottom();
                }
                aiHelpLichSu.push({ laKhach: true, chu: question }, { laKhach: false, chu: traLoi });
                aiHelpDangHoi = false;
            }

            document.addEventListener("DOMContentLoaded", function () {
                const input = document.getElementById("aiHelpInput");
                const box = document.getElementById("aiHelpMessages");

                if (box && box.children.length === 0) {
                    addAiHelpMessage("Xin chào! Tôi là trợ lý ảo TravelVN. Bạn cần hỗ trợ đặt tour, khuyến mãi, thanh toán hay hủy tour?", "bot");
                }

                if (input) {
                    input.addEventListener("keydown", function (e) {
                        if (e.key === "Enter") {
                            e.preventDefault();
                            sendAiHelpMessage();
                        }
                    });
                }
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>