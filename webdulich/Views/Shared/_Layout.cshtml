            }

            .ai-help-chip {
                border: 1px solid #dbeafe;
                background: #f8fbff;
                color: #0f172a;
                border-radius: 999px;
                padding: 8px 11px;
                font-size: 0.82rem;
                font-weight: 800;
                cursor: pointer;
            }

                .ai-help-chip:hover {
                    background: #2563eb;
                    color: #fff;
                }

            .ai-help-compose {
                padding: 14px;
                border-top: 1px solid #e2e8f0;
                background: #fff;
                display: flex;
                gap: 10px;
            }

            .ai-help-input {
                flex: 1;
                min-height: 44px;
                border: 1px solid #dbeafe;
                border-radius: 14px;
                padding: 0 13px;
                outline: none;
                font-weight: 650;
            }

                .ai-help-input:focus {
                    border-color: #2563eb;
                    box-shadow: 0 0 0 0.18rem rgba(37,99,235,0.14);
                }

            .ai-help-send {
                width: 48px;
                border: none;
                border-radius: 14px;
                background: linear-gradient(135deg, #7c3aed, #2563eb);
                color: #fff;
                font-size: 1.2rem;
                cursor: pointer;
            }

            @@media (max-width: 576px) {
                .ai-help-widget {
                    right: 16px;
                    bottom: 148px;
                }

                .ai-help-box {
                    width: calc(100vw - 32px);
                }
            }
        </style>

        <div class="ai-help-widget">
            <div class="ai-help-box" id="aiHelpBox">
                <div class="ai-help-header">
                    <div class="ai-help-header-top">
                        <div>
                            <div class="ai-help-title">🤖 Trợ lý ảo TravelVN</div>
                            <div class="ai-help-status">Đang hỗ trợ khách hàng</div>
                        </div>

                        <button type="button" class="ai-help-close" onclick="toggleAiHelpBox()">×</button>
                    </div>
                </div>

                <div class="ai-help-messages" id="aiHelpMessages"></div>

                <div class="ai-help-suggest">
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Tôi muốn xem khuyến mãi')">🎁 Ưu đãi</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Tôi muốn hủy tour')">❌ Hủy tour</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Tôi muốn thanh toán')">💳 Thanh toán</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Hotline là gì')">📞 Hotline</button>
                </div>

                <div class="ai-help-compose">
                    <input id="aiHelpInput"
                           class="ai-help-input"
                           type="text"
                           placeholder="Nhập câu hỏi..." />

                    <button type="button" class="ai-help-send" onclick="sendAiHelpMessage()">➤</button>
                </div>
            </div>

            <button type="button" class="ai-help-toggle" onclick="toggleAiHelpBox()">
                🤖
            </button>
        </div>

        <script>
            function toggleAiHelpBox() {
                const box = document.getElementById("aiHelpBox");
                box.classList.toggle("active");
                setTimeout(scrollAiHelpBottom, 80);
            }

            function scrollAiHelpBottom() {
                const box = document.getElementById("aiHelpMessages");
                if (box) {
                    box.scrollTop = box.scrollHeight;
                }
            }

            function addAiHelpMessage(text, sender) {
                const box = document.getElementById("aiHelpMessages");
                if (!box) return;

                const row = document.createElement("div");
                row.className = "ai-help-row " + sender;

                const bubble = document.createElement("div");
                bubble.className = "ai-help-bubble";
                bubble.textContent = text;

                row.appendChild(bubble);
                box.appendChild(row);

                scrollAiHelpBottom();
            }

            function normalizeAiText(text) {
                return (text || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d");
            }

            function getAiHelpAnswer(question) {
                const q = normalizeAiText(question);

                if (q.includes("khuyen mai") || q.includes("ma giam") || q.includes("voucher") || q.includes("uu dai")) {
                    return "Bạn có thể xem các khuyến mãi hiện hành ở trang chủ. Khi đặt tour, nhập mã khuyến mãi ở bước thanh toán để hệ thống tự giảm giá.";
                }

                if (q.includes("huy") || q.includes("hoan tien") || q.includes("doi lich")) {
                    return "Bạn vào mục Lịch sử đặt tour để xem đơn đã đặt. Nếu đơn chưa khởi hành hoặc chưa xử lý thanh toán, bạn có thể gửi yêu cầu hủy. Nếu đã thanh toán, bạn nên chat với admin để được kiểm tra nhanh hơn.";
                }

                if (q.includes("thanh toan") || q.includes("momo") || q.includes("chuyen khoan") || q.includes("vnpay")) {
                    return "TravelVN hỗ trợ thanh toán qua chuyển khoản, ví điện tử và các phương thức đang hiển thị ở trang thanh toán. Sau khi thanh toán, admin sẽ kiểm tra và cập nhật trạng thái đơn.";
                }

                if (q.includes("dat tour") || q.includes("chon tour") || q.includes("chon ngay")) {
                    return "Bạn chọn tour muốn đi, bấm Xem chi tiết, chọn ngày khởi hành còn chỗ, nhập thông tin hành khách rồi tiến hành thanh toán.";
                }

                if (q.includes("lich trinh") || q.includes("lich khoi hanh") || q.includes("ngay di")) {
                    return "Trong trang chi tiết tour có phần Lịch trình và Chọn ngày khởi hành. Bạn có thể xem từng ngày đi, giờ đi, số chỗ còn và giá theo lịch.";
                }

                if (q.includes("bien")) {
                    return "Bạn có thể bấm nút Du lịch biển ở trang chủ để lọc nhanh các tour biển như Phú Quốc, Vũng Tàu, Hạ Long hoặc Đà Nẵng.";
                }

                if (q.includes("nui") || q.includes("kham pha")) {
                    return "Bạn có thể bấm Khám phá núi để xem các tour có địa hình núi như Đà Lạt, Hà Giang, Sapa hoặc Tây Ninh.";
                }

                if (q.includes("hotline") || q.includes("lien he") || q.includes("sdt") || q.includes("so dien thoai")) {
                    return "Hotline TravelVN: 0342500619. Bạn cũng có thể dùng nút chat với admin để gửi yêu cầu hỗ trợ trực tiếp.";
                }

                if (q.includes("xin chao") || q.includes("hello") || q.includes("hi")) {
                    return "Xin chào bạn, mình là trợ lý ảo TravelVN. Mình có thể hỗ trợ bạn về đặt tour, khuyến mãi, thanh toán, hủy tour và lịch trình.";
                }

                return "Mình chưa hiểu rõ câu hỏi này. Bạn có thể hỏi theo các mẫu như: cách đặt tour, mã khuyến mãi, hủy tour, thanh toán, lịch trình hoặc hotline.";
            }

            function sendAiHelpMessage(text) {
                const input = document.getElementById("aiHelpInput");
                const question = text || (input ? input.value.trim() : "");

                if (!question) return;

                addAiHelpMessage(question, "user");

                if (input) {
                    input.value = "";
                }

                setTimeout(function () {
                    addAiHelpMessage(getAiHelpAnswer(question), "bot");
                }, 350);
            }

            document.addEventListener("DOMContentLoaded", function () {
                const input = document.getElementById("aiHelpInput");
                const box = document.getElementById("aiHelpMessages");

                if (box && box.children.length === 0) {
                    addAiHelpMessage("Xin chào! Tôi là trợ lý ảo TravelVN. Bạn cần hỗ trợ đặt tour, khuyến mãi, thanh toán hay hủy tour?", "bot");
                }

                if (input) {
                    input.addEventListener("keydown", function (e) {
                        if (e.key === "Enter") {
                            e.preventDefault();
                            sendAiHelpMessage();
                        }
                    });
                }
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

</body>
