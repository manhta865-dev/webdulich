                    border: 1px solid #fecaca;
                }

            .chat-messages-user {
                height: 330px;
                overflow-y: auto;
                padding: 14px;
                background: linear-gradient(180deg, #f8fbff, #fffdf8);
            }

            .chat-empty {
                height: 100%;
                display: flex;
