@using Microsoft.AspNetCore.Http
@using webdulich.Models
@inject DuLichDbContext ChatDb
@inject Microsoft.Extensions.Configuration.IConfiguration CauHinh

@{
    var currentUser = Context.Session.GetString("user");
    var currentRole = Context.Session.GetString("role");
    var avatarFile = Context.Session.GetString("avatar");

    if (string.IsNullOrWhiteSpace(avatarFile))
    {
        avatarFile = Context.Session.GetString("anhDaiDien");
    }

    var hasAvatar = !string.IsNullOrWhiteSpace(avatarFile);
    var firstLetter = !string.IsNullOrWhiteSpace(currentUser)
        ? currentUser.Trim().Substring(0, 1).ToUpper()
        : "U";
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
    var laTrangChu = controllerName == "TrangChu" && actionName == "Index";
    var tieuDeTrang = ViewData["Title"]?.ToString();
    var tieuDeTab = string.IsNullOrWhiteSpace(tieuDeTrang) ? "TravelVN" : tieuDeTrang + " | TravelVN";
    string Active(string controller, string? action = null) =>
        string.Equals(controllerName, controller, StringComparison.OrdinalIgnoreCase)
        && (action == null || string.Equals(actionName, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";

    // Menu admin: một mục gồm trang danh sách và các trang con của nó, để vào trang con vẫn biết đang ở mục nào
    bool LaAdminCo(params string[] dsAction) =>
        string.Equals(controllerName, "Admin", StringComparison.OrdinalIgnoreCase)
        && dsAction.Contains(actionName, StringComparer.OrdinalIgnoreCase);
    string MucAdmin(params string[] dsAction) => LaAdminCo(dsAction) ? "active" : "";

    string[] mucTour = { "Index", "Create", "Edit" };
    string[] mucLichDi = { "QuanLyLichKhoiHanh", "LichKhoiHanh", "ThemLichKhoiHanh" };
    string[] mucLichTrinh = { "QuanLyLichTrinh", "LichTrinh" };
    string[] mucPhanCong = { "PhanCongTour", "ThemPhanCongTour", "SuaPhanCongTour" };
    string[] mucDon = { "DonDatTour", "DonDatTourTheoTour", "SuaDonDatTour" };
    string[] mucKhuyenMai = { "KhuyenMai", "ThemKhuyenMai", "SuaKhuyenMai" };
    string[] mucDoanhThu = { "DoanhThu" };
    string[] mucTinNhan = { "TinNhan", "ChiTietTinNhan" };
    string[] mucTaiKhoan = { "TaiKhoan", "SuaTaiKhoan", "ChiTietTaiKhoan" };
    string[] mucNhanSu = { "NhanSu", "ThemNhanVien" };

    bool moTour = LaAdminCo(mucTour) || LaAdminCo(mucLichDi) || LaAdminCo(mucLichTrinh) || LaAdminCo(mucPhanCong);
    bool moKinhDoanh = LaAdminCo(mucDon) || LaAdminCo(mucKhuyenMai) || LaAdminCo(mucDoanhThu) || controllerName == "AdminTienVao";
    bool moNoiDung = controllerName is "AdminBaiViet" or "AdminVideo" or "AdminDanhGia";
    bool moConNguoi = LaAdminCo(mucTinNhan) || LaAdminCo(mucTaiKhoan) || LaAdminCo(mucNhanSu) || controllerName is "AdminDonXinNghi" or "AdminLuong";
    // Số đơn xin nghỉ đang chờ duyệt, hiện cạnh mục menu của admin (RB-45)
    int soDonNghiCho = currentRole == "admin" ? ChatDb.DonXinNghis.Count(d => d.TrangThai == TrangThaiDonNghi.ChoDuyet) : 0;
    // Số khoản tiền vào chưa tự khớp và chưa ai xử lý tay (RB-48)
    int soTienVaoCanXuLy = currentRole == "admin" ? ChatDb.GiaoDichNganHangs.Count(x => x.KetQua != KetQuaTienVao.DaKhop && x.NguoiXuLyId == null) : 0;
    string? nhomHienTai = moTour ? "Tour và lịch" : moKinhDoanh ? "Đơn và doanh thu" : moNoiDung ? "Nội dung" : moConNguoi ? "Khách và nhân sự" : null;
    // Nhóm quyền của tài khoản admin đang đăng nhập (RB-51): menu chỉ hiện mục được phép; bộ lọc KiemTraQuyenAdmin chặn khi gõ thẳng đường dẫn
    var quyenCuaToi = currentRole == "admin" ? QuyenAdmin.CuaToi(Context, ChatDb) : new HashSet<string>();
    bool CoQuyen(string ma) => quyenCuaToi.Contains(ma);
    // Màn hình chờ rừng cây chỉ ở trang của khách; admin và nhân viên làm việc nhiều trang liên tục nên không che
    bool coManHinhCho = currentRole != "admin" && currentRole != "huongdanvien" && currentRole != "taixe";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@tieuDeTab</title>
    @* Chọn chế độ sáng/tối trước khi vẽ trang để không bị chớp trắng: theo lựa chọn đã lưu, chưa chọn thì theo cài đặt của máy *@
    <script>
        (function () {
            var cheDo = null;
            try { cheDo = localStorage.getItem("tv-giao-dien"); } catch (e) { }
            if (cheDo !== "toi" && cheDo !== "sang") {
                cheDo = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "toi" : "sang";
            }
            if (cheDo === "toi") {
                document.documentElement.setAttribute("data-theme", "dark");
                document.documentElement.setAttribute("data-bs-theme", "dark");
            }
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Be Vietnam Pro: chữ chính; JetBrains Mono: chữ kiểu vé (mã chuyến đi). Các phông cũ (Playfair, Cormorant, Inter) đã bỏ
       ngày 26/11/2026 vì không còn trang nào dùng, bớt tải khi mở trang. *@
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/widgets.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ve.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @if (coManHinhCho)
    {
        <link rel="stylesheet" href="~/css/man-hinh-cho.css" asp-append-version="true" />
    }
    @* Chuyển trang mượt cho toàn site (View Transitions): thanh menu đứng yên, nội dung mờ đi rồi hiện lên.
       Trình duyệt chưa hỗ trợ thì chuyển trang bình thường. Trang của khách có thêm màn hình chờ rừng cây (_ManHinhCho). *@
    <style>@@view-transition { navigation: auto; }</style>
</head>

<body>
    <partial name="_Icons" />
    @if (coManHinhCho)
    {
        <partial name="_ManHinhCho" />
    }

    @if (currentRole == "admin")
    {
        <div class="tv-admin" id="tvAdmin">
            <aside class="tv-side" id="tvSide">
                <div class="tv-side-brand">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg>
                    TravelVN
                </div>
                <a asp-controller="Admin" asp-action="TongQuan" class="@Active("Admin", "TongQuan")">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-grid" /></svg>
                    <span>Tổng quan</span>
                </a>
                @* Nhóm xổ xuống dùng thẻ details nên không cần JavaScript. Cùng name: mở nhóm này thì nhóm kia tự đóng.
                   Mỗi mục chỉ hiện khi tài khoản có nhóm quyền tương ứng (RB-51); nhóm không còn mục nào thì ẩn cả nhóm. *@
                @if (CoQuyen(QuyenAdmin.TourLich))
                {
                    <details class="tv-side-nhom" name="menuAdmin" open="@moTour">
                        <summary>
                            <svg class="tv-icon" aria-hidden="true"><use href="#i-box" /></svg>
                            <span>Tour và lịch</span>
                        </summary>
                        <a asp-controller="Admin" asp-action="Index" class="@MucAdmin(mucTour)"><svg class="tv-icon" aria-hidden="true"><use href="#i-compass" /></svg><span>Quản lý tour</span></a>
                        <a asp-controller="Admin" asp-action="QuanLyLichKhoiHanh" class="@MucAdmin(mucLichDi)"><svg class="tv-icon" aria-hidden="true"><use href="#i-calendar" /></svg><span>Lịch đi</span></a>
                        <a asp-controller="Admin" asp-action="QuanLyLichTrinh" class="@MucAdmin(mucLichTrinh)"><svg class="tv-icon" aria-hidden="true"><use href="#i-route" /></svg><span>Lịch trình</span></a>
                        <a asp-controller="Admin" asp-action="PhanCongTour" class="@MucAdmin(mucPhanCong)"><svg class="tv-icon" aria-hidden="true"><use href="#i-truck" /></svg><span>Phân công tour</span></a>
                    </details>
                }
                @if (CoQuyen(QuyenAdmin.DonThanhToan) || CoQuyen(QuyenAdmin.DoanhThuTienVao))
                {
                    <details class="tv-side-nhom" name="menuAdmin" open="@moKinhDoanh">
                        <summary>
                            <svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg>
                            <span>Đơn và doanh thu</span>
                        </summary>
                        @if (CoQuyen(QuyenAdmin.DonThanhToan))
                        {
                            <a asp-controller="Admin" asp-action="DonDatTour" class="@MucAdmin(mucDon)"><svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg><span>Đơn đặt tour</span></a>
                            <a asp-controller="Admin" asp-action="KhuyenMai" class="@MucAdmin(mucKhuyenMai)"><svg class="tv-icon" aria-hidden="true"><use href="#i-tag" /></svg><span>Khuyến mãi</span></a>
                        }
                        @if (CoQuyen(QuyenAdmin.DoanhThuTienVao))
                        {
                            <a asp-controller="Admin" asp-action="DoanhThu" class="@MucAdmin(mucDoanhThu)"><svg class="tv-icon" aria-hidden="true"><use href="#i-chart" /></svg><span>Doanh thu</span></a>
                            <a asp-controller="AdminTienVao" asp-action="Index" class="@Active("AdminTienVao")"><svg class="tv-icon" aria-hidden="true"><use href="#i-bank" /></svg><span>Giao dịch ngân hàng</span>@if (soTienVaoCanXuLy > 0) {<b class="tv-side-dem" aria-label="@soTienVaoCanXuLy khoản tiền vào cần xử lý">@soTienVaoCanXuLy</b>}</a>
                        }
                    </details>
                }
                @if (CoQuyen(QuyenAdmin.NoiDung))
                {
                    <details class="tv-side-nhom" name="menuAdmin" open="@moNoiDung">
                        <summary>
                            <svg class="tv-icon" aria-hidden="true"><use href="#i-article" /></svg>
                            <span>Nội dung</span>
                        </summary>
                        <a asp-controller="AdminBaiViet" asp-action="Index" class="@Active("AdminBaiViet")"><svg class="tv-icon" aria-hidden="true"><use href="#i-article" /></svg><span>Bài viết</span></a>
                        <a asp-controller="AdminVideo" asp-action="Index" class="@Active("AdminVideo")"><svg class="tv-icon" aria-hidden="true"><use href="#i-video" /></svg><span>Video</span></a>
                        <a asp-controller="AdminDanhGia" asp-action="Index" class="@Active("AdminDanhGia")"><svg class="tv-icon" aria-hidden="true"><use href="#i-chat" /></svg><span>Đánh giá tour</span></a>
                    </details>
                }
                @if (CoQuyen(QuyenAdmin.KhachNhanSu) || CoQuyen(QuyenAdmin.TaiKhoanQuyen))
                {
                    <details class="tv-side-nhom" name="menuAdmin" open="@moConNguoi">
                        <summary>
                            <svg class="tv-icon" aria-hidden="true"><use href="#i-users" /></svg>
                            <span>Khách và nhân sự</span>
                        </summary>
                        @if (CoQuyen(QuyenAdmin.KhachNhanSu))
                        {
                            <a asp-controller="Admin" asp-action="TinNhan" class="@MucAdmin(mucTinNhan)"><svg class="tv-icon" aria-hidden="true"><use href="#i-chat" /></svg><span>Tin nhắn</span></a>
                        }
                        @if (CoQuyen(QuyenAdmin.TaiKhoanQuyen))
                        {
                            <a asp-controller="Admin" asp-action="TaiKhoan" class="@MucAdmin(mucTaiKhoan)"><svg class="tv-icon" aria-hidden="true"><use href="#i-user" /></svg><span>Tài khoản</span></a>
                        }
                        @if (CoQuyen(QuyenAdmin.KhachNhanSu))
                        {
                            <a asp-controller="Admin" asp-action="NhanSu" class="@MucAdmin(mucNhanSu)"><svg class="tv-icon" aria-hidden="true"><use href="#i-users" /></svg><span>Nhân sự</span></a>
                            <a asp-controller="AdminDonXinNghi" asp-action="Index" class="@Active("AdminDonXinNghi")"><svg class="tv-icon" aria-hidden="true"><use href="#i-calendar" /></svg><span>Đơn xin nghỉ</span>@if (soDonNghiCho > 0) {<b class="tv-side-dem" aria-label="@soDonNghiCho đơn chờ duyệt">@soDonNghiCho</b>}</a>
                            <a asp-controller="AdminLuong" asp-action="Index" class="@Active("AdminLuong")"><svg class="tv-icon" aria-hidden="true"><use href="#i-wallet" /></svg><span>Lương nhân viên</span></a>
                        }
                    </details>
                }
            </aside>
            <div class="tv-scrim" id="tvScrim"></div>

            <main class="tv-main">
                <div class="tv-topbar">
                    <button type="button" class="tv-side-toggle" id="tvSideToggle" aria-label="Mở menu">
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-menu" /></svg>
                    </button>
                    <div class="tv-topbar-title">
                        @if (nhomHienTai != null)
                        {
                            <span class="tv-topbar-nhom">@nhomHienTai</span>
                        }
                        @(string.IsNullOrWhiteSpace(tieuDeTrang) ? "Quản trị" : tieuDeTrang)
                    </div>
                    <button type="button" class="tv-giao-dien" data-giao-dien aria-label="Bật nền tối" aria-pressed="false">
                        <svg class="tv-icon tv-giao-dien-trang" aria-hidden="true"><use href="#i-moon" /></svg>
                        <svg class="tv-icon tv-giao-dien-toi" aria-hidden="true"><use href="#i-sun" /></svg>
                    </button>
                    @* Bấm vào tên để xổ menu: hồ sơ và đăng xuất (cùng kiểu menu tài khoản của khách) *@
                    <details class="tv-tk" id="tvTaiKhoan">
                        <summary class="tv-user" aria-label="Tài khoản của @currentUser">
                            @if (hasAvatar)
                            {
                                <img class="tv-avatar" src="~/images/avatar/@avatarFile" alt="" />
                            }
                            else
                            {
                                <span class="tv-avatar" aria-hidden="true">@firstLetter</span>
                            }
                            <span class="tv-tk-ten">@currentUser</span>
                        </summary>
                        <div class="tv-tk-menu">
                            <a asp-controller="TaiKhoan" asp-action="SuaHoSo" class="@Active("TaiKhoan", "SuaHoSo")">
                                <svg class="tv-icon" aria-hidden="true"><use href="#i-user" /></svg>
                                Hồ sơ của tôi
                            </a>
                            <div class="tv-tk-ngan"></div>
                            <a asp-controller="TaiKhoan" asp-action="DangXuat" class="tv-tk-thoat">
                                <svg class="tv-icon" aria-hidden="true"><use href="#i-logout" /></svg>
                                Đăng xuất
                            </a>
                        </div>
                    </details>
                </div>

                <div class="tv-content">
                    @RenderBody()
                </div>
            </main>
        </div>
    }

    else if (currentRole == "huongdanvien" || currentRole == "taixe")
    {
        <div class="tv-admin" id="tvAdmin">
            <aside class="tv-side" id="tvSide">
                <div class="tv-side-brand">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg>
                    TravelVN
                </div>
                <div class="tv-side-title">Công việc</div>
                <a asp-controller="NhanVien" asp-action="LichLamViec" class="@Active("NhanVien", "LichLamViec")">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-calendar" /></svg>
                    <span>Lịch làm việc</span>
                </a>
                <a asp-controller="NhanVien" asp-action="PhieuLuong" class="@Active("NhanVien", "PhieuLuong")">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-wallet" /></svg>
                    <span>Phiếu lương</span>
                </a>
                <a asp-controller="NhanVien" asp-action="DonXinNghi" class="@Active("NhanVien", "DonXinNghi")">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg>
                    <span>Đơn xin nghỉ</span>
                </a>
            </aside>
            <div class="tv-scrim" id="tvScrim"></div>

            <main class="tv-main">
                <div class="tv-topbar">
                    <button type="button" class="tv-side-toggle" id="tvSideToggle" aria-label="Mở menu">
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-menu" /></svg>
                    </button>
                    <div class="tv-topbar-title">@(string.IsNullOrWhiteSpace(tieuDeTrang) ? "Lịch làm việc" : tieuDeTrang)</div>
                    <button type="button" class="tv-giao-dien" data-giao-dien aria-label="Bật nền tối" aria-pressed="false">
                        <svg class="tv-icon tv-giao-dien-trang" aria-hidden="true"><use href="#i-moon" /></svg>
                        <svg class="tv-icon tv-giao-dien-toi" aria-hidden="true"><use href="#i-sun" /></svg>
                    </button>
                    @* Bấm vào tên để xổ menu: hồ sơ và đăng xuất (cùng kiểu menu tài khoản của khách) *@
                    <details class="tv-tk" id="tvTaiKhoan">
                        <summary class="tv-user" aria-label="Tài khoản của @currentUser">
                            @if (hasAvatar)
                            {
                                <img class="tv-avatar" src="~/images/avatar/@avatarFile" alt="" />
                            }
                            else
                            {
                                <span class="tv-avatar" aria-hidden="true">@firstLetter</span>
                            }
                            <span class="tv-tk-ten">@currentUser</span>
                        </summary>
                        <div class="tv-tk-menu">
                            <a asp-controller="TaiKhoan" asp-action="SuaHoSo" class="@Active("TaiKhoan", "SuaHoSo")">
                                <svg class="tv-icon" aria-hidden="true"><use href="#i-user" /></svg>
                                Hồ sơ của tôi
                            </a>
                            <div class="tv-tk-ngan"></div>
                            <a asp-controller="TaiKhoan" asp-action="DangXuat" class="tv-tk-thoat">
                                <svg class="tv-icon" aria-hidden="true"><use href="#i-logout" /></svg>
                                Đăng xuất
                            </a>
                        </div>
                    </details>
                </div>

                <div class="tv-content">
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <nav class="tv-nav@(laTrangChu ? " tv-nav--over" : "")" id="tvNav">
            <div class="tv-nav-inner">
                <a class="tv-brand" asp-controller="TrangChu" asp-action="Index">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg>
                    TravelVN
                </a>

                <button type="button" class="tv-nav-toggle" id="tvNavToggle" aria-label="Mở menu" aria-expanded="false">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-menu" /></svg>
                </button>

                <ul class="tv-nav-links">
                    <li><a asp-controller="TrangChu" asp-action="Index" class="@Active("TrangChu", "Index")">Trang chủ</a></li>
                    <li><a asp-controller="GoiYTour" asp-action="Index" class="@Active("GoiYTour")">Gợi ý tour</a></li>
                    <li><a asp-controller="BaiViet" asp-action="Index" class="@Active("BaiViet")">Bài viết</a></li>
                    <li><a asp-controller="TrangChu" asp-action="GioiThieu" class="@Active("TrangChu", "GioiThieu")">Giới thiệu</a></li>
                </ul>

                @* Trang nào cần ô tìm kiếm trên thanh menu thì khai báo section này (hiện có trang chủ) *@
                @await RenderSectionAsync("TimKiemMenu", required: false)

                <div class="tv-nav-actions">
                    <button type="button" class="tv-giao-dien" data-giao-dien aria-label="Bật nền tối" aria-pressed="false">
                        <svg class="tv-icon tv-giao-dien-trang" aria-hidden="true"><use href="#i-moon" /></svg>
                        <svg class="tv-icon tv-giao-dien-toi" aria-hidden="true"><use href="#i-sun" /></svg>
                    </button>
                    @if (currentUser != null)
                    {
                        @* Bấm vào tên để xổ menu tài khoản; dùng thẻ details nên vẫn mở được khi không có JavaScript *@
                        <details class="tv-tk" id="tvTaiKhoan">
                            <summary class="tv-user" aria-label="Tài khoản của @currentUser">
                                @if (hasAvatar)
                                {
                                    <img class="tv-avatar" src="~/images/avatar/@avatarFile" alt="" />
                                }
                                else
                                {
                                    <span class="tv-avatar" aria-hidden="true">@firstLetter</span>
                                }
                                <span class="tv-tk-ten">@currentUser</span>
                            </summary>
                            <div class="tv-tk-menu">
                                <a asp-controller="TaiKhoan" asp-action="SuaHoSo" class="@Active("TaiKhoan", "SuaHoSo")">
                                    <svg class="tv-icon" aria-hidden="true"><use href="#i-user" /></svg>
                                    Sửa thông tin
                                </a>
                                <a asp-controller="DatTour" asp-action="LichSu" class="@Active("DatTour", "LichSu")">
                                    <svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg>
                                    Lịch sử đặt tour
                                </a>
                                <div class="tv-tk-ngan"></div>
                                <a asp-controller="TaiKhoan" asp-action="DangXuat" class="tv-tk-thoat">
                                    <svg class="tv-icon" aria-hidden="true"><use href="#i-logout" /></svg>
                                    Đăng xuất
                                </a>
                            </div>
                        </details>
                    }
                    else
                    {
                        <a asp-controller="TaiKhoan" asp-action="DangNhap" class="tv-btn tv-btn-chinh">Đăng nhập</a>
                    }
                </div>
            </div>
        </nav>

        @* tv-noi-dung: các khối bên trong hiện dần khi mở trang (layout.css) *@
        <div class="@(laTrangChu ? "page-full" : "container tv-page") tv-noi-dung">
            @RenderBody()
        </div>

        @* Nhắc ghế, đơn nhóm sắp hết hạn mà chưa trả (RB-47). Trang đơn nhóm đã có đồng hồ đếm ngược nên không hiện ở đó. *@
        @if (currentUser != null && controllerName != "DonNhom")
        {
            @await Component.InvokeAsync("NhacGiuCho")
        }

        <partial name="_Footer" />
