@using Microsoft.AspNetCore.Http
@using webdulich.Models
@inject DuLichDbContext ChatDb

@{
    var currentUser = Context.Session.GetString("user");
    var currentRole = Context.Session.GetString("role");
    var avatarFile = Context.Session.GetString("avatar");

    if (string.IsNullOrWhiteSpace(avatarFile))
    {
        avatarFile = Context.Session.GetString("anhDaiDien");
    }

    var hasAvatar = !string.IsNullOrWhiteSpace(avatarFile);
    var firstLetter = !string.IsNullOrWhiteSpace(currentUser)
        ? currentUser.Trim().Substring(0, 1).ToUpper()
        : "U";
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
    var laTrangChu = controllerName == "TrangChu" && actionName == "Index";
    var tieuDeTrang = ViewData["Title"]?.ToString();
    var tieuDeTab = string.IsNullOrWhiteSpace(tieuDeTrang) ? "TravelVN" : tieuDeTrang + " | TravelVN";
    string Active(string controller, string? action = null) =>
        string.Equals(controllerName, controller, StringComparison.OrdinalIgnoreCase)
        && (action == null || string.Equals(actionName, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";

    // Menu admin: một mục gồm trang danh sách và các trang con của nó, để vào trang con vẫn biết đang ở mục nào
    bool LaAdminCo(params string[] dsAction) =>
        string.Equals(controllerName, "Admin", StringComparison.OrdinalIgnoreCase)
        && dsAction.Contains(actionName, StringComparer.OrdinalIgnoreCase);
    string MucAdmin(params string[] dsAction) => LaAdminCo(dsAction) ? "active" : "";

    string[] mucTour = { "Index", "Create", "Edit" };
    string[] mucLichDi = { "QuanLyLichKhoiHanh", "LichKhoiHanh", "ThemLichKhoiHanh" };
    string[] mucLichTrinh = { "QuanLyLichTrinh", "LichTrinh" };
    string[] mucPhanCong = { "PhanCongTour", "ThemPhanCongTour", "SuaPhanCongTour" };
    string[] mucDon = { "DonDatTour", "DonDatTourTheoTour", "SuaDonDatTour" };
    string[] mucKhuyenMai = { "KhuyenMai", "ThemKhuyenMai", "SuaKhuyenMai" };
    string[] mucDoanhThu = { "DoanhThu" };
    string[] mucTinNhan = { "TinNhan", "ChiTietTinNhan" };
    string[] mucTaiKhoan = { "TaiKhoan", "SuaTaiKhoan" };
    string[] mucNhanSu = { "NhanSu", "ThemNhanVien" };

    bool moTour = LaAdminCo(mucTour) || LaAdminCo(mucLichDi) || LaAdminCo(mucLichTrinh) || LaAdminCo(mucPhanCong);
    bool moKinhDoanh = LaAdminCo(mucDon) || LaAdminCo(mucKhuyenMai) || LaAdminCo(mucDoanhThu);
    bool moNoiDung = controllerName is "AdminBaiViet" or "AdminVideo" or "AdminDanhGia";
    bool moConNguoi = LaAdminCo(mucTinNhan) || LaAdminCo(mucTaiKhoan) || LaAdminCo(mucNhanSu);
    string? nhomHienTai = moTour ? "Tour và lịch" : moKinhDoanh ? "Đơn và doanh thu" : moNoiDung ? "Nội dung" : moConNguoi ? "Khách và nhân sự" : null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@tieuDeTab</title>
    @* Chọn chế độ sáng/tối trước khi vẽ trang để không bị chớp trắng: theo lựa chọn đã lưu, chưa chọn thì theo cài đặt của máy *@
    <script>
        (function () {
            var cheDo = null;
            try { cheDo = localStorage.getItem("tv-giao-dien"); } catch (e) { }
            if (cheDo !== "toi" && cheDo !== "sang") {
                cheDo = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "toi" : "sang";
            }
            if (cheDo === "toi") {
                document.documentElement.setAttribute("data-theme", "dark");
                document.documentElement.setAttribute("data-bs-theme", "dark");
            }
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Be Vietnam Pro là phông mới. Hai phông cũ giữ tạm vì các trang chưa làm lại còn dùng; bỏ khi làm xong từng trang. *@
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;700&family=Cormorant+Garamond:wght@400;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/widgets.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @* Chuyển trang mượt cho toàn site (View Transitions): thanh menu đứng yên, nội dung mờ đi rồi hiện lên.
       Trình duyệt chưa hỗ trợ thì chuyển trang bình thường. Không còn màn hình chờ vì nó làm mỗi lần chuyển trang bị chớp. *@
    <style>@@view-transition { navigation: auto; }</style>
</head>

<body>
    <partial name="_Icons" />

    @if (currentRole == "admin")
    {
        <div class="tv-admin" id="tvAdmin">
            <aside class="tv-side" id="tvSide">
                <div class="tv-side-brand">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg>
                    TravelVN
                </div>
                <a asp-controller="Admin" asp-action="TongQuan" class="@Active("Admin", "TongQuan")">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-grid" /></svg>
                    <span>Tổng quan</span>
                </a>
                @* Nhóm xổ xuống dùng thẻ details nên không cần JavaScript. Cùng name: mở nhóm này thì nhóm kia tự đóng. *@
                <details class="tv-side-nhom" name="menuAdmin" open="@moTour">
                    <summary>
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-box" /></svg>
                        <span>Tour và lịch</span>
                    </summary>
                    <a asp-controller="Admin" asp-action="Index" class="@MucAdmin(mucTour)"><svg class="tv-icon" aria-hidden="true"><use href="#i-compass" /></svg><span>Quản lý tour</span></a>
                    <a asp-controller="Admin" asp-action="QuanLyLichKhoiHanh" class="@MucAdmin(mucLichDi)"><svg class="tv-icon" aria-hidden="true"><use href="#i-calendar" /></svg><span>Lịch đi</span></a>
                    <a asp-controller="Admin" asp-action="QuanLyLichTrinh" class="@MucAdmin(mucLichTrinh)"><svg class="tv-icon" aria-hidden="true"><use href="#i-route" /></svg><span>Lịch trình</span></a>
                    <a asp-controller="Admin" asp-action="PhanCongTour" class="@MucAdmin(mucPhanCong)"><svg class="tv-icon" aria-hidden="true"><use href="#i-truck" /></svg><span>Phân công tour</span></a>
                </details>
                <details class="tv-side-nhom" name="menuAdmin" open="@moKinhDoanh">
                    <summary>
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg>
                        <span>Đơn và doanh thu</span>
                    </summary>
                    <a asp-controller="Admin" asp-action="DonDatTour" class="@MucAdmin(mucDon)"><svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg><span>Đơn đặt tour</span></a>
                    <a asp-controller="Admin" asp-action="KhuyenMai" class="@MucAdmin(mucKhuyenMai)"><svg class="tv-icon" aria-hidden="true"><use href="#i-tag" /></svg><span>Khuyến mãi</span></a>
                    <a asp-controller="Admin" asp-action="DoanhThu" class="@MucAdmin(mucDoanhThu)"><svg class="tv-icon" aria-hidden="true"><use href="#i-chart" /></svg><span>Doanh thu</span></a>
                </details>
                <details class="tv-side-nhom" name="menuAdmin" open="@moNoiDung">
                    <summary>
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-article" /></svg>
                        <span>Nội dung</span>
                    </summary>
                    <a asp-controller="AdminBaiViet" asp-action="Index" class="@Active("AdminBaiViet")"><svg class="tv-icon" aria-hidden="true"><use href="#i-article" /></svg><span>Bài viết</span></a>
                    <a asp-controller="AdminVideo" asp-action="Index" class="@Active("AdminVideo")"><svg class="tv-icon" aria-hidden="true"><use href="#i-video" /></svg><span>Video</span></a>
                    <a asp-controller="AdminDanhGia" asp-action="Index" class="@Active("AdminDanhGia")"><svg class="tv-icon" aria-hidden="true"><use href="#i-chat" /></svg><span>Đánh giá tour</span></a>
                </details>
                <details class="tv-side-nhom" name="menuAdmin" open="@moConNguoi">
                    <summary>
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-users" /></svg>
                        <span>Khách và nhân sự</span>
                    </summary>
                    <a asp-controller="Admin" asp-action="TinNhan" class="@MucAdmin(mucTinNhan)"><svg class="tv-icon" aria-hidden="true"><use href="#i-chat" /></svg><span>Tin nhắn</span></a>
                    <a asp-controller="Admin" asp-action="TaiKhoan" class="@MucAdmin(mucTaiKhoan)"><svg class="tv-icon" aria-hidden="true"><use href="#i-user" /></svg><span>Tài khoản</span></a>
                    <a asp-controller="Admin" asp-action="NhanSu" class="@MucAdmin(mucNhanSu)"><svg class="tv-icon" aria-hidden="true"><use href="#i-users" /></svg><span>Nhân sự</span></a>
                </details>
                <a asp-controller="TaiKhoan" asp-action="DangXuat" class="tv-side-out">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-logout" /></svg>
                    <span>Đăng xuất</span>
                </a>
            </aside>
            <div class="tv-scrim" id="tvScrim"></div>

            <main class="tv-main">
                <div class="tv-topbar">
                    <button type="button" class="tv-side-toggle" id="tvSideToggle" aria-label="Mở menu">
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-menu" /></svg>
                    </button>
                    <div class="tv-topbar-title">
                        @if (nhomHienTai != null)
                        {
                            <span class="tv-topbar-nhom">@nhomHienTai</span>
                        }
                        @(string.IsNullOrWhiteSpace(tieuDeTrang) ? "Quản trị" : tieuDeTrang)
                    </div>
                    <button type="button" class="tv-giao-dien" data-giao-dien aria-label="Bật nền tối" aria-pressed="false">
                        <svg class="tv-icon tv-giao-dien-trang" aria-hidden="true"><use href="#i-moon" /></svg>
                        <svg class="tv-icon tv-giao-dien-toi" aria-hidden="true"><use href="#i-sun" /></svg>
                    </button>
                    <div class="tv-user">
                        @if (hasAvatar)
                        {
                            <img class="tv-avatar" src="~/images/avatar/@avatarFile" alt="Ảnh đại diện" />
                        }
                        else
                        {
                            <span class="tv-avatar" aria-hidden="true">@firstLetter</span>
                        }
                        <span class="tv-user-text">@currentUser</span>
                    </div>
                </div>

                <div class="tv-content">
                    @RenderBody()
                </div>
            </main>
        </div>
    }

    else if (currentRole == "huongdanvien" || currentRole == "taixe")
    {
        <div class="tv-admin" id="tvAdmin">
            <aside class="tv-side" id="tvSide">
                <div class="tv-side-brand">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg>
                    TravelVN
                </div>
                <div class="tv-side-title">Công việc</div>
                <a asp-controller="NhanVien" asp-action="LichLamViec" class="@Active("NhanVien", "LichLamViec")">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-calendar" /></svg>
                    <span>Lịch làm việc</span>
                </a>
                <a asp-controller="TaiKhoan" asp-action="DangXuat" class="tv-side-out">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-logout" /></svg>
                    <span>Đăng xuất</span>
                </a>
            </aside>
            <div class="tv-scrim" id="tvScrim"></div>

            <main class="tv-main">
                <div class="tv-topbar">
                    <button type="button" class="tv-side-toggle" id="tvSideToggle" aria-label="Mở menu">
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-menu" /></svg>
                    </button>
                    <div class="tv-topbar-title">@(string.IsNullOrWhiteSpace(tieuDeTrang) ? "Lịch làm việc" : tieuDeTrang)</div>
                    <button type="button" class="tv-giao-dien" data-giao-dien aria-label="Bật nền tối" aria-pressed="false">
                        <svg class="tv-icon tv-giao-dien-trang" aria-hidden="true"><use href="#i-moon" /></svg>
                        <svg class="tv-icon tv-giao-dien-toi" aria-hidden="true"><use href="#i-sun" /></svg>
                    </button>
                    <div class="tv-user">
                        @if (hasAvatar)
                        {
                            <img class="tv-avatar" src="~/images/avatar/@avatarFile" alt="Ảnh đại diện" />
                        }
                        else
                        {
                            <span class="tv-avatar" aria-hidden="true">@firstLetter</span>
                        }
                        <span class="tv-user-text">@currentUser</span>
                    </div>
                </div>

                <div class="tv-content">
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <nav class="tv-nav@(laTrangChu ? " tv-nav--over" : "")" id="tvNav">
            <div class="tv-nav-inner">
                <a class="tv-brand" asp-controller="TrangChu" asp-action="Index">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg>
                    TravelVN
                </a>

                <button type="button" class="tv-nav-toggle" id="tvNavToggle" aria-label="Mở menu" aria-expanded="false">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-menu" /></svg>
                </button>

                <ul class="tv-nav-links">
                    <li><a asp-controller="TrangChu" asp-action="Index" class="@Active("TrangChu", "Index")">Trang chủ</a></li>
                    <li><a asp-controller="GoiYTour" asp-action="Index" class="@Active("GoiYTour")">Gợi ý tour</a></li>
                    <li><a asp-controller="BaiViet" asp-action="Index" class="@Active("BaiViet")">Bài viết</a></li>
                    <li><a asp-controller="TrangChu" asp-action="GioiThieu" class="@Active("TrangChu", "GioiThieu")">Giới thiệu</a></li>
                </ul>

                @* Trang nào cần ô tìm kiếm trên thanh menu thì khai báo section này (hiện có trang chủ) *@
                @await RenderSectionAsync("TimKiemMenu", required: false)

                <div class="tv-nav-actions">
                    <button type="button" class="tv-giao-dien" data-giao-dien aria-label="Bật nền tối" aria-pressed="false">
                        <svg class="tv-icon tv-giao-dien-trang" aria-hidden="true"><use href="#i-moon" /></svg>
                        <svg class="tv-icon tv-giao-dien-toi" aria-hidden="true"><use href="#i-sun" /></svg>
                    </button>
                    @if (currentUser != null)
                    {
                        @* Bấm vào tên để xổ menu tài khoản; dùng thẻ details nên vẫn mở được khi không có JavaScript *@
                        <details class="tv-tk" id="tvTaiKhoan">
                            <summary class="tv-user" aria-label="Tài khoản của @currentUser">
                                @if (hasAvatar)
                                {
                                    <img class="tv-avatar" src="~/images/avatar/@avatarFile" alt="" />
                                }
                                else
                                {
                                    <span class="tv-avatar" aria-hidden="true">@firstLetter</span>
                                }
                                <span class="tv-tk-ten">@currentUser</span>
                            </summary>
                            <div class="tv-tk-menu">
                                <a asp-controller="TaiKhoan" asp-action="SuaHoSo" class="@Active("TaiKhoan", "SuaHoSo")">
                                    <svg class="tv-icon" aria-hidden="true"><use href="#i-user" /></svg>
                                    Sửa thông tin
                                </a>
                                <a asp-controller="DatTour" asp-action="LichSu" class="@Active("DatTour", "LichSu")">
                                    <svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg>
                                    Lịch sử đặt tour
                                </a>
                                <div class="tv-tk-ngan"></div>
                                <a asp-controller="TaiKhoan" asp-action="DangXuat" class="tv-tk-thoat">
                                    <svg class="tv-icon" aria-hidden="true"><use href="#i-logout" /></svg>
                                    Đăng xuất
                                </a>
                            </div>
                        </details>
                    }
                    else
                    {
                        <a asp-controller="TaiKhoan" asp-action="DangNhap" class="tv-btn tv-btn-chinh">Đăng nhập</a>
                    }
                </div>
            </div>
        </nav>

        @* tv-noi-dung: các khối bên trong hiện dần khi mở trang (layout.css) *@
        <div class="@(laTrangChu ? "page-full" : "container tv-page") tv-noi-dung">
            @RenderBody()
        </div>

        <partial name="_Footer" />
    }


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @* Hộp xác nhận cho mọi form có data-xac-nhan (thay confirm() của trình duyệt) *@
    <script src="~/js/xac-nhan.js" asp-append-version="true"></script>
    <script>
        (function () {
            var nav = document.getElementById("tvNav");
            var navBtn = document.getElementById("tvNavToggle");
            if (nav && navBtn) {
                navBtn.addEventListener("click", function () {
                    var open = nav.classList.toggle("is-open");
                    navBtn.setAttribute("aria-expanded", open ? "true" : "false");
                });

                // Trang chủ: menu nằm trong suốt trên ảnh, đổi sang nền trắng khi cuộn xuống
                if (nav.classList.contains("tv-nav--over")) {
                    var doiNenMenu = function () {
                        nav.classList.toggle("is-solid", window.scrollY > 40);
                    };
                    doiNenMenu();
                    window.addEventListener("scroll", doiNenMenu, { passive: true });
                }
            }
            // Nút sáng/tối: đổi ngay và nhớ lựa chọn cho lần sau
            var goc = document.documentElement;
            function capNhatNutGiaoDien() {
                var toi = goc.getAttribute("data-theme") === "dark";
                document.querySelectorAll("[data-giao-dien]").forEach(function (nut) {
                    nut.setAttribute("aria-pressed", toi ? "true" : "false");
                    nut.setAttribute("aria-label", toi ? "Bật nền sáng" : "Bật nền tối");
                    nut.title = toi ? "Bật nền sáng" : "Bật nền tối";
                });
            }
            document.querySelectorAll("[data-giao-dien]").forEach(function (nut) {
                nut.addEventListener("click", function () {
                    var toi = goc.getAttribute("data-theme") !== "dark";
                    if (toi) {
                        goc.setAttribute("data-theme", "dark");
                        goc.setAttribute("data-bs-theme", "dark");
                    } else {
                        goc.removeAttribute("data-theme");
                        goc.removeAttribute("data-bs-theme");
                    }
                    try { localStorage.setItem("tv-giao-dien", toi ? "toi" : "sang"); } catch (e) { }
                    capNhatNutGiaoDien();
                });
            });
            capNhatNutGiaoDien();

            // Menu tài khoản: bấm ra ngoài hoặc nhấn Esc thì đóng
            var taiKhoan = document.getElementById("tvTaiKhoan");
            if (taiKhoan) {
                document.addEventListener("click", function (e) {
                    if (taiKhoan.open && !taiKhoan.contains(e.target)) taiKhoan.open = false;
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && taiKhoan.open) {
                        taiKhoan.open = false;
                        taiKhoan.querySelector("summary").focus();
                    }
                });
            }

            var admin = document.getElementById("tvAdmin");
            var sideBtn = document.getElementById("tvSideToggle");
            var scrim = document.getElementById("tvScrim");
            if (admin && sideBtn) {
                sideBtn.addEventListener("click", function () { admin.classList.toggle("is-open"); });
                if (scrim) { scrim.addEventListener("click", function () { admin.classList.remove("is-open"); }); }
            }
        })();
    </script>

    @if (currentUser != null && currentRole != "admin" && currentRole != "huongdanvien" && currentRole != "taixe")
    {
        var chatTaiKhoanId = Context.Session.GetInt32("taiKhoanId");
        var chatTinNhans = chatTaiKhoanId.HasValue
        ? ChatDb.TinNhanLienHes
        .Where(x => x.TaiKhoanId == chatTaiKhoanId.Value)
        .OrderBy(x => x.NgayGui)
        .ToList()
        : new List<TinNhanLienHe>();

        var chatSuccess = TempData["ChatSuccess"] as string;
        var chatError = TempData["ChatError"] as string;
        var moChat = !string.IsNullOrWhiteSpace(chatSuccess) || !string.IsNullOrWhiteSpace(chatError);


        <div class="chat-widget">
            <div class="chat-box @(moChat ? "active" : "")" id="chatBox">
                <div class="chat-header">
                    <button type="button" class="chat-close" onclick="toggleChatBox()" aria-label="Đóng">×</button>
                    <h4><svg class="tv-icon" aria-hidden="true"><use href="#i-chat" /></svg> Chat với admin</h4>
                    <p>Admin TravelVN sẽ phản hồi tại đây.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(chatSuccess))
                {
                    <div class="chat-status success">@chatSuccess</div>
                }

                @if (!string.IsNullOrWhiteSpace(chatError))
                {
                    <div class="chat-status error">@chatError</div>
                }

                <div class="chat-messages-user" id="chatMessagesUser">
                    @if (chatTinNhans.Any())
                    {
                        foreach (var item in chatTinNhans)
                        {
                            var laUser = item.NguoiGui == "user";

                            <div class="chat-row @(laUser ? "user" : "admin")">
                                <div class="chat-bubble">
                                    <div>@item.NoiDung</div>

                                    <div class="chat-time">
                                        @(laUser ? "Bạn" : "Admin") · @item.NgayGui.ToString("dd/MM HH:mm")
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="chat-empty">
                            Bạn chưa có tin nhắn nào. Hãy gửi câu hỏi để admin hỗ trợ nhé.
                        </div>
                    }
                </div>

                <div id="userChatForm" class="chat-compose">
                    @Html.AntiForgeryToken()

                    <textarea name="noiDung"
                          id="userChatInput"
                          class="chat-textarea"
                          required
                          placeholder="Nhập tin nhắn của bạn..."></textarea>

                    <button type="button" id="userChatSendBtn" class="chat-submit">
                        Gửi tin nhắn
                    </button>
                </div>
            </div>

            <button type="button" class="chat-toggle" onclick="toggleChatBox()" aria-label="Chat với TravelVN" data-nhan="Chat với TravelVN">
                <svg class="tv-icon" aria-hidden="true"><use href="#i-tro-chuyen" /></svg>
            </button>
        </div>

        <script>
            function toggleChatBox() {
                const chatBox = document.getElementById("chatBox");

                if (chatBox) {
                    // Mỗi lần chỉ mở một khung: mở chat admin thì đóng trợ lý
                    const moRa = chatBox.classList.toggle("active");
                    if (moRa) document.getElementById("aiHelpBox")?.classList.remove("active");
                    setTimeout(scrollUserChatToBottom, 80);
                }
            }

            function scrollUserChatToBottom() {
                const box = document.getElementById("chatMessagesUser");

                if (box) {
                    box.scrollTop = box.scrollHeight;
                }
            }

            function renderUserMessages(messages) {
                const box = document.getElementById("chatMessagesUser");

                if (!box) {
                    return;
                }

                if (!messages || messages.length === 0) {
                    box.innerHTML =
                        '<div class="chat-empty">Bạn chưa có tin nhắn nào. Hãy gửi câu hỏi để admin hỗ trợ nhé.</div>';
                    return;
                }

                box.innerHTML = "";

                messages.forEach(function (item) {
                    const laUser = item.nguoiGui === "user";

                    const row = document.createElement("div");
                    row.className = "chat-row " + (laUser ? "user" : "admin");

                    const bubble = document.createElement("div");
                    bubble.className = "chat-bubble";

                    const content = document.createElement("div");
                    content.textContent = item.noiDung;

                    const time = document.createElement("div");
                    time.className = "chat-time";
                    time.textContent = (laUser ? "Bạn" : "Admin") + " · " + item.thoiGian;

                    bubble.appendChild(content);
                    bubble.appendChild(time);
                    row.appendChild(bubble);
                    box.appendChild(row);
                });

                scrollUserChatToBottom();
            }

            function loadUserMessages() {
                fetch('@Url.Action("LayTinNhan", "LienHe")', {
                    cache: "no-store"
                })
                    .then(function (res) {
                        return res.json();
                    })
                    .then(function (data) {
                        renderUserMessages(data);
                    })
                    .catch(function () {
                    });
            }

            document.addEventListener("DOMContentLoaded", function () {
                const userChatFormElement = document.getElementById("userChatForm");
                const input = document.getElementById("userChatInput");
                const sendBtn = document.getElementById("userChatSendBtn");

                if (userChatFormElement && input && sendBtn) {
                    sendBtn.addEventListener("click", function () {
                        const noiDung = input.value.trim();

                        if (!noiDung) {
                            return;
                        }

                        const formData = new FormData();
                        formData.append("noiDung", noiDung);
                        formData.append("__RequestVerificationToken", userChatFormElement.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "");

                        fetch('@Url.Action("GuiTinNhanAjax", "LienHe")', {
                            method: "POST",
                            body: formData
                        })
                            .then(function (res) {
                                return res.json();
                            })
                            .then(function (data) {
                                if (data.success) {
                                    input.value = "";
                                    loadUserMessages();
                                }
                            });
                    });
                }

                loadUserMessages();
                setInterval(loadUserMessages, 3000);
            });
        </script>
    }

    @if (Context.Session.GetString("role") != "admin" && Context.Session.GetString("role") != "huongdanvien" && Context.Session.GetString("role") != "taixe")
    {

        <div class="ai-help-widget">
            <div class="ai-help-box" id="aiHelpBox">
                <div class="ai-help-header">
                    <div class="ai-help-header-top">
                        <div>
                            <div class="ai-help-title"><svg class="tv-icon" aria-hidden="true"><use href="#i-help" /></svg> Trợ lý TravelVN</div>
                            <div class="ai-help-status">Đang hỗ trợ khách hàng</div>
                        </div>

                        <button type="button" class="ai-help-close" onclick="toggleAiHelpBox()" aria-label="Đóng">×</button>
                    </div>
                </div>

                <div class="ai-help-messages" id="aiHelpMessages"></div>

                <div class="ai-help-suggest">
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Tôi muốn xem khuyến mãi')">Ưu đãi</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Tôi muốn hủy tour')">Hủy tour</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Tôi muốn thanh toán')">Thanh toán</button>
                    <button type="button" class="ai-help-chip" onclick="sendAiHelpMessage('Hotline là gì')">Hotline</button>
                </div>

                <div class="ai-help-compose">
                    <input id="aiHelpInput"
                           class="ai-help-input"
                           type="text"
                           placeholder="Nhập câu hỏi..." />

                    <button type="button" class="ai-help-send" onclick="sendAiHelpMessage()" aria-label="Gửi"><svg class="tv-icon" aria-hidden="true"><use href="#i-send" /></svg></button>
                </div>
            </div>

            <button type="button" class="ai-help-toggle" onclick="toggleAiHelpBox()" aria-label="Hỏi nhanh trợ lý" data-nhan="Hỏi nhanh trợ lý">
                <svg class="tv-icon" aria-hidden="true"><use href="#i-tro-ly" /></svg>
            </button>
        </div>

        @* Nhắn Zalo trực tiếp: trên máy tính zalo.me mở trang có mã QR để quét, trên điện thoại mở thẳng ứng dụng Zalo.
           Cùng link với chân trang (_Footer.cshtml); đổi số thì sửa cả hai chỗ. *@
        <a class="zalo-noi" href="https://zalo.me/0342500619" target="_blank" rel="noopener" aria-label="Nhắn Zalo cho TravelVN" data-nhan="Nhắn Zalo">
            <span aria-hidden="true">Zalo</span>
        </a>

        <script>
            function toggleAiHelpBox() {
                const box = document.getElementById("aiHelpBox");
                // Mỗi lần chỉ mở một khung: mở trợ lý thì đóng chat admin
                const moRa = box.classList.toggle("active");
                if (moRa) document.getElementById("chatBox")?.classList.remove("active");
                setTimeout(scrollAiHelpBottom, 80);
            }

            function scrollAiHelpBottom() {
                const box = document.getElementById("aiHelpMessages");
                if (box) {
                    box.scrollTop = box.scrollHeight;
                }
            }

            function addAiHelpMessage(text, sender) {
                const box = document.getElementById("aiHelpMessages");
                if (!box) return;

                const row = document.createElement("div");
                row.className = "ai-help-row " + sender;

                const bubble = document.createElement("div");
                bubble.className = "ai-help-bubble";
                bubble.textContent = text;

                row.appendChild(bubble);
                box.appendChild(row);

                scrollAiHelpBottom();
            }

            function normalizeAiText(text) {
                return (text || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d");
            }

            function getAiHelpAnswer(question) {
                const q = normalizeAiText(question);

                if (q.includes("khuyen mai") || q.includes("ma giam") || q.includes("voucher") || q.includes("uu dai")) {
                    return "Bạn có thể xem các khuyến mãi hiện hành ở trang chủ. Khi đặt tour, nhập mã khuyến mãi ở bước thanh toán để hệ thống tự giảm giá.";
                }

                if (q.includes("huy") || q.includes("hoan tien") || q.includes("doi lich")) {
                    return "Bạn vào mục Lịch sử đặt tour để xem đơn đã đặt. Nếu đơn chưa khởi hành hoặc chưa xử lý thanh toán, bạn có thể gửi yêu cầu hủy. Nếu đã thanh toán, bạn nên chat với admin để được kiểm tra nhanh hơn.";
                }

                if (q.includes("thanh toan") || q.includes("momo") || q.includes("chuyen khoan") || q.includes("vnpay")) {
                    return "TravelVN hỗ trợ thanh toán qua chuyển khoản, ví điện tử và các phương thức đang hiển thị ở trang thanh toán. Sau khi thanh toán, admin sẽ kiểm tra và cập nhật trạng thái đơn.";
                }

                if (q.includes("dat tour") || q.includes("chon tour") || q.includes("chon ngay")) {
                    return "Bạn chọn tour muốn đi, bấm Xem chi tiết, chọn ngày khởi hành còn chỗ, nhập thông tin hành khách rồi tiến hành thanh toán.";
                }

                if (q.includes("lich trinh") || q.includes("lich khoi hanh") || q.includes("ngay di")) {
                    return "Trong trang chi tiết tour có phần Lịch trình và Chọn ngày khởi hành. Bạn có thể xem từng ngày đi, giờ đi, số chỗ còn và giá theo lịch.";
                }

                if (q.includes("bien")) {
                    return "Bạn có thể bấm nút Du lịch biển ở trang chủ để lọc nhanh các tour biển như Phú Quốc, Vũng Tàu, Hạ Long hoặc Đà Nẵng.";
                }

                if (q.includes("nui") || q.includes("kham pha")) {
                    return "Bạn có thể bấm Khám phá núi để xem các tour có địa hình núi như Đà Lạt, Hà Giang, Sapa hoặc Tây Ninh.";
                }

                if (q.includes("hotline") || q.includes("lien he") || q.includes("sdt") || q.includes("so dien thoai")) {
                    return "Hotline TravelVN: 0342500619. Bạn cũng có thể dùng nút chat với admin để gửi yêu cầu hỗ trợ trực tiếp.";
                }

                if (q.includes("xin chao") || q.includes("hello") || q.includes("hi")) {
                    return "Xin chào bạn, mình là trợ lý ảo TravelVN. Mình có thể hỗ trợ bạn về đặt tour, khuyến mãi, thanh toán, hủy tour và lịch trình.";
                }

                return "Mình chưa hiểu rõ câu hỏi này. Bạn có thể hỏi theo các mẫu như: cách đặt tour, mã khuyến mãi, hủy tour, thanh toán, lịch trình hoặc hotline.";
            }

            function sendAiHelpMessage(text) {
                const input = document.getElementById("aiHelpInput");
                const question = text || (input ? input.value.trim() : "");

                if (!question) return;

                addAiHelpMessage(question, "user");

                if (input) {
                    input.value = "";
                }

                setTimeout(function () {
                    addAiHelpMessage(getAiHelpAnswer(question), "bot");
                }, 350);
            }

            document.addEventListener("DOMContentLoaded", function () {
                const input = document.getElementById("aiHelpInput");
                const box = document.getElementById("aiHelpMessages");

                if (box && box.children.length === 0) {
                    addAiHelpMessage("Xin chào! Tôi là trợ lý ảo TravelVN. Bạn cần hỗ trợ đặt tour, khuyến mãi, thanh toán hay hủy tour?", "bot");
                }

                if (input) {
                    input.addEventListener("keydown", function (e) {
                        if (e.key === "Enter") {
                            e.preventDefault();
                            sendAiHelpMessage();
                        }
                    });
                }
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>