<!DOCTYPE html>
<html>
<head>
    <title>Travel Website</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<style>
    body {
        background: #f4f6fb;
        font-family: Arial;
    }

    .navbar {
        background: #0d6efd;
    }

    .navbar-brand {
        font-weight: bold;
    }

    .card {
        border-radius: 15px;
        transition: 0.3s;
    }

        .card:hover {
            transform: scale(1.05);
            box-shadow: 0px 10px 25px rgba(0,0,0,0.2);
        }

    .btn-primary {
        background: #ff6600;
        border: none;
    }

        .btn-primary:hover {
            background: #ff8533;
        }

    footer {
        background: #222;
        color: white;
        text-align: center;
        padding: 15px;
        margin-top: 50px;
    }
</style>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-controller="TrangChu" asp-action="Index">🌍 TravelVN</a>

            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="TrangChu" asp-action="Index">Trang chủ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" asp-controller="GoiYTour" asp-action="Index">Gợi ý tour</a>
                </li>

                @if (Context.Session.GetString("user") != null && Context.Session.GetString("role") != "admin")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="DatTour" asp-action="LichSu">Lịch sử đặt tour</a>
                    </li>
                }

                @if (Context.Session.GetString("role") == "admin")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">Quản lý Tour</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="DonDatTour">Đơn đặt Tour</a>
                    </li>
                }
            </ul>

            @if (Context.Session.GetString("user") != null)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="text-white fw-bold">
                        Xin chào, @Context.Session.GetString("user")
                    </span>

                    <a asp-controller="TaiKhoan" asp-action="DangXuat" class="btn btn-light btn-sm">
                        Đăng xuất
                    </a>
                </div>
            }
            else
            {
                <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-light">
                    Đăng nhập
                </a>
            }
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>