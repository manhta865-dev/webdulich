@model List<webdulich.Models.DiaDiem>

<h2 style="text-align:center;margin-bottom:30px">🌴 Địa điểm du lịch</h2>

<div style="width:90%;margin:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:25px">

@foreach (var item in Model)
{
    <div style="background:white;border-radius:10px;box-shadow:0 4px 10px rgba(0,0,0,0.1);text-align:center;padding:15px">

        <img src="~/images/dulich/@item.HinhAnh" 
             style="width:100%;height:200px;object-fit:cover;border-radius:10px" />

        <h4>@item.TenDiaDiem</h4>

        <a href="/DiaDiem/ChiTiet/@item.MaDiaDiem"
           style="background:#f4b400;padding:8px 15px;border-radius:6px;text-decoration:none;color:black">
           Xem chi tiết
        </a>

        <br /><br />
        <a asp-controller="DatTour"
   asp-action="DatTour"
   asp-route-id="@item.MaDiaDiem">
   Đặt Tour
</a>

    </div>
}

</div>