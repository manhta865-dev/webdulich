@model webdulich.Models.GoiYTourPageViewModel
@using System
@using System.Linq

@{
    ViewData["Title"] = "Gợi ý tour";

    var daChonTieuChi =
     !string.IsNullOrWhiteSpace(Model.TieuChi.LoaiTour) ||
     !string.IsNullOrWhiteSpace(Model.TieuChi.LoaiDiaHinh) ||
        !string.IsNullOrWhiteSpace(Model.TieuChi.PhongCach) ||
        !string.IsNullOrWhiteSpace(Model.TieuChi.PhuongTien) ||
        Model.TieuChi.SoNgay.HasValue ||
        Model.TieuChi.NganSachToiDa.HasValue ||
        Model.TieuChi.UuTienTourHot;
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/goi-y.css" asp-append-version="true" />
}

<div class="gy-page">
    <section class="gy-head">
        <h1>Gợi ý tour theo nhu cầu của bạn</h1>
        <p>
            Chọn vài tiêu chí về loại tour, địa hình, phong cách, ngân sách, thời gian và phương tiện.
            TravelVN sẽ lọc ra những chuyến đi phù hợp để bạn dễ quyết định hơn.
        </p>
    </section>

    <div class="gy-layout">
        <div class="gy-block">
            <h2>Chọn tiêu chí</h2>
            <p class="gy-note">Càng chọn rõ tiêu chí, kết quả gợi ý càng sát với mong muốn của bạn. Bạn không cần chọn hết các mục.</p>

            <form id="formGoiY" asp-controller="GoiYTour" asp-action="Index" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="goiy-label">Loại tour</label>
                        <select asp-for="TieuChi.LoaiTour" asp-items="Model.LoaiTourOptions" class="form-select goiy-control">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="goiy-label">Bạn thích kiểu địa hình nào?</label>
                        <select asp-for="TieuChi.LoaiDiaHinh" asp-items="Model.LoaiDiaHinhOptions" class="form-select goiy-control">
                            <option value="">-- Chọn kiểu địa điểm --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="goiy-label">Bạn muốn đi kiểu gì?</label>
                        <select asp-for="TieuChi.PhongCach" asp-items="Model.PhongCachOptions" class="form-select goiy-control">
                            <option value="">-- Chọn phong cách --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="goiy-label">Ngân sách tối đa (VNĐ)</label>
                        <input asp-for="TieuChi.NganSachToiDa" class="form-control goiy-control" placeholder="Ví dụ: 3000000" />
                    </div>

                    <div class="col-md-6">
                        <label class="goiy-label">Bạn muốn đi bao nhiêu ngày?</label>
                        <select asp-for="TieuChi.SoNgay" asp-items="Model.SoNgayOptions" class="form-select goiy-control">
                            <option value="">-- Chọn số ngày --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="goiy-label">Bạn muốn di chuyển bằng gì?</label>
                        <select asp-for="TieuChi.PhuongTien" asp-items="Model.PhuongTienOptions" class="form-select goiy-control">
                            <option value="">-- Chọn phương tiện --</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <div class="check-wrap">
                            <input asp-for="TieuChi.UuTienTourHot" class="form-check-input" />
                            <label class="form-check-label" asp-for="TieuChi.UuTienTourHot">Ưu tiên tour có nhiều người đặt</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <button class="tv-btn tv-btn-chinh gy-submit" type="submit">Gợi ý tour phù hợp</button>
                    </div>
                </div>
            </form>
        </div>

        <aside class="gy-block gy-how">
            <h2>Cách gợi ý hoạt động</h2>

            <ol>
                <li>
                    <strong>Bạn chọn tiêu chí</strong>
                    <span>Loại tour, địa hình, phong cách, ngân sách, số ngày và phương tiện.</span>
                </li>
                <li>
                    <strong>Hệ thống lọc và chấm điểm</strong>
                    <span>Tour càng khớp nhiều tiêu chí thì điểm càng cao. Danh sách xếp theo mức phù hợp và lượt quan tâm.</span>
                </li>
                <li>
                    <strong>Mỗi tour có lý do đề xuất</strong>
                    <span>Bạn thấy ngay tour khớp tiêu chí nào để dễ so sánh.</span>
                </li>
            </ol>
        </aside>
    </div>

    @if (Model.KetQua != null && Model.KetQua.Any())
    {
        <div id="ketqua" class="gy-result-head">
            <div>
                <h2>@(daChonTieuChi ? "Những tour phù hợp nhất" : "Bạn có thể bắt đầu từ các tour này")</h2>
                <p>@(daChonTieuChi ? "Kết quả theo tiêu chí của bạn, " : "")sắp xếp theo mức độ phù hợp và lượt quan tâm của khách hàng.</p>
            </div>

            <div class="gy-count"><strong>@Model.KetQua.Count</strong> tour gợi ý</div>
        </div>

        <div class="tv-grid">
            @foreach (var item in Model.KetQua)
            {
                var tour = item.Tour;
                var tenDiaDiem = !string.IsNullOrWhiteSpace(item.TenDiaDiemHienThi)
                ? item.TenDiaDiemHienThi
                : tour.TenDiaDiemHienThi;

                var soNgayText = tour.SoNgay.HasValue ? tour.SoNgay.Value + " ngày" : "Chưa cập nhật";
                var loaiDiaHinhText = tour.LoaiDiaHinhHienThi;
                var phongCachText = tour.PhongCachHienThi;
                var phuongTienText = tour.PhuongTienHienThi;

                var matchPercent = Math.Min(100, 55 + item.DiemGoiY * 8);

                var lyDoItems = (item.LyDoGoiY ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Take(4)
                .ToList();

                <article class="gy-card">
                    <div class="gy-card-media">
                        @if (!string.IsNullOrEmpty(tour.HinhAnh))
                        {
                            <img src="~/images/dulich/@tour.HinhAnh" alt="@tour.TenTour" loading="lazy" />
                        }
                        else
                        {
                            <div class="gy-no-img">Chưa có hình ảnh</div>
                        }

                        <span class="tv-pill">Điểm gợi ý: @item.DiemGoiY</span>
                    </div>

                    <div class="gy-card-body">
                        <div class="gy-match">
                            <div class="gy-match-text">
                                <span>Mức phù hợp</span>
                                <strong>@matchPercent%</strong>
                            </div>
                            <div class="gy-match-bar">
                                <div class="gy-match-fill" style="width:@matchPercent%"></div>
                            </div>
                        </div>

                        <h3 class="gy-card-title">@tour.TenTour</h3>

                        <div class="gy-place">
                            <svg class="tv-icon" aria-hidden="true"><use href="#i-pin" /></svg>
                            @tenDiaDiem
                        </div>

                        <div class="tv-tags">
                            @if (!string.IsNullOrWhiteSpace(loaiDiaHinhText) && loaiDiaHinhText != "Chưa cập nhật")
                            {
                                <span class="tv-tag">@loaiDiaHinhText</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(phongCachText) && phongCachText != "Chưa cập nhật")
                            {
                                <span class="tv-tag">@phongCachText</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(phuongTienText) && phuongTienText != "Chưa cập nhật")
                            {
                                <span class="tv-tag">@phuongTienText</span>
                            }

                            <span class="tv-tag">@soNgayText</span>
                        </div>

                        <div class="gy-reason">
                            <span class="gy-reason-title">Vì sao gợi ý tour này?</span>

                            @if (lyDoItems.Any())
                            {
                                <div class="gy-reason-chips">
                                    @foreach (var lyDo in lyDoItems)
                                    {
                                        <span class="gy-reason-chip">@lyDo</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="gy-reason-none">Tour phù hợp để bạn tham khảo.</span>
                            }
                        </div>

                        <div class="gy-meta">
                            <div>
                                <span class="tv-price-label">Lượt đặt: @item.SoLuotDat</span>
                                <div class="tv-price">@tour.Gia.ToString("N0") <small>VNĐ</small></div>
                            </div>
                        </div>

                        <div class="gy-actions">
                            <a asp-controller="DiaDiem"
                               asp-action="ChiTiet"
                               asp-route-id="@tour.Id"
                               class="tv-btn tv-btn-vien">Xem chi tiết</a>

                            <a asp-controller="DatTour"
                               asp-action="DatTour"
                               asp-route-id="@tour.Id"
                               class="tv-btn tv-btn-chinh">Đặt tour</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="tv-empty">
            <h3>Không tìm thấy tour phù hợp</h3>
            <p>Bạn thử đổi phong cách, chọn số ngày khác hoặc tăng ngân sách để xem thêm gợi ý nhé.</p>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("formGoiY");
        const ketqua = document.getElementById("ketqua");

        if (form) {
            form.addEventListener("submit", function () {
                sessionStorage.setItem("scrollToKetQuaGoiY", "true");
            });
        }

        const shouldScroll = sessionStorage.getItem("scrollToKetQuaGoiY");

        if (shouldScroll === "true" && ketqua) {
            sessionStorage.removeItem("scrollToKetQuaGoiY");

            setTimeout(function () {
                ketqua.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }, 200);
        }
    });
</script>