@model webdulich.Models.DatTours
@using System.Globalization

@{
    ViewData["Title"] = "Đặt tour";
    var tour = ViewBag.Tour as webdulich.Models.Tour;
    var lichKhoiHanh = ViewBag.LichKhoiHanh as webdulich.Models.LichKhoiHanhTour;
    decimal giaTour = tour != null ? tour.Gia : 0;
    decimal giaNguoiLon = lichKhoiHanh?.GiaNguoiLon ?? giaTour;
    decimal giaTreEm = lichKhoiHanh?.GiaTreEm ?? giaNguoiLon * 0.5m;
    var maChuyenDiTam = tour != null ? $"TRAVELVN-{tour.Id}-{DateTime.Now:yyyyMMddHHmmss}" : "TRAVELVN";
    var coLoi = !ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0);
}

@section Styles {
    <link rel="stylesheet" href="~/css/dat-tour.css" asp-append-version="true" />
}

<div class="dt-page">
    <h1>Đặt tour</h1>

    <partial name="_BuocDatTour" model="1" />

    <div class="dt-layout">
        <div>
            <form asp-controller="DatTour"
                  asp-action="DatTour"
                  method="post"
                  id="bookingForm"
                  class="booking-form @(coLoi ? "show-validation" : "")"
                  onsubmit="return validateBookingForm()">

                <input type="hidden" asp-for="TourId" />
                <input type="hidden" asp-for="LichKhoiHanhTourId" />
                <input type="hidden" asp-for="SoNguoi" id="SoNguoiHidden" />
                <input type="hidden" name="SoNguoiLon" id="SoNguoiLonHidden" value="1" />
                <input type="hidden" name="SoTreNho" id="SoTreNhoHidden" value="0" />

                <section class="dt-block">
                    <h2>Thông tin liên lạc</h2>
                    <p class="dt-note">Bạn đang đăng nhập, hãy kiểm tra thông tin trước khi xác nhận đặt tour.</p>

                    <div class="dt-info-grid">
                        <div class="full">
                            <label class="form-label">Họ tên *</label>
                            <input asp-for="TenKhach" class="form-control" readonly />
                            <span asp-validation-for="TenKhach" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="DienThoai" class="form-label">Điện thoại *</label>
                            <input asp-for="DienThoai" class="form-control" placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="DienThoai" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="form-label">Email *</label>
                            <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="full">
                            <label asp-for="DiaChi" class="form-label">Địa chỉ *</label>
                            <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ" />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="dt-block">
                    <h2>Số lượng hành khách</h2>

                    <div class="dt-counters">
                        <div class="dt-counter">
                            <div>
                                <strong>Người lớn</strong>
                                <small>Từ 12 tuổi trở lên</small>
                            </div>
                            <div class="counter">
                                <button type="button" onclick="changeAdult(-1)" aria-label="Giảm người lớn">-</button>
                                <div class="counter-value" id="adultCount">1</div>
                                <button type="button" onclick="changeAdult(1)" aria-label="Tăng người lớn">+</button>
                            </div>
                        </div>

                        <div class="dt-counter">
                            <div>
                                <strong>Trẻ nhỏ</strong>
                                <small>Từ 2 - 11 tuổi</small>
                            </div>
                            <div class="counter">
                                <button type="button" onclick="changeChild(-1)" aria-label="Giảm trẻ nhỏ">-</button>
                                <div class="counter-value" id="childCount">0</div>
                                <button type="button" onclick="changeChild(1)" aria-label="Tăng trẻ nhỏ">+</button>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="dt-block">
                    <h2>Thông tin hành khách</h2>
                    <p class="dt-note">Vui lòng nhập thông tin từng hành khách theo đúng số lượng người đi tour.</p>

                    <div id="passengerDetailList" class="passenger-detail-list"></div>
                </section>

                <section class="dt-block">
                    <h2>Thông tin chuyến đi</h2>

                    <div class="mb-3">
                        @if (Model.LichKhoiHanhTourId > 0)
                        {
                            <label class="form-label">Ngày đi đã chọn *</label>

                            <input type="hidden" name="NgayDi" value="@Model.NgayDi.ToString("yyyy-MM-dd")" />

                            <input type="text"
                                   class="form-control locked-date-input"
                                   value="@Model.NgayDi.ToString("dd/MM/yyyy")"
                                   readonly />

                            <div class="dt-locked-note">
                                Ngày đi được lấy từ lịch khởi hành bạn đã chọn ở trang chi tiết tour.
                            </div>
                        }
                        else
                        {
                            <label asp-for="NgayDi" class="form-label">Ngày đi *</label>
                            <input asp-for="NgayDi" type="date" class="form-control" />
                            <span asp-validation-for="NgayDi" class="text-danger"></span>
                        }
                    </div>

                    <div>
                        <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                        <textarea asp-for="GhiChu"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Ví dụ: cần hỗ trợ đặc biệt, muốn đi cùng gia đình..."></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger"></span>
                    </div>
                </section>

                <div class="dt-actions">
                    <button type="submit" class="tv-btn tv-btn-chinh">@(lichKhoiHanh?.SoDoChoNgoiId != null ? "Tiếp tục chọn chỗ ngồi" : "Tiếp tục thanh toán")</button>
                    <a asp-controller="TrangChu" asp-action="Index" class="tv-btn tv-btn-vien">Quay lại</a>
                </div>
            </form>
        </div>

        <aside class="dt-block dt-summary">
            <h2>Tóm tắt chuyến đi</h2>

            @if (tour != null)
            {
                <div class="dt-summary-tour">
                    <img src="~/images/dulich/@tour.HinhAnh" alt="@tour.TenTour" />
                    <div>
                        <h3>@tour.TenTour</h3>
                        <div class="dt-meta">
                            <svg class="tv-icon" aria-hidden="true"><use href="#i-pin" /></svg>
                            @tour.TenDiaDiemHienThi
                        </div>
                        <div class="dt-meta">
                            <svg class="tv-icon" aria-hidden="true"><use href="#i-clock" /></svg>
                            @(tour.SoNgay.HasValue ? tour.SoNgay + " ngày" : "Chưa cập nhật")
                        </div>
                        <div class="dt-meta">@tour.PhongCachHienThi</div>
                    </div>
                </div>

                @if (lichKhoiHanh != null)
                {
                    <div class="dt-line">
                        <span>Ngày khởi hành</span>
                        <span>@lichKhoiHanh.NgayKhoiHanh.ToString("dd/MM/yyyy")</span>
                    </div>

                    <div class="dt-line">
                        <span>Giờ khởi hành</span>
                        <span>@(lichKhoiHanh.GioKhoiHanh.HasValue ? lichKhoiHanh.GioKhoiHanh.Value.ToString(@"hh\:mm") : "Chưa cập nhật")</span>
                    </div>

                    <div class="dt-line">
                        <span>Số chỗ còn</span>
                        <span>@lichKhoiHanh.SoChoCon chỗ</span>
                    </div>
                }

                <div class="dt-line">
                    <span>Mã chuyến đi</span>
                    <span>@maChuyenDiTam</span>
                </div>

                <div class="dt-line">
                    <span>Giá tour / người lớn</span>
                    <span>@giaNguoiLon.ToString("N0") VNĐ</span>
                </div>

                <div class="dt-line">
                    <span>Giá trẻ nhỏ (50%)</span>
                    <span>@giaTreEm.ToString("N0") VNĐ</span>
                </div>

                <div class="dt-line">
                    <span>Người lớn</span>
                    <span id="adultSummary">1</span>
                </div>

                <div class="dt-line">
                    <span>Trẻ nhỏ</span>
                    <span id="childSummary">0</span>
                </div>

                <div class="dt-line">
                    <span>Tổng số người</span>
                    <span id="tongNguoiSummary">1</span>
                </div>

                <div class="dt-line total">
                    <span>Tổng tiền</span>
                    <span id="tongTien">@giaNguoiLon.ToString("N0") VNĐ</span>
                </div>
            }
        </aside>
    </div>
</div>

<script>
    let adultCount = 1;
    let childCount = 0;
    const giaNguoiLon = @giaNguoiLon.ToString(CultureInfo.InvariantCulture);
    const giaTreEm = @giaTreEm.ToString(CultureInfo.InvariantCulture);
    const soChoCon = @(lichKhoiHanh != null ? lichKhoiHanh.SoChoCon : 100);

    function escapeHtml(value) {
        return String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll("\"", "&quot;")
            .replaceAll("'", "&#039;");
    }

    function canIncreasePassenger() {
        if (adultCount + childCount >= soChoCon) {
            alert("Lịch khởi hành này chỉ còn " + soChoCon + " chỗ.");
            return false;
        }

        return true;
    }

    function changeAdult(value) {
        if (value > 0 && !canIncreasePassenger()) return;

        adultCount += value;
        if (adultCount < 1) adultCount = 1;

        updateBookingSummary();
    }

    function changeChild(value) {
        if (value > 0 && !canIncreasePassenger()) return;

        childCount += value;
        if (childCount < 0) childCount = 0;

        updateBookingSummary();
    }

    function updateBookingSummary() {
        const totalPeople = adultCount + childCount;
        const totalPrice = (adultCount * giaNguoiLon) + (childCount * giaTreEm);

        document.getElementById("adultCount").innerText = adultCount;
        document.getElementById("childCount").innerText = childCount;
        document.getElementById("adultSummary").innerText = adultCount;
        document.getElementById("childSummary").innerText = childCount;
        document.getElementById("tongNguoiSummary").innerText = totalPeople;
        document.getElementById("tongTien").innerText =
            new Intl.NumberFormat('vi-VN').format(totalPrice) + " VNĐ";

        document.getElementById("SoNguoiHidden").value = totalPeople;
        document.getElementById("SoNguoiLonHidden").value = adultCount;
        document.getElementById("SoTreNhoHidden").value = childCount;

        renderPassengerForms();
    }

    function renderPassengerForms() {
        const container = document.getElementById("passengerDetailList");
        if (!container) return;

        const oldValues = {};

        document.querySelectorAll(".passenger-input").forEach(function (input) {
            oldValues[input.name] = input.value;
        });

        container.innerHTML = "";

        let index = 0;
        let displayNumber = 1;

        function createPassengerCard(type) {
            const hoTenName = `HanhKhach[${index}].HoTen`;
            const loaiGiayToName = `HanhKhach[${index}].LoaiGiayTo`;
            const soGiayToName = `HanhKhach[${index}].SoGiayTo`;
            const loaiHanhKhachName = `HanhKhach[${index}].LoaiHanhKhach`;

            const tenDangNhap = document.querySelector('[name="TenKhach"]')?.value || "";
            const hoTenValue = oldValues[hoTenName] || (index === 0 ? tenDangNhap : "");
            const loaiGiayToValue = oldValues[loaiGiayToName] || "CCCD";
            const soGiayToValue = oldValues[soGiayToName] || "";

            const card = document.createElement("div");
            card.className = "passenger-detail-card";

            card.innerHTML = `
                <div class="passenger-detail-title">Hành khách ${displayNumber} - ${type}</div>

                <input type="hidden"
                       class="passenger-input"
                       name="${loaiHanhKhachName}"
                       value="${type}" />

                <div class="passenger-detail-grid">
                    <div>
                        <label class="form-label fw-bold">Họ và tên *</label>
                        <input type="text"
                               class="form-control passenger-input passenger-required"
                               name="${hoTenName}"
                               value="${escapeHtml(hoTenValue)}"
                               placeholder="Nhập họ tên hành khách" />
                        <div class="passenger-error" data-passenger-error="${hoTenName}"></div>
                    </div>

                    <div>
                        <label class="form-label fw-bold">Loại giấy tờ *</label>
                        <select class="form-control passenger-input passenger-required"
                                name="${loaiGiayToName}">
                            <option value="CCCD" ${loaiGiayToValue === "CCCD" ? "selected" : ""}>CCCD</option>
                            <option value="CMND" ${loaiGiayToValue === "CMND" ? "selected" : ""}>CMND</option>
                            <option value="Hộ chiếu" ${loaiGiayToValue === "Hộ chiếu" ? "selected" : ""}>Hộ chiếu</option>
                        </select>
                        <div class="passenger-error" data-passenger-error="${loaiGiayToName}"></div>
                    </div>

                    <div>
                        <label class="form-label fw-bold">Số giấy tờ *</label>
                        <input type="text"
                               class="form-control passenger-input passenger-required"
                               name="${soGiayToName}"
                               value="${escapeHtml(soGiayToValue)}"
                               placeholder="Nhập số giấy tờ" />
                        <div class="passenger-error" data-passenger-error="${soGiayToName}"></div>
                    </div>
                </div>
            `;

            container.appendChild(card);
            index++;
            displayNumber++;
        }

        for (let i = 0; i < adultCount; i++) {
            createPassengerCard("Người lớn");
        }

        for (let i = 0; i < childCount; i++) {
            createPassengerCard("Trẻ nhỏ");
        }
    }

    function setError(fieldName, message) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        const span = document.querySelector(`[data-valmsg-for="${fieldName}"]`);

        if (input) input.classList.add("input-validation-error");

        if (span) {
            span.textContent = message;
            span.classList.remove("field-validation-valid");
            span.classList.add("field-validation-error");
        }
    }

    function clearError(fieldName) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        const span = document.querySelector(`[data-valmsg-for="${fieldName}"]`);

        if (input) input.classList.remove("input-validation-error");

        if (span) {
            span.textContent = "";
            span.classList.remove("field-validation-error");
            span.classList.add("field-validation-valid");
        }
    }

    function validateBookingForm() {
        const form = document.getElementById("bookingForm");
        form.classList.add("show-validation");

        let isValid = true;

        const requiredFields = [
            { name: "DienThoai", message: "Vui lòng nhập số điện thoại" },
            { name: "Email", message: "Vui lòng nhập email" },
            { name: "DiaChi", message: "Vui lòng nhập địa chỉ" }
        ];

        requiredFields.forEach(function (field) {
            const input = document.querySelector(`[name="${field.name}"]`);

            if (!input || input.value.trim() === "") {
                setError(field.name, field.message);
                isValid = false;
            } else {
                clearError(field.name);
            }
        });

        const emailInput = document.querySelector(`[name="Email"]`);
        if (emailInput && emailInput.value.trim() !== "") {
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if (!emailRegex.test(emailInput.value.trim())) {
                setError("Email", "Email không hợp lệ");
                isValid = false;
            }
        }

        const dateInput = document.querySelector(`[name="NgayDi"][type="date"]`);
        if (dateInput && dateInput.value.trim() === "") {
            setError("NgayDi", "Vui lòng chọn ngày đi");
            isValid = false;
        }

        document.querySelectorAll(".passenger-required").forEach(function (input) {
            const error = document.querySelector(`[data-passenger-error="${input.name}"]`);

            if (input.value.trim() === "") {
                input.classList.add("input-validation-error");

                if (error) {
                    error.textContent = "Vui lòng nhập đầy đủ thông tin hành khách";
                }

                isValid = false;
            } else {
                input.classList.remove("input-validation-error");

                if (error) {
                    error.textContent = "";
                }
            }
        });

        return isValid;
    }

    document.addEventListener("DOMContentLoaded", function () {
        updateBookingSummary();

        ["DienThoai", "Email", "DiaChi", "NgayDi"].forEach(function (fieldName) {
            const input = document.querySelector(`[name="${fieldName}"]`);

            if (input && input.value.trim() !== "") {
                clearError(fieldName);
            }

            if (input) {
                input.addEventListener("input", function () {
                    if (input.value.trim() !== "") {
                        clearError(fieldName);
                    }
                });
            }
        });
    });

    document.addEventListener("input", function (event) {
        const input = event.target;

        if (input.classList.contains("passenger-required")) {
            const error = document.querySelector(`[data-passenger-error="${input.name}"]`);

            if (input.value.trim() !== "") {
                input.classList.remove("input-validation-error");

                if (error) {
                    error.textContent = "";
                }
            }
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}