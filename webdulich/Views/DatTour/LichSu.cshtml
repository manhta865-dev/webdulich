@model List<webdulich.Models.DonDatTourDoc>

@{
    ViewData["Title"] = "Lịch sử đặt tour";

    var tongDon = Model != null ? Model.Count : 0;
    var daThanhToan = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "Đã thanh toán") : 0;
    var dangKiemTra = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "Đang kiểm tra") : 0;
    var daHuy = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "Đã hủy") : 0;
    var choTheoDon = ViewBag.ChoTheoDon as Dictionary<int, List<string>> ?? new Dictionary<int, List<string>>();
    var gheNhom = ViewBag.GheNhom as List<webdulich.Models.GheNhomTrongLichSu> ?? new List<webdulich.Models.GheNhomTrongLichSu>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/lich-su.css" asp-append-version="true" />
}

<div class="ls-page">
    <h1>Lịch sử đặt tour</h1>
    <p class="ls-sub">Theo dõi mã chuyến đi, ngày khởi hành, giờ đi, giá tiền và trạng thái thanh toán.</p>

    @if (TempData["ThanhCong"] != null)
    {
        <div class="ls-alert ls-alert-ok" role="status">@TempData["ThanhCong"]</div>
    }

    @if (TempData["Loi"] != null)
    {
        <div class="ls-alert ls-alert-loi" role="alert">@TempData["Loi"]</div>
    }

    <div class="ls-stats">
        <div class="ls-stat">
            <strong>@tongDon</strong>
            <span>Tổng đơn đặt tour</span>
        </div>
        <div class="ls-stat">
            <strong>@dangKiemTra</strong>
            <span>Đang kiểm tra</span>
        </div>
        <div class="ls-stat">
            <strong>@daThanhToan</strong>
            <span>Đã thanh toán</span>
        </div>
        <div class="ls-stat">
            <strong>@daHuy</strong>
            <span>Đã hủy</span>
        </div>
    </div>

    @if (gheNhom.Any())
    {
        @* Không tính vào các con số ở trên: đó là đơn của người khác, bạn chỉ giữ một ghế *@
        <section class="ls-nhom-khu">
            <h2>Ghế bạn nhận trong đơn nhóm</h2>
            <div class="ls-list">
                @foreach (var g in gheNhom)
                {
                    <article class="ls-card">
                        <header class="ls-card-head">
                            <div>
                                <h2>@g.TenTour</h2>
                                <span class="ls-nhom">Nhóm của @g.TenTruongNhom</span>
                                <div class="ls-code">Mã chuyến đi: @g.MaChuyenDi</div>
                            </div>
                            <span class="badge-status @(g.DonDaHuy ? "status-cancelled" : g.TrangThai == "Đã trả" ? "status-paid" : g.TrangThai == "Chờ xác nhận thanh toán" ? "status-checking" : "status-unpaid")">@(g.DonDaHuy ? "Đơn đã hủy" : g.TrangThai)</span>
                        </header>
                        <dl class="ls-details">
                            <div>
                                <dt>Ngày đi</dt>
                                <dd>@g.NgayDi.ToString("dd/MM/yyyy")</dd>
                            </div>
                            <div>
                                <dt>Giờ đi</dt>
                                <dd>@(g.GioKhoiHanh.HasValue ? g.GioKhoiHanh.Value.ToString(@"hh\:mm") : "Chưa cập nhật")</dd>
                            </div>
                            <div>
                                <dt>Phần của bạn</dt>
                                <dd class="ls-money">@g.GiaLucDat.ToString("N0") VNĐ</dd>
                            </div>
                            <div>
                                <dt>Chỗ ngồi</dt>
                                <dd>@(g.MaCho ?? "Chưa chọn")</dd>
                            </div>
                        </dl>
                        @if (!g.DonDaHuy)
                        {
                            <footer class="ls-card-foot">
                                <a asp-controller="DonNhom" asp-action="GheCuaToi" asp-route-id="@g.GheId" class="tv-btn tv-btn-chinh">Xem ghế của tôi</a>
                            </footer>
                        }
                    </article>
                }
            </div>
        </section>
    }

    @if (Model != null && Model.Count > 0)
    {
        if (gheNhom.Any())
        {
            <h2 class="ls-khu-tieu-de">Đơn bạn đặt</h2>
        }
        <div class="ls-list">
            @foreach (var item in Model)
            {
                var cssStatus = "status-unpaid";

                if (item.TrangThaiThanhToan == "Đang kiểm tra")
                {
                    cssStatus = "status-checking";
                }
                else if (item.TrangThaiThanhToan == "Đã thanh toán")
                {
                    cssStatus = "status-paid";
                }
                else if (item.TrangThaiThanhToan == "Đã hủy")
                {
                    cssStatus = "status-cancelled";
                }

                var gioDi = item.GioKhoiHanh;

                <article class="ls-card">
                    <header class="ls-card-head">
                        <div>
                            <h2>@item.TenTour</h2>
                            @if (item.LoaiDon == "Nhom")
                            {
                                <span class="ls-nhom">Đơn nhóm</span>
                            }
                            <div class="ls-code">Mã chuyến đi: @(string.IsNullOrEmpty(item.MaChuyenDi) ? "Chưa có" : item.MaChuyenDi)</div>
                        </div>

                        <span class="badge-status @cssStatus">@item.TrangThaiThanhToan</span>
                    </header>

                    <dl class="ls-details">
                        <div>
                            <dt>Ngày đi</dt>
                            <dd>@item.NgayDi.ToString("dd/MM/yyyy")</dd>
                        </div>
                        <div>
                            <dt>Giờ đi</dt>
                            <dd>@(gioDi.HasValue ? gioDi.Value.ToString(@"hh\:mm") : "Chưa cập nhật")</dd>
                        </div>
                        <div>
                            <dt>Số người</dt>
                            <dd>@item.SoNguoi</dd>
                        </div>
                        <div>
                            <dt>Giá tiền</dt>
                            <dd class="ls-money">@item.TongTien.ToString("N0") VNĐ</dd>
                        </div>
                        @if (item.LoaiDon != "Nhom")
                        {
                            <div>
                                <dt>Thanh toán bằng</dt>
                                <dd>@item.PhuongThucThanhToan</dd>
                            </div>
                        }
                        <div>
                            <dt>Tên khách</dt>
                            <dd>@item.TenKhach</dd>
                        </div>
                        <div>
                            <dt>Điện thoại</dt>
                            <dd>@item.DienThoai</dd>
                        </div>
                        @if (item.CoSoDoChoNgoi && !item.DaHuy && item.LoaiDon != "Nhom")
                        {
                            <div>
                                <dt>Chỗ ngồi</dt>
                                <dd>@(choTheoDon.TryGetValue(item.Id, out var dsCho) && dsCho.Any() ? string.Join(", ", dsCho) : "Chưa chọn")</dd>
                            </div>
                        }
                    </dl>

                    @if (item.LoaiDon == "Nhom")
                    {
                        @* Đơn nhóm: chỗ ngồi, thanh toán và hủy làm theo từng ghế ở trang đơn nhóm *@
                        <footer class="ls-card-foot">
                            <a asp-controller="DonNhom" asp-action="ChiTiet" asp-route-id="@item.Id" class="tv-btn tv-btn-chinh">
                                @(item.TrangThai == "GiuCho" ? "Xem đơn nhóm và link mời" : "Xem đơn nhóm")
                            </a>
                        </footer>
                    }
                    else if (item.DuocDoiCho || item.TrangThaiThanhToan == "Đang kiểm tra" || item.TrangThaiThanhToan == "Chưa thanh toán")
                    {
                        <footer class="ls-card-foot">
                            @if (item.DuocDoiCho)
                            {
                                var daCoCho = choTheoDon.ContainsKey(item.Id);
                                <a asp-controller="DatTour" asp-action="DoiChoNgoi" asp-route-id="@item.Id" class="tv-btn tv-btn-vien">
                                    @(daCoCho ? "Đổi chỗ ngồi" : "Chọn chỗ ngồi")
                                </a>
                            }
                            @if (item.TrangThaiThanhToan == "Đang kiểm tra" || item.TrangThaiThanhToan == "Chưa thanh toán")
                            {
                                <form asp-controller="DatTour"
                                      asp-action="HuyDatTour"
                                      asp-route-id="@item.Id"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="tv-btn tv-btn-huy"
                                            onclick="return confirm('Bạn có chắc muốn hủy đơn này?');">
                                        Hủy đơn
                                    </button>
                                </form>
                            }
                        </footer>
                    }
                </article>
            }
        </div>
    }
    else if (!gheNhom.Any())
    {
        <div class="tv-empty">
            <h3>Bạn chưa có đơn đặt tour nào</h3>
            <p>Chọn một tour và ngày khởi hành để bắt đầu.</p>
            <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-btn tv-btn-chinh ls-empty-btn">Xem danh sách tour</a>
        </div>
    }
</div>
