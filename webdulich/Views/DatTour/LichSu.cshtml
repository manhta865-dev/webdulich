@model List<webdulich.Models.DatTours>

@{
    ViewData["Title"] = "Lịch sử đặt tour";

    var tongDon = Model != null ? Model.Count : 0;
    var daThanhToan = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "Đã thanh toán") : 0;
    var dangKiemTra = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "Đang kiểm tra") : 0;
    var daHuy = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "Đã hủy") : 0;
}

<style>
    :root {
        --blue-main: #0b74ff;
        --blue-dark: #073b78;
        --orange-main: #ff6b2c;
        --text-main: #0f172a;
        --text-muted: #64748b;
    }

    body {
        background: radial-gradient(circle at top left, rgba(11,116,255,0.08), transparent 30%), linear-gradient(180deg, #f8f5ee 0%, #eef4fb 100%) !important;
        color: var(--text-main);
        min-height: 100vh;
    }

    .history-page {
        max-width: 1580px;
        margin: 34px auto 70px;
        padding: 0 18px;
    }

    .history-hero {
        border-radius: 28px;
        padding: 34px 28px;
        color: white;
        background: linear-gradient(135deg, rgba(7,59,120,0.92), rgba(11,116,255,0.78)), url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat;
        box-shadow: 0 22px 55px rgba(7,59,120,0.18);
        margin-bottom: 22px;
        overflow: hidden;
        position: relative;
    }

    .history-hero::after {
        content: "";
        position: absolute;
        inset: auto 0 0 0;
        height: 5px;
        background: linear-gradient(90deg, var(--orange-main), #ffd166, var(--blue-main));
    }

    .history-title {
        text-align: center;
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 950;
        margin: 0 0 10px;
        letter-spacing: -0.02em;
    }

    .history-subtitle {
        text-align: center;
        color: rgba(255,255,255,0.9);
        font-weight: 650;
        margin: 0;
    }

    .history-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-top: 26px;
    }

    .history-stat {
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.22);
        border-radius: 18px;
        padding: 16px;
        text-align: center;
    }

    .history-stat strong {
        display: block;
        font-size: 1.65rem;
        font-weight: 950;
        margin-bottom: 2px;
    }

    .history-stat span {
        color: rgba(255,255,255,0.82);
        font-weight: 700;
    }

    .history-alert {
        margin-bottom: 18px;
        padding: 14px 18px;
        border-radius: 16px;
        font-weight: 850;
    }

    .history-alert.success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
    }

    .history-alert.error {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .history-card {
        background: rgba(255,255,255,0.96);
        border: 1px solid rgba(214,170,63,0.22);
        border-radius: 26px;
        box-shadow: 0 22px 55px rgba(15,23,42,0.09);
        padding: 24px;
    }

    .history-table-wrap {
        border: 1px solid #dbeafe;
        border-radius: 20px;
        overflow: auto;
        background: white;
    }

    .history-table {
        min-width: 1460px;
        margin-bottom: 0;
        color: var(--text-main);
        border-color: #dbeafe;
    }

    .history-table thead th {
        background: linear-gradient(135deg, #073b78, #0b4fa8);
        color: white;
        text-align: center;
        vertical-align: middle;
        border-color: rgba(255,255,255,0.16);
        padding: 17px 16px;
        font-weight: 900;
        white-space: nowrap;
    }

    .history-table tbody td {
        vertical-align: middle;
        border-color: #e2e8f0;
        padding: 18px 16px;
        font-weight: 700;
        background: #ffffff;
    }

    .history-table tbody tr:nth-child(even) td {
        background: #f8fbff;
    }

    .history-table tbody tr:hover td {
        background: #eef6ff;
    }

    .ma-chuyen-di {
        color: var(--blue-dark);
        font-weight: 950;
        white-space: nowrap;
    }

    .customer-name {
        font-weight: 900;
        color: #0f172a;
    }

    .phone-cell,
    .date-cell,
    .time-cell {
        white-space: nowrap;
        color: #1e293b;
    }

    .time-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fed7aa;
        font-weight: 900;
        white-space: nowrap;
    }

    .tour-name {
        color: #073b78;
        font-weight: 950;
        text-transform: uppercase;
    }

    .money {
        color: var(--orange-main);
        font-weight: 950;
        white-space: nowrap;
    }

    .payment-method {
        color: #334155;
        font-weight: 850;
    }

    .badge-status {
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 0.88rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 138px;
        text-align: center;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .status-unpaid {
        background: #fee2e2;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .status-checking {
        background: #fff7ed;
        color: #c2410c;
        border-color: #fed7aa;
    }

    .status-paid {
        background: #dcfce7;
        color: #166534;
        border-color: #bbf7d0;
    }

    .status-cancelled {
        background: #e5e7eb;
        color: #374151;
        border-color: #d1d5db;
    }

    .btn-cancel-order {
        border: none;
        border-radius: 999px;
        padding: 9px 14px;
        background: #dc2626;
        color: white;
        font-weight: 900;
        white-space: nowrap;
    }

    .btn-cancel-order:hover {
        background: #b91c1c;
    }

    .cancelled-note {
        color: #64748b;
        font-weight: 900;
        white-space: nowrap;
    }

    .empty-box {
        text-align: center;
        padding: 48px 20px !important;
        color: var(--text-muted);
        font-size: 1.05rem;
        background: white !important;
    }

    @@media (max-width: 768px) {
        .history-page {
            margin-top: 22px;
            padding: 0 10px;
        }

        .history-hero {
            padding: 28px 18px;
        }

        .history-stats {
            grid-template-columns: 1fr;
        }

        .history-card {
            padding: 14px;
        }
    }
</style>

<div class="history-page">
    <div class="history-hero">
        @if (TempData["ThanhCong"] != null)
        {
            <div class="history-alert success">@TempData["ThanhCong"]</div>
        }

        @if (TempData["Loi"] != null)
        {
            <div class="history-alert error">@TempData["Loi"]</div>
        }

        <h1 class="history-title">📋 Lịch sử đặt tour của bạn</h1>
        <p class="history-subtitle">
            Theo dõi mã chuyến đi, ngày khởi hành, giờ đi, giá tiền và trạng thái thanh toán.
        </p>

        <div class="history-stats">
            <div class="history-stat">
                <strong>@tongDon</strong>
                <span>Tổng đơn đặt tour</span>
            </div>

            <div class="history-stat">
                <strong>@dangKiemTra</strong>
                <span>Đang kiểm tra</span>
            </div>

            <div class="history-stat">
                <strong>@daThanhToan</strong>
                <span>Đã thanh toán</span>
            </div>

            <div class="history-stat">
                <strong>@daHuy</strong>
                <span>Đã hủy</span>
            </div>
        </div>
    </div>

    <div class="history-card">
        <div class="table-responsive history-table-wrap">
            <table class="table table-bordered table-hover align-middle history-table">
                <thead>
                    <tr>
                        <th>Mã chuyến đi</th>
                        <th>Tên khách</th>
                        <th>Điện thoại</th>
                        <th>Số người</th>
                        <th>Ngày đi</th>
                        <th>Giờ đi</th>
                        <th>Tên tour</th>
                        <th>Giá tiền</th>
                        <th>Thanh toán bằng</th>
                        <th>Trạng thái thanh toán</th>
                        <th>Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            var cssStatus = "status-unpaid";

                            if (item.TrangThaiThanhToan == "Đang kiểm tra")
                            {
                                cssStatus = "status-checking";
                            }
                            else if (item.TrangThaiThanhToan == "Đã thanh toán")
                            {
                                cssStatus = "status-paid";
                            }
                            else if (item.TrangThaiThanhToan == "Đã hủy")
                            {
                                cssStatus = "status-cancelled";
                            }

                            var gioDi = item.LichKhoiHanhTour?.GioKhoiHanh;

                            <tr>
                                <td class="ma-chuyen-di">
                                    @(string.IsNullOrEmpty(item.MaChuyenDi) ? "Chưa có" : item.MaChuyenDi)
                                </td>

                                <td class="customer-name">@item.TenKhach</td>
                                <td class="phone-cell">@item.DienThoai</td>
                                <td>@item.SoNguoi</td>
                                <td class="date-cell">@item.NgayDi.ToString("dd/MM/yyyy")</td>

                                <td class="time-cell">
                                    <span class="time-pill">
                                        🕒 @(gioDi.HasValue ? gioDi.Value.ToString(@"hh\:mm") : "Chưa cập nhật")
                                    </span>
                                </td>

                                <td class="tour-name">@item.Tour?.TenTour</td>
                                <td class="money">@item.TongTien.ToString("N0") VNĐ</td>
                                <td class="payment-method">@item.PhuongThucThanhToan</td>

                                <td>
                                    <span class="badge-status @cssStatus">
                                        @item.TrangThaiThanhToan
                                    </span>
                                </td>

                                <td>
                                    @if (item.TrangThaiThanhToan == "Đang kiểm tra" || item.TrangThaiThanhToan == "Chưa thanh toán")
                                    {
                                        <form asp-controller="DatTour"
                                              asp-action="HuyDatTour"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn-cancel-order"
                                                    onclick="return confirm('Bạn có chắc muốn hủy đơn này?');">
                                                Hủy đơn
                                            </button>
                                        </form>
                                    }
                                    else if (item.TrangThaiThanhToan == "Đã hủy")
                                    {
                                        <span class="cancelled-note">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">---</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="empty-box">
                                Bạn chưa có đơn đặt tour nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>