@model webdulich.Models.TaiKhoan
@inject IConfiguration CauHinh

@* Trang đăng nhập và đăng ký dùng chung một khung: DangNhap.cshtml và DangKy.cshtml có nội dung giống hệt nhau,
   sửa một file thì chép sang file kia. Bấm Đăng ký / Đăng nhập thì tấm ảnh trượt qua, đổi form mà không tải lại trang. *@
@{
    // Nút Google chỉ hiện khi đã có khóa trong cấu hình
    bool coGoogle = !string.IsNullOrEmpty(CauHinh["Google:ClientId"]) && !string.IsNullOrEmpty(CauHinh["Google:ClientSecret"]);
    var loiGoogle = ViewBag.LoiGoogle as string ?? TempData["LoiGoogle"] as string;
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
    bool moDangKy = actionName == "DangKy";
    ViewData["Title"] = moDangKy ? "Đăng ký" : "Đăng nhập";
    // Trang cần quay lại sau đăng nhập (đã kiểm là đường dẫn nội bộ trong controller)
    var returnUrl = ViewBag.ReturnUrl as string;
    var tuLinkMoi = returnUrl?.StartsWith("/DonNhom/Moi") == true;

    // Lỗi của form đăng nhập do controller ghi vào ModelState (sai tài khoản hoặc mật khẩu, bỏ trống ô)
    // Theo thứ tự các ô trên form: lỗi chung, rồi ô tài khoản, rồi ô mật khẩu
    var loiDangNhap = moDangKy
        ? new List<string>()
        : new[] { "", "taiKhoanDangNhap", "matKhau" }
            .SelectMany(khoa => ViewData.ModelState.TryGetValue(khoa, out var o) ? o.Errors : Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
            .Select(e => e.ErrorMessage)
            .Distinct()
            .ToList();
    // Gõ sai thì giữ lại email hoặc số điện thoại đã gõ, chỉ xóa mật khẩu
    var taiKhoanDaGo = !moDangKy && Context.Request.HasFormContentType ? Context.Request.Form["taiKhoanDangNhap"].ToString() : "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tai-khoan.css" asp-append-version="true" />
}

<div class="dn-trang">
    <div class="dn-hop @(moDangKy ? "active" : "")" id="authBox">

        @* ---------- Form đăng nhập (bên trái) ---------- *@
        <section class="dn-form signin-panel" aria-labelledby="dnTieuDeVao" @(moDangKy ? "inert" : "")>
            <p class="dn-thuong-hieu">TravelVN</p>
            <h1 class="dn-tieu-de" id="dnTieuDeVao">Đăng nhập</h1>
            <p class="dn-mo-ta">@(tuLinkMoi ? "Đăng nhập để nhận ghế trong đơn nhóm. Xong bạn sẽ quay lại trang mời." : "Dùng email hoặc số điện thoại bạn đã đăng ký.")</p>

            @if (TempData["ThanhCong"] != null)
            {
                <div class="dn-bao dn-bao-ok" role="status">@TempData["ThanhCong"]</div>
            }
            @if (ViewBag.Loi != null && !moDangKy)
            {
                <div class="dn-bao dn-bao-loi" role="alert">@ViewBag.Loi</div>
            }

            <form asp-controller="TaiKhoan" asp-action="DangNhap" method="post" class="dn-khung-o">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                @if (loiDangNhap.Any())
                {
                    <div class="dn-bao dn-bao-loi" role="alert">@string.Join(" ", loiDangNhap)</div>
                }
                @if (!moDangKy && loiGoogle != null)
                {
                    <div class="dn-bao dn-bao-loi" role="alert">@loiGoogle</div>
                }

                <div class="dn-o">
                    <label for="dnTaiKhoan">Email hoặc số điện thoại</label>
                    <input id="dnTaiKhoan" name="taiKhoanDangNhap" value="@taiKhoanDaGo" autocomplete="username" />
                </div>
                <div class="dn-o">
                    <label for="dnMatKhau">Mật khẩu</label>
                    <div class="dn-mat-khau">
                        <input id="dnMatKhau" name="matKhau" type="password" autocomplete="current-password" />
                        <button type="button" class="dn-hien" data-hien-cho="dnMatKhau" aria-pressed="false">Hiện</button>
                    </div>
                </div>

                <button type="submit" class="dn-nut-chinh">Đăng nhập</button>
            </form>

            @if (coGoogle)
            {
                <div class="dn-hoac"><span>hoặc</span></div>
                <form asp-controller="TaiKhoan" asp-action="DangNhapGoogle" method="post">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="dn-nut-google">
                        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.7-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.7-.4-3.9z"/></svg>
                        Tiếp tục với Google
                    </button>
                </form>
                <p class="dn-ghi-chu">Nút lỗi trong Zalo, Messenger? Mở link bằng Chrome hoặc Safari.</p>
            }

            <p class="dn-chuyen">Chưa có tài khoản? <button type="button" onclick="showSignUp()">Đăng ký</button></p>
        </section>

        @* ---------- Form đăng ký (trượt sang phải khi mở) ---------- *@
        <section class="dn-form signup-panel" aria-labelledby="dnTieuDeTao" @(moDangKy ? "" : "inert")>
            <p class="dn-thuong-hieu">TravelVN</p>
            <h1 class="dn-tieu-de" id="dnTieuDeTao">Tạo tài khoản</h1>
            <p class="dn-mo-ta">Có tài khoản để đặt tour, nhận ghế trong đơn nhóm và xem lại chuyến đi.</p>

            @if (ViewBag.Loi != null && moDangKy)
            {
                <div class="dn-bao dn-bao-loi" role="alert">@ViewBag.Loi</div>
            }

            <form asp-controller="TaiKhoan" asp-action="DangKy" method="post" class="dn-khung-o">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="dn-o">
                    <label asp-for="HoTen">Họ và tên</label>
                    <input asp-for="HoTen" autocomplete="name" />
                    <span asp-validation-for="HoTen" class="dn-loi-o"></span>
                </div>
                <div class="dn-o">
                    <label asp-for="TaiKhoanDangNhap">Email hoặc số điện thoại</label>
                    <input asp-for="TaiKhoanDangNhap" autocomplete="username" />
                    <span asp-validation-for="TaiKhoanDangNhap" class="dn-loi-o"></span>
                </div>
                <div class="dn-o">
                    <label asp-for="MatKhau">Mật khẩu</label>
                    <div class="dn-mat-khau">
                        <input asp-for="MatKhau" type="password" autocomplete="new-password" placeholder="Ít nhất 6 ký tự" />
                        <button type="button" class="dn-hien" data-hien-cho="MatKhau" aria-pressed="false">Hiện</button>
                    </div>
                    <span asp-validation-for="MatKhau" class="dn-loi-o"></span>
                </div>

                <button type="submit" class="dn-nut-chinh">Đăng ký</button>
            </form>

            @if (coGoogle)
            {
                <div class="dn-hoac"><span>hoặc</span></div>
                <form asp-controller="TaiKhoan" asp-action="DangNhapGoogle" method="post">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="dn-nut-google">
                        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.7-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.7-.4-3.9z"/></svg>
                        Tiếp tục với Google
                    </button>
                </form>
            }

            <p class="dn-chuyen">Đã có tài khoản? <button type="button" onclick="showSignIn()">Đăng nhập</button></p>
        </section>

        @* ---------- Tấm ảnh che nửa còn lại, trượt qua lại ---------- *@
        <div class="dn-anh" aria-hidden="true">
            <div class="dn-anh-noi cover-signup">
                <p class="dn-anh-nhan">Lần đầu đến TravelVN?</p>
                <h2>Đi theo nhóm, mỗi người tự lo phần mình</h2>
                <ul>
                    <li>Trưởng nhóm gửi link, mỗi người tự nhận ghế</li>
                    <li>Tự điền thông tin và tự trả phần của mình</li>
                    <li>Biết ngay ai đã trả, ai chưa</li>
                </ul>
                <button type="button" class="dn-nut-vien" onclick="showSignUp()" tabindex="-1">Tạo tài khoản</button>
            </div>

            <div class="dn-anh-noi cover-signin">
                <p class="dn-anh-nhan">Đã có tài khoản?</p>
                <h2>Mừng bạn quay lại</h2>
                <p>Đăng nhập để tiếp tục đặt tour, nhận ghế nhóm và xem lịch sử chuyến đi.</p>
                <button type="button" class="dn-nut-vien" onclick="showSignIn()" tabindex="-1">Đăng nhập</button>
            </div>
        </div>
    </div>
</div>

<script>
    const authBox = document.getElementById("authBox");
    const formVao = authBox.querySelector(".signin-panel");
    const formTao = authBox.querySelector(".signup-panel");

    // Form đang khuất được đánh dấu inert để phím Tab không nhảy vào ô bị che
    function doiForm(moTao) {
        authBox.classList.toggle("active", moTao);
        formVao.inert = moTao;
        formTao.inert = !moTao;
        const oDau = (moTao ? formTao : formVao).querySelector("input:not([type=hidden])");
        if (oDau) setTimeout(function () { oDau.focus({ preventScroll: true }); }, 400);
    }

    // Giữ ?returnUrl=... khi chuyển qua lại giữa đăng nhập và đăng ký
    function showSignUp() {
        doiForm(true);
        history.replaceState(null, "", "/TaiKhoan/DangKy" + location.search);
    }

    function showSignIn() {
        doiForm(false);
        history.replaceState(null, "", "/TaiKhoan/DangNhap" + location.search);
    }

    // Nút Hiện / Ẩn mật khẩu
    document.querySelectorAll(".dn-hien").forEach(function (nut) {
        nut.addEventListener("click", function () {
            const o = document.getElementById(nut.dataset.hienCho);
            if (!o) return;
            const hien = o.type === "password";
            o.type = hien ? "text" : "password";
            nut.textContent = hien ? "Ẩn" : "Hiện";
            nut.setAttribute("aria-pressed", hien ? "true" : "false");
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
