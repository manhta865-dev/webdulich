
@model List<webdulich.Models.PhanCongTour>

@{
    ViewData["Title"] = "Lịch làm việc";
    var nv = ViewBag.NhanVien as webdulich.Models.NhanVien;
}

<style>
    .work-page {
        max-width: 1260px;
        margin: 0 auto;
        padding: 34px 12px 42px;
    }

    .work-card {
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: 26px;
        background: linear-gradient(180deg, #ffffff 0%, #fffdf8 100%);
        box-shadow: 0 22px 55px rgba(15, 23, 42, 0.10);
        overflow: hidden;
    }

    .work-header {
        padding: 28px 32px;
        background: radial-gradient(circle at top left, rgba(232, 201, 109, 0.20), transparent 34%), linear-gradient(135deg, #0f172a 0%, #14213f 100%);
        color: #ffffff;
        border-bottom: 3px solid #e8c96d;
    }

    .work-title {
        margin: 0;
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 900;
        color: #f5e6b8;
    }

    .work-subtitle {
        margin: 8px 0 0;
        color: rgba(255,255,255,0.78);
        font-weight: 650;
    }

    .work-body {
        padding: 26px 30px 30px;
    }

    .work-table-wrap {
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        background: #ffffff;
    }

    .work-table {
        margin: 0;
    }

        .work-table thead th {
            background: #0f172a;
            color: #f8fafc;
            border-color: rgba(255,255,255,0.12);
            padding: 15px 16px;
            font-weight: 900;
            white-space: nowrap;
        }

        .work-table tbody td {
            padding: 15px 16px;
            vertical-align: middle;
            border-color: #e5e7eb;
            color: #0f172a;
            font-weight: 650;
        }

        .work-table tbody tr:nth-child(even) {
            background: #fffaf0;
        }

        .work-table tbody tr:hover {
            background: #f8fbff;
        }

    .tour-name {
        font-weight: 950;
        color: #071633;
        text-transform: uppercase;
    }

    .work-empty {
        border: 1px solid #bae6fd;
        background: #e0f7ff;
        color: #036783;
        border-radius: 16px;
        padding: 18px 20px;
        font-weight: 800;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .work-page {
            padding: 18px 8px 28px;
        }

        .work-header {
            padding: 22px 16px;
        }

        .work-title {
            font-size: 1.55rem;
        }

        .work-body {
            padding: 18px 14px 20px;
        }

        .work-table thead th,
        .work-table tbody td {
            padding: 12px;
            font-size: 0.92rem;
        }
    }
</style>

<div class="work-page">
    <div class="work-card">
        <div class="work-header">
            <h3 class="work-title">📅 Lịch làm việc của @nv?.HoTen</h3>
            <p class="work-subtitle">Danh sách tour bạn được phân công tham gia.</p>
        </div>

        <div class="work-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive work-table-wrap">
                    <table class="table table-bordered align-middle work-table">
                        <thead>
                            <tr>
                                <th>Tour</th>
                                <th>Địa điểm</th>
                                <th>Ngày đi</th>
                                <th>Giờ đi</th>
                                <th>Phương tiện</th>
                                <th>Hướng dẫn viên</th>
                                <th>Tài xế</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                var lich = item.LichKhoiHanhTour;
                                var tour = lich?.Tour;

                                <tr>
                                    <td class="tour-name">@tour?.TenTour</td>
                                    <td>@tour?.TenDiaDiemHienThi</td>
                                    <td>@lich?.NgayKhoiHanh.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @(lich?.GioKhoiHanh.HasValue == true
                                                                        ? lich.GioKhoiHanh.Value.ToString(@"hh\:mm")
                                                                        : "Chưa cập nhật")
                            </td>
                            <td>@tour?.PhuongTienHienThi</td>
                            <td>@item.HuongDanVien?.HoTen</td>
                            <td>@(item.TaiXe?.HoTen ?? "Không có")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.GhiChu) ? "Không có" : item.GhiChu)</td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="work-empty">
                    Hiện tại bạn chưa có lịch làm việc nào.
                </div>
            }
        </div>
    </div>
</div>

