@model List<webdulich.Models.PhanCongTour>

@{
    ViewData["Title"] = "Lịch làm việc";
    var nv = ViewBag.NhanVien as webdulich.Models.NhanVien;
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Lịch làm việc của @nv?.TaiKhoan?.HoTen</h1>
            <p>Danh sách tour bạn được phân công tham gia.</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="ad-table-card">
            <div class="ad-table-wrap">
                <table class="ad-table">
                    <thead>
                        <tr>
                            <th>Tour</th>
                            <th>Địa điểm</th>
                            <th>Ngày đi</th>
                            <th>Giờ đi</th>
                            <th>Phương tiện</th>
                            <th>Hướng dẫn viên</th>
                            <th>Tài xế</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var lich = item.LichKhoiHanhTour;
                            var tour = lich?.Tour;

                            <tr>
                                <td><strong>@tour?.TenTour</strong></td>
                                <td>@tour?.TenDiaDiemHienThi</td>
                                <td>@lich?.NgayKhoiHanh.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @(lich?.GioKhoiHanh.HasValue == true
                                        ? lich.GioKhoiHanh.Value.ToString(@"hh\:mm")
                                        : "Chưa cập nhật")
                                </td>
                                <td>@tour?.PhuongTienHienThi</td>
                                <td>@item.HuongDanVien?.TaiKhoan?.HoTen</td>
                                <td>@(item.TaiXe?.TaiKhoan?.HoTen ?? "Không có")</td>
                                <td>@(string.IsNullOrWhiteSpace(item.GhiChu) ? "Không có" : item.GhiChu)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="tv-empty">
            <p>Hiện tại bạn chưa có lịch làm việc nào.</p>
        </div>
    }
</div>