@model webdulich.Models.Tour

@{
    ViewData["Title"] = Model.TenTour;

    var danhSachAnh = new List<string>();

    if (!string.IsNullOrEmpty(Model.HinhAnh))
    {
        danhSachAnh.Add(Model.HinhAnh);
    }

    if (Model.TourHinhAnhs != null && Model.TourHinhAnhs.Any())
    {
        danhSachAnh.AddRange(Model.TourHinhAnhs
            .OrderBy(x => x.ThuTu)
            .Select(x => x.TenFile)
            .Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    danhSachAnh = danhSachAnh.Distinct().ToList();

    var lichKhoiHanh = ViewBag.LichKhoiHanh as List<webdulich.Models.LichKhoiHanhTour>;
    var lichTrinhTour = Model.LichTrinhTours != null
        ? Model.LichTrinhTours.OrderBy(x => x.NgayThu).ToList()
        : new List<webdulich.Models.LichTrinhTour>();

    var loaiTourText = Model.DanhMuc?.TenDanhMuc ?? "Tour du lịch";
    var phuongTienText = Model.PhuongTienHienThi;

    double diemTB = ViewBag.DiemTrungBinh is double tb ? tb : 0;
    int soDanhGia = ViewBag.SoDanhGia is int sl ? sl : 0;
    var demSao = ViewBag.DemSao as Dictionary<int, int> ?? new Dictionary<int, int>();
    var dsDanhGia = ViewBag.DanhGia as List<webdulich.Models.DanhGiaHienThi> ?? new List<webdulich.Models.DanhGiaHienThi>();

    // Đủ điểm xuất phát và tọa độ mọi ngày: có trang Khám phá 3D và link Google Maps cả hành trình
    bool duToaDo = Model.ViDoXuatPhat.HasValue && Model.KinhDoXuatPhat.HasValue
        && lichTrinhTour.Count > 0 && lichTrinhTour.All(x => x.ViDo.HasValue && x.KinhDo.HasValue);
    string? linkCaHanhTrinh = duToaDo
        ? webdulich.Services.LienKetBanDo.ChiDuong((Model.ViDoXuatPhat!.Value, Model.KinhDoXuatPhat!.Value),
            (lichTrinhTour[^1].ViDo!.Value, lichTrinhTour[^1].KinhDo!.Value),
            lichTrinhTour.Take(lichTrinhTour.Count - 1).Select(x => (x.ViDo!.Value, x.KinhDo!.Value)).ToList())
        : null;
    // Link Google Maps chỉ đường của một ngày: từ điểm ngày trước (ngày đầu: điểm xuất phát) tới điểm ngày đó
    string? LinkNgay(int i)
    {
        var den = lichTrinhTour[i];
        if (!den.ViDo.HasValue || !den.KinhDo.HasValue) return null;
        (decimal, decimal)? tu = i == 0
            ? (Model.ViDoXuatPhat.HasValue && Model.KinhDoXuatPhat.HasValue ? (Model.ViDoXuatPhat.Value, Model.KinhDoXuatPhat.Value) : null)
            : (lichTrinhTour[i - 1].ViDo.HasValue && lichTrinhTour[i - 1].KinhDo.HasValue ? (lichTrinhTour[i - 1].ViDo!.Value, lichTrinhTour[i - 1].KinhDo!.Value) : null);
        return tu.HasValue ? webdulich.Services.LienKetBanDo.ChiDuong(tu.Value, (den.ViDo.Value, den.KinhDo.Value)) : null;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chi-tiet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/danh-gia.css" asp-append-version="true" />
}

<nav class="ct-crumb" aria-label="Điều hướng">
    <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-link">
        <svg class="tv-icon" aria-hidden="true"><use href="#i-arrow" /></svg>
        Danh sách tour
    </a>
</nav>

@if (TempData["Loi"] != null)
{
    @* Lý do không đặt được, gửi về từ DatTour và DonNhom (lịch hết nhận đặt, đơn nhóm sát ngày đi) *@
    <div class="ct-alert" role="alert">@TempData["Loi"]</div>
}

<section class="ct-top">
    <div class="ct-gallery">
        @if (danhSachAnh.Any())
        {
            <img id="mainImage" src="~/images/dulich/@danhSachAnh.First()" class="ct-main-img" alt="@Model.TenTour" />
        }
        else
        {
            <div class="ct-main-img ct-no-img">Chưa có hình ảnh</div>
        }

        @if (danhSachAnh.Count > 1)
        {
            <div class="ct-thumbs">
                @foreach (var anh in danhSachAnh)
                {
                    <button type="button" class="ct-thumb" onclick="changeImage(this)" aria-label="Xem ảnh tour">
                        <img src="~/images/dulich/@anh" alt="" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>

    <div class="ct-summary">
        <div class="tv-tags">
            <span class="tv-tag">@loaiTourText</span>
            @if (!string.IsNullOrWhiteSpace(phuongTienText) && phuongTienText != "Chưa cập nhật")
            {
                <span class="tv-tag">@phuongTienText</span>
            }
        </div>

        <h1 class="ct-title">@Model.TenTour</h1>

        @if (soDanhGia > 0)
        {
            <a href="#danhGia" class="dg-tom" aria-label="Điểm đánh giá @diemTB.ToString("0.0") trên 5, @soDanhGia lượt">
                <span class="tv-sao" aria-hidden="true">
                    @for (int s = 1; s <= 5; s++)
                    {
                        <i class="@(s <= Math.Round(diemTB) ? "co" : "")">★</i>
                    }
                </span>
                <strong>@diemTB.ToString("0.0")</strong>
                <span>(@soDanhGia đánh giá)</span>
            </a>
        }

        <div class="ct-price">
            <span class="tv-price-label">Giá trọn gói từ</span>
            <span class="ct-price-value">@Model.Gia.ToString("N0") <small>VNĐ</small></span>
        </div>

        <p class="ct-desc">
            @(string.IsNullOrEmpty(Model.MoTa) ? "Thông tin mô tả của tour đang được cập nhật." : Model.MoTa)
        </p>

        <dl class="ct-specs">
            <div>
                <dt>Địa điểm</dt>
                <dd>@Model.TenDiaDiemHienThi</dd>
            </div>
            <div>
                <dt>Thời gian</dt>
                <dd>@(Model.SoNgay.HasValue ? Model.SoNgay.Value + " ngày" : "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Địa hình</dt>
                <dd>@Model.LoaiDiaHinhHienThi</dd>
            </div>
            <div>
                <dt>Phong cách</dt>
                <dd>@Model.PhongCachHienThi</dd>
            </div>
        </dl>

        <div class="ct-actions">
            <a href="#departureSection" class="tv-btn tv-btn-chinh">Chọn ngày khởi hành</a>
            <a href="#itinerarySection" class="tv-btn tv-btn-vien">Xem lịch trình</a>
        </div>
    </div>
</section>

<div class="ct-body">
    <section id="itinerarySection" class="ct-itinerary">
        <h2>Lịch trình tour</h2>
        <p class="ct-note">Các hoạt động dự kiến theo từng ngày trong chuyến đi.</p>

        @* Đủ điểm xuất phát và điểm mọi ngày: xe chạy trên bản đồ. Chưa đủ mà từ 2 ngày: phong cảnh tự vẽ. Còn lại chỉ có danh sách *@
        @if (lichTrinhTour.Count >= 2 || (lichTrinhTour.Count == 1 && lichTrinhTour[0].ViDo.HasValue && Model.ViDoXuatPhat.HasValue))
        {
            @* Hành trình 3D ẩn sẵn, js/hanh-trinh-3d.js chỉ hiện khi trình duyệt chạy được; danh sách bên dưới luôn còn *@
            <div class="ct-ht" id="hanhTrinh3D" data-tour="@Model.Id" hidden>
                <div class="ct-ht-khung" aria-hidden="true"><canvas></canvas></div>
                <div class="ct-ht-the">
                    <div class="ct-ht-ngay" role="group" aria-label="Chọn ngày trong hành trình"></div>
                    <p class="ct-ht-tieu-de"></p>
                    <p class="ct-ht-bua-an" hidden></p>
                    <div class="ct-ht-duoi">
                        <button type="button" class="tv-btn tv-btn-vien" data-ht-bay>Bay cả hành trình</button>
                        <small></small>
                    </div>
                </div>
            </div>
            <script type="application/json" id="hanhTrinhDuLieu">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
            {
                XuatPhat = Model.ViDoXuatPhat.HasValue ? new[] { Model.KinhDoXuatPhat!.Value, Model.ViDoXuatPhat.Value } : null,
                DsNgay = lichTrinhTour.Select(x => new { Ngay = x.NgayThu, x.TieuDe, x.BuaAn, x.ViDo, x.KinhDo, x.DuongDi })
            }))</script>
            <script type="module" src="~/js/hanh-trinh-3d.js" asp-append-version="true"></script>
        }

        @if (duToaDo)
        {
            @* Bản đồ to hơn, xoay nghiêng tự do, chỉ đường từng bước ở trang riêng; Google Maps chỉ là link, không cần khóa *@
            <div class="ct-kham-pha">
                <a asp-controller="DiaDiem" asp-action="KhamPha" asp-route-id="@Model.Id" class="tv-btn tv-btn-chinh">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-compass" /></svg>Khám phá 3D toàn màn hình
                </a>
                <a href="@linkCaHanhTrinh" class="tv-btn tv-btn-vien" target="_blank" rel="noopener">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-route" /></svg>Cả hành trình trên Google Maps
                </a>
            </div>
        }

        @if (lichTrinhTour.Any())
        {
            <div class="ct-days">
                @for (int iNgay = 0; iNgay < lichTrinhTour.Count; iNgay++)
                {
                    var item = lichTrinhTour[iNgay];
                    var linkNgay = LinkNgay(iNgay);
                    <details class="ct-day" data-ngay="@item.NgayThu" @(item.NgayThu == 1 ? "open" : "")>
                        <summary>
                            <span class="ct-day-no">@item.NgayThu</span>
                            <span class="ct-day-title">
                                Ngày @item.NgayThu: @item.TieuDe
                                @if (!string.IsNullOrWhiteSpace(item.BuaAn))
                                {
                                    <small>Bữa ăn: @item.BuaAn</small>
                                }
                            </span>
                        </summary>

                        @if (!string.IsNullOrWhiteSpace(item.NoiDung))
                        {
                            <div class="ct-day-body">@item.NoiDung</div>
                        }
                        @if (linkNgay != null)
                        {
                            <a href="@linkNgay" class="ct-day-google" target="_blank" rel="noopener">
                                <svg class="tv-icon" aria-hidden="true"><use href="#i-route" /></svg>Chỉ đường ngày @item.NgayThu trên Google Maps
                            </a>
                        }
                    </details>
                }
            </div>
        }
        else
        {
            <div class="tv-empty">
                <p>Lịch trình chi tiết của tour này đang được cập nhật.</p>
            </div>
        }

        @if (ViewBag.Videos is List<webdulich.Models.Video> dsVideo && dsVideo.Count > 0)
        {
            <link rel="stylesheet" href="~/css/video.css" asp-append-version="true" />
            <div class="vd-cua-tour">
                <h2>Video về chuyến đi</h2>
                <div class="vd-luoi">
                    @foreach (var video in dsVideo)
                    {
                        <partial name="_TheVideo" model="video" />
                    }
                </div>
            </div>
            <script src="~/js/video-nhe.js" asp-append-version="true"></script>
        }

        @* Đánh giá của khách đã đi (RB-43). Chỉ khách có ghế đã trả của chuyến đã về mới viết được, từ trang Lịch sử. *@
        <div class="dg-tour" id="danhGia">
            <h2>Đánh giá của khách đã đi</h2>
            @if (soDanhGia == 0)
            {
                <p class="dg-tour-rong">Tour này chưa có đánh giá. Khách đã đi xong chuyến có thể viết đánh giá ở trang Lịch sử đặt tour.</p>
            }
            else
            {
                <div class="dg-tong">
                    <div class="dg-tong-diem">
                        <strong>@diemTB.ToString("0.0")</strong>
                        <span class="tv-sao" aria-hidden="true">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <i class="@(s <= Math.Round(diemTB) ? "co" : "")">★</i>
                            }
                        </span>
                        <span>@soDanhGia đánh giá</span>
                    </div>
                    <ul class="dg-tong-thanh" aria-label="Số lượt theo số sao">
                        @for (int s = 5; s >= 1; s--)
                        {
                            int n = demSao.TryGetValue(s, out var x) ? x : 0;
                            <li>
                                <span>@s sao</span>
                                <span class="dg-thanh" aria-hidden="true"><i style="width: @(n * 100 / soDanhGia)%"></i></span>
                                <span>@n</span>
                            </li>
                        }
                    </ul>
                </div>
                <ul class="dg-ds">
                    @foreach (var d in dsDanhGia)
                    {
                        <li>
                            <div class="dg-dau">
                                <span class="dg-ten-chu" aria-hidden="true">@d.TenNguoi.Split(' ').Last()[0]</span>
                                <div>
                                    <strong>@d.TenNguoi</strong>
                                    <span>Đi ngày @d.NgayDi.ToString("dd/MM/yyyy")</span>
                                </div>
                                <span class="tv-sao" aria-label="@d.SoSao trên 5 sao">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <i class="@(s <= d.SoSao ? "co" : "")" aria-hidden="true">★</i>
                                    }
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(d.NoiDung))
                            {
                                <p>@d.NoiDung</p>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    <aside id="departureSection" class="ct-departures">
        <h2>Chọn ngày khởi hành</h2>
        <p class="ct-note">Chọn lịch đi phù hợp trước khi đặt tour.</p>

        @if (lichKhoiHanh != null && lichKhoiHanh.Any())
        {
            <div class="ct-dep-list">
                @foreach (var lich in lichKhoiHanh)
                {
                    var giaNguoiLon = lich.GiaNguoiLon ?? Model.Gia;
                    var giaTreEm = lich.GiaTreEm ?? giaNguoiLon * 0.5m;

                    @* Mỗi lịch là một tấm vé nhỏ: phần trên là ngày giờ và số chỗ, đường xé, phần dưới là giá và nút đặt *@
                    <div class="tv-ve tv-khoi-xe ct-dep">
                        <div class="ct-dep-head">
                            <strong class="tv-ma">@lich.NgayKhoiHanh.ToString("dd/MM/yyyy")</strong>
                            @if (lich.GioKhoiHanh.HasValue)
                            {
                                <span>Giờ đi <span class="tv-ma">@lich.GioKhoiHanh.Value.ToString(@"hh\:mm")</span></span>
                            }
                            <span class="ct-seats@(lich.SoChoCon <= 0 ? " het" : "")">@(lich.SoChoCon > 0 ? "Còn " + lich.SoChoCon + " chỗ" : "Hết chỗ")</span>
                        </div>
                        <div class="tv-ve-duc-lo" aria-hidden="true"></div>

                        <div class="ct-dep-row">
                            <span>Giá người lớn</span>
                            <span class="ct-dep-price">@giaNguoiLon.ToString("N0") VNĐ</span>
                        </div>
                        <div class="ct-dep-row">
                            <span>Giá trẻ em</span>
                            <span class="ct-dep-price">@giaTreEm.ToString("N0") VNĐ</span>
                        </div>

                        <a asp-controller="DatTour"
                           asp-action="DatTour"
                           asp-route-id="@Model.Id"
                           asp-route-lichId="@lich.Id"
                           class="tv-btn tv-btn-chinh ct-dep-btn">Chọn ngày này</a>

                        @if (lich.SoChoCon >= 2)
                        {
                            <a asp-controller="DonNhom"
                               asp-action="TaoDon"
                               asp-route-id="@Model.Id"
                               asp-route-lichId="@lich.Id"
                               class="tv-btn tv-btn-vien ct-dep-btn">Đặt cho nhóm, mỗi người tự trả</a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="tv-empty">
                <p>Tour này chưa có lịch khởi hành. Vui lòng quay lại sau hoặc liên hệ TravelVN để được tư vấn.</p>
            </div>
        }
    </aside>
</div>

<script>
    function changeImage(el) {
        var img = el.tagName === "IMG" ? el : el.querySelector("img");
        if (!img) return;
        document.getElementById("mainImage").src = img.src;
        document.querySelectorAll(".ct-thumb").forEach(function (t) { t.classList.remove("active"); });
        if (el.classList) el.classList.add("active");
    }

    var thumbDau = document.querySelector(".ct-thumb");
    if (thumbDau) thumbDau.classList.add("active");
</script>
