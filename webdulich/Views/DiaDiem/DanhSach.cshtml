@using System.Linq
@model IEnumerable<webdulich.Models.Tour>

@{
    ViewData["Title"] = "Danh sách tour";
    var tours = Model?.ToList() ?? new List<webdulich.Models.Tour>();
    var keyword = ViewBag.Keyword as string ?? "";
    var loaiDiaHinh = ViewBag.LoaiDiaHinh as string ?? "";
    var coLoc = !string.IsNullOrWhiteSpace(keyword) || !string.IsNullOrWhiteSpace(loaiDiaHinh);

    // Các loại địa hình dùng để lọc nhanh
    var locNhanh = new[] { "Biển", "Núi", "Đồng bằng", "Thành phố" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/danh-sach.css" asp-append-version="true" />
}

<section class="ds-head">
    <h1>Danh sách tour du lịch</h1>
    <p>Tìm theo tên tour hoặc địa điểm, hoặc lọc theo loại địa hình.</p>

    <form method="get" asp-controller="DiaDiem" asp-action="DanhSach" class="ds-search">
        <input type="hidden" name="loaiDiaHinh" value="@loaiDiaHinh" />
        <input type="text" name="keyword" value="@keyword" placeholder="Nhập tên tour hoặc địa điểm" aria-label="Tên tour hoặc địa điểm" />
        <button type="submit" class="tv-btn tv-btn-chinh">Tìm tour</button>
    </form>
</section>

<div class="ds-bar">
    <div class="tv-chips">
        <a asp-controller="DiaDiem" asp-action="DanhSach" asp-route-keyword="@keyword"
           class="tv-chip@(string.IsNullOrWhiteSpace(loaiDiaHinh) ? " active" : "")">Tất cả</a>
        @foreach (var loai in locNhanh)
        {
            <a asp-controller="DiaDiem" asp-action="DanhSach" asp-route-keyword="@keyword" asp-route-loaiDiaHinh="@loai"
               class="tv-chip@(loaiDiaHinh == loai ? " active" : "")">@loai</a>
        }
    </div>

    <div class="ds-count" role="status">
        <strong>@tours.Count</strong> tour
        @if (coLoc)
        {
            <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-link">Xóa bộ lọc</a>
        }
    </div>
</div>

@if (tours.Count > 0)
{
    <div class="tv-grid-photo">
        @foreach (var item in tours)
        {
            <partial name="_TheTour" model="item" />
        }
    </div>
}
else
{
    <div class="tv-empty">
        <h3>Không tìm thấy tour phù hợp</h3>
        <p>Hãy thử tên khác, địa điểm khác hoặc bỏ bớt bộ lọc.</p>
        <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-btn tv-btn-vien ds-empty-btn">Xem tất cả tour</a>
    </div>
}
