@model IEnumerable<webdulich.Models.Tour>

<h2 style="text-align:center; margin-top:20px;">🌴 Danh sách tour du lịch</h2>

<style>
    .search-box {
        width: 90%;
        margin: 20px auto 10px auto;
        display: flex;
        gap: 10px;
        justify-content: center;
    }

        .search-box input {
            width: 400px;
            padding: 10px 14px;
            border: 1px solid #ccc;
            border-radius: 8px;
            outline: none;
        }

        .search-box button,
        .search-box a {
            padding: 10px 16px;
            border-radius: 8px;
            border: none;
            text-decoration: none;
            font-weight: 500;
        }

    .btn-search {
        background: #0d6efd;
        color: white;
    }

    .btn-reset {
        background: #6c757d;
        color: white;
    }

    .container-dd {
        width: 90%;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        margin-top: 30px;
    }

    .card-dd {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        overflow: hidden;
        text-align: center;
        transition: 0.3s;
    }

        .card-dd:hover {
            transform: translateY(-5px);
        }

        .card-dd img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

    .card-body {
        padding: 15px;
    }

    .btn-xem {
        background: #f4b400;
        border: none;
        padding: 8px 15px;
        border-radius: 6px;
        text-decoration: none;
        color: black;
        font-weight: 500;
        display: inline-block;
        margin-top: 8px;
    }

        .btn-xem:hover {
            background: orange;
        }

    .empty-box {
        width: 90%;
        margin: 30px auto;
        background: white;
        padding: 30px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        color: #666;
    }
</style>

<form method="get" asp-controller="DiaDiem" asp-action="DanhSach" class="search-box">
    <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm theo tên tour hoặc địa điểm..." />
    <button type="submit" class="btn-search">Tìm kiếm</button>
    <a asp-controller="DiaDiem" asp-action="DanhSach" class="btn-reset">Làm mới</a>
</form>

@if (Model != null && Model.Any())
{
    <div class="container-dd">
        @foreach (var item in Model)
        {
            <div class="card-dd">
                <img src="~/images/dulich/@item.HinhAnh" alt="@item.TenTour" />

                <div class="card-body">
                    <h4>@item.TenTour</h4>
                    <p><strong>Địa điểm:</strong> @item.DiaDiem</p>
                    <p><strong>Giá:</strong> @item.Gia VNĐ</p>

                    <a asp-controller="DiaDiem"
                       asp-action="ChiTiet"
                       asp-route-id="@item.Id"
                       class="btn-xem">
                        Chi tiết
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-box">
        <h4>Không tìm thấy tour phù hợp</h4>
        <p>Hãy thử tìm bằng tên khác hoặc địa điểm khác.</p>
    </div>
}