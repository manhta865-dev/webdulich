@model List<webdulich.Models.Tour>

@{
    ViewData["Title"] = "Quản lý lịch đi";
    var soLichTheoTour = ViewBag.SoLichTheoTour as Dictionary<int, int> ?? new Dictionary<int, int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Quản lý lịch đi</h1>
            <p>Chọn tour để thêm, xem hoặc xóa lịch khởi hành.</p>
        </div>
    </div>

    <div class="ad-toolbar">
        <form asp-controller="Admin" asp-action="QuanLyLichKhoiHanh" method="get" class="ad-search">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   aria-label="Tìm tour"
                   placeholder="Tìm tour hoặc địa điểm..." />

            <button class="tv-btn tv-btn-chinh" type="submit">Tìm kiếm</button>

            <a asp-controller="Admin" asp-action="QuanLyLichKhoiHanh" class="tv-btn tv-btn-vien">Làm mới</a>
        </form>
    </div>

    <div class="ad-table-card">
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Tên tour</th>
                        <th>Địa điểm</th>
                        <th>Phương tiện</th>
                        <th>Số lịch đi</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        int soLich = soLichTheoTour.ContainsKey(item.Id) ? soLichTheoTour[item.Id] : 0;

                        <tr>
                            <td><strong>@item.TenTour</strong></td>
                            <td>@item.TenDiaDiemHienThi</td>
                            <td>@item.PhuongTienHienThi</td>
                            <td>
                                <span class="ad-badge@(soLich == 0 ? " canh-bao" : "")">@soLich lịch</span>
                            </td>
                            <td>
                                <a asp-controller="Admin"
                                   asp-action="LichKhoiHanh"
                                   asp-route-id="@item.Id"
                                   class="tv-btn tv-btn-vien ad-btn-nho">Quản lý lịch đi</a>
                            </td>
                        </tr>
                    }

                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="ad-empty-cell">Chưa có tour nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>