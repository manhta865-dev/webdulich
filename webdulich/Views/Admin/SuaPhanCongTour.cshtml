@model webdulich.Models.PhanCongTour
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Sửa phân công tour";

    var lichList = ViewBag.LichKhoiHanhList as List<SelectListItem> ?? new List<SelectListItem>();
    var hdvList = ViewBag.HuongDanVienList as List<SelectListItem> ?? new List<SelectListItem>();
    var taiXeList = ViewBag.TaiXeList as List<SelectListItem> ?? new List<SelectListItem>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page ad-form-page">
    <div class="ad-pagehead">
        <div>
            <h1>Sửa phân công tour</h1>
            <p>Cập nhật lịch khởi hành, hướng dẫn viên, tài xế và ghi chú phân công.</p>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="SuaPhanCongTour" method="post" class="ad-form-block ad-form">
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="LichKhoiHanhTourId" class="form-label">Lịch khởi hành</label>
                <select asp-for="LichKhoiHanhTourId"
                        class="form-select"
                        asp-items="lichList">
                    <option value="">-- Chọn lịch --</option>
                </select>
                <span asp-validation-for="LichKhoiHanhTourId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="HuongDanVienId" class="form-label">Hướng dẫn viên</label>
                <select asp-for="HuongDanVienId"
                        class="form-select"
                        asp-items="hdvList">
                    <option value="">-- Chọn hướng dẫn viên --</option>
                </select>
                <span asp-validation-for="HuongDanVienId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="TaiXeId" class="form-label">Tài xế</label>

                <select asp-for="TaiXeId"
                        class="form-select">
                    <option value="">-- Không cần tài xế --</option>

                    @foreach (var tx in taiXeList)
                    {
                        if (!string.IsNullOrWhiteSpace(tx.Value))
                        {
                            if (Model.TaiXeId.HasValue && Model.TaiXeId.Value.ToString() == tx.Value)
                            {
                                <option value="@tx.Value" selected>@tx.Text</option>
                            }
                            else
                            {
                                <option value="@tx.Value">@tx.Text</option>
                            }
                        }
                    }
                </select>

                <span asp-validation-for="TaiXeId" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                <input asp-for="GhiChu"
                       class="form-control"
                       placeholder="Ví dụ: tour nước ngoài không cần tài xế..." />
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
        </div>

        <div class="ad-form-actions ad-form-actions-trai">
            <button type="submit" class="tv-btn tv-btn-chinh">Cập nhật phân công</button>

            <a asp-controller="Admin"
               asp-action="PhanCongTour"
               class="tv-btn tv-btn-vien">
                Quay lại
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}