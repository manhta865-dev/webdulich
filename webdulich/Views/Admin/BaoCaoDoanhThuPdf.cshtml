@model List<webdulich.Models.DatTours>

@{
    Layout = null;
    decimal tongDoanhThu = ViewBag.TongDoanhThu ?? 0;
    int soDon = ViewBag.SoDonDaThanhToan ?? 0;
    int thang = ViewBag.ThangChon ?? DateTime.Today.Month;
    int nam = ViewBag.NamChon ?? DateTime.Today.Year;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Báo cáo doanh thu tháng @thang/@nam | TravelVN</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bao-cao-in.css" asp-append-version="true" />
</head>

<body>
    <div class="print-actions">
        <button class="btn-print" onclick="window.print()">In / Lưu PDF</button>
    </div>

    <div class="report-page">
        <div class="report-head">
            <div>
                <div class="brand">TravelVN</div>
                <h1>Báo cáo doanh thu</h1>
                <p>Tháng @thang / @nam - Chỉ tính các đơn đã thanh toán</p>
            </div>

            <div class="report-date">
                Ngày xuất
                <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong>
            </div>
        </div>

        <div class="summary-grid">
            <div class="summary-card tien">
                <span>Tổng doanh thu</span>
                <strong>@tongDoanhThu.ToString("N0") VNĐ</strong>
            </div>

            <div class="summary-card">
                <span>Số đơn</span>
                <strong>@soDon đơn</strong>
            </div>

            <div class="summary-card">
                <span>Tháng báo cáo</span>
                <strong>@thang/@nam</strong>
            </div>
        </div>

        <h2 class="section-title">Chi tiết doanh thu</h2>

        <table>
            <thead>
                <tr>
                    <th class="col-giua">STT</th>
                    <th>Khách hàng</th>
                    <th>Tour</th>
                    <th>Ngày đi</th>
                    <th>Giờ đi</th>
                    <th>Phương tiện</th>
                    <th>Phương thức</th>
                    <th>Trạng thái</th>
                    <th class="money">Doanh thu</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    int stt = 1;

                    foreach (var item in Model)
                    {
                        var gioDi = item.LichKhoiHanhTour?.GioKhoiHanh.HasValue == true
                        ? item.LichKhoiHanhTour.GioKhoiHanh.Value.ToString(@"hh\:mm")
                        : "Chưa cập nhật";

                        <tr>
                            <td class="col-giua">@stt</td>
                            <td>@item.TenKhach</td>
                            <td>@item.Tour?.TenTour</td>
                            <td>@item.NgayDi.ToString("dd/MM/yyyy")</td>
                            <td>@gioDi</td>
                            <td>@(item.Tour?.PhuongTienHienThi ?? "Chưa cập nhật")</td>
                            <td>@item.PhuongThucThanhToan</td>
                            <td><span class="paid-badge">@item.TrangThaiThanhToan</span></td>
                            <td class="money">@item.TongTien.ToString("N0") VNĐ</td>
                        </tr>

                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="empty-cell">
                            Không có dữ liệu doanh thu trong tháng này.
                        </td>
                    </tr>
                }
            </tbody>

            @if (Model != null && Model.Count > 0)
            {
                <tfoot>
                    <tr>
                        <td colspan="8">Tổng cộng (@soDon đơn)</td>
                        <td class="money">@tongDoanhThu.ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            }
        </table>

        <div class="footer-note">
            <div>Người lập báo cáo: Quản trị viên TravelVN</div>
            <div>Hệ thống website đặt tour du lịch TravelVN</div>
        </div>
    </div>

    <script>
        window.onload = function () {
            setTimeout(function () {
                window.print();
            }, 500);
        };
    </script>
</body>
</html>