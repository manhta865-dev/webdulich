@model List<webdulich.Models.TinNhanCuocTroChuyenViewModel>

@{
    ViewData["Title"] = "Tin nhắn";
    string search = ViewBag.Search as string ?? "";
    int tongCuocTroChuyen = ViewBag.TongCuocTroChuyen ?? 0;
    int chuaDoc = ViewBag.ChuaDoc ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Tin nhắn khách hàng</h1>
            <p>Theo dõi và phản hồi cuộc trò chuyện giữa khách hàng với admin TravelVN.</p>
        </div>
    </div>

    <div class="ad-kpis">
        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-chat" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Tổng cuộc trò chuyện</span>
                <strong>@tongCuocTroChuyen</strong>
            </span>
        </div>

        <div class="ad-kpi@(chuaDoc > 0 ? " ad-kpi-canh-bao" : "")">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-mail" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Tin chưa đọc</span>
                <strong>@chuaDoc</strong>
            </span>
        </div>
    </div>

    <div class="ad-toolbar">
        <form method="get" asp-controller="Admin" asp-action="TinNhan" class="ad-search">
            <input type="text" name="search" value="@search" class="form-control" aria-label="Tìm tin nhắn" placeholder="Tìm khách hàng, email hoặc nội dung..." />

            <button type="submit" class="tv-btn tv-btn-chinh">Tìm kiếm</button>

            <a asp-controller="Admin" asp-action="TinNhan" class="tv-btn tv-btn-vien">Làm mới</a>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="ad-conv-list">
            @foreach (var item in Model)
            {
                <a asp-controller="Admin"
                   asp-action="ChiTietTinNhan"
                   asp-route-taiKhoanId="@item.TaiKhoanId"
                   class="ad-conv">

                    <div class="ad-conv-avatar">
                        @(string.IsNullOrWhiteSpace(item.HoTen) ? "U" : item.HoTen.Trim().Substring(0, 1).ToUpper())
                    </div>

                    <div>
                        <div class="ad-conv-name">@item.HoTen</div>
                        <div class="ad-conv-email">@item.Email</div>
                        <div class="ad-conv-last">
                            @(item.NguoiGuiCuoi == "admin" ? "Admin: " : "Khách: ")
                            @item.TinNhanCuoi
                        </div>
                    </div>

                    <div class="ad-conv-meta">
                        <div>@item.NgayGuiCuoi.ToString("dd/MM/yyyy HH:mm")</div>

                        @if (item.ChuaDoc > 0)
                        {
                            <span class="ad-unread">@item.ChuaDoc tin mới</span>
                        }
                        else
                        {
                            <span>Đã xem</span>
                        }
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="tv-empty">
            <p>Chưa có cuộc trò chuyện nào từ người dùng.</p>
        </div>
    }

    <script>
        setInterval(function () {
            location.reload();
        }, 8000);
    </script>
</div>