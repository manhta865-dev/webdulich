@model List<webdulich.Models.TinNhanLienHe>

@{
    ViewData["Title"] = "Chi tiết tin nhắn";

    int taiKhoanId = ViewBag.TaiKhoanId ?? 0;
    string khachHang = ViewBag.KhachHang as string ?? "Khách hàng";
    string email = ViewBag.Email as string ?? "";
}

<style>
    body {
        background: #f4f7fb !important;
    }

    .chat-detail-page {
        max-width: 1050px;
        margin: 34px auto 70px;
        padding: 0 14px;
    }

    .chat-shell {
        background: rgba(255,253,248,0.98);
        border: 1px solid rgba(201,168,76,0.28);
        border-radius: 24px;
        box-shadow: 0 22px 54px rgba(13,27,62,0.14);
        overflow: hidden;
    }

    .chat-detail-header {
        padding: 26px 30px;
        background: linear-gradient(135deg, #0d1b3e, #122455);
        border-bottom: 3px solid #c9a84c;
        color: #f8fafc;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
    }

        .chat-detail-header h2 {
            margin: 0;
            color: #f5e6b8;
            font-family: 'Playfair Display', serif;
            font-weight: 900;
        }

        .chat-detail-header p {
            margin: 6px 0 0;
            color: rgba(245,230,184,0.78);
            font-weight: 650;
        }

    .btn-back-chat {
        background: #fffdf8;
        color: #0d1b3e;
        border-radius: 12px;
        padding: 11px 18px;
        text-decoration: none;
        font-weight: 950;
    }

    .chat-messages {
        padding: 26px;
        min-height: 430px;
        max-height: 560px;
        overflow-y: auto;
        background: linear-gradient(180deg, #f8fbff, #fffdf8);
    }

    .message-row {
        display: flex;
        margin-bottom: 16px;
    }

        .message-row.admin {
            justify-content: flex-end;
        }

        .message-row.user {
            justify-content: flex-start;
        }

    .message-bubble {
        max-width: 72%;
        padding: 13px 15px;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(13,27,62,0.08);
        white-space: pre-line;
        line-height: 1.55;
        font-weight: 650;
    }

    .message-row.user .message-bubble {
        background: #ffffff;
        border: 1px solid #dbeafe;
        color: #0f172a;
        border-bottom-left-radius: 6px;
    }

    .message-row.admin .message-bubble {
        background: linear-gradient(135deg, #0d1b3e, #1d4ed8);
        color: #ffffff;
        border-bottom-right-radius: 6px;
    }

    .message-meta {
        margin-top: 7px;
        font-size: 0.78rem;
        opacity: 0.75;
        font-weight: 800;
    }

    .chat-reply {
        padding: 22px 26px 26px;
        border-top: 1px solid rgba(201,168,76,0.22);
        background: #fffdf8;
    }

        .chat-reply textarea {
            width: 100%;
            min-height: 105px;
            border-radius: 14px;
            border: 1px solid #d8c99d;
            background: #fff;
            padding: 14px;
            font-weight: 650;
            color: #0d1b3e;
            outline: none;
            resize: vertical;
        }

            .chat-reply textarea:focus {
                border-color: #c9a84c;
                box-shadow: 0 0 0 0.2rem rgba(201,168,76,0.18);
            }

    .reply-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 14px;
        flex-wrap: wrap;
    }

    .btn-reply {
        border: none;
        border-radius: 12px;
        padding: 12px 22px;
        background: linear-gradient(135deg, #c9a84c, #e8c96d);
        color: #0a0f1e;
        font-weight: 950;
    }

    .btn-delete-chat {
        border-radius: 12px;
        padding: 12px 22px;
        background: #c81e1e;
        color: #fff;
        text-decoration: none;
        font-weight: 950;
    }

    .empty-detail {
        background: #fff;
        border: 1px dashed #d8c99d;
        border-radius: 18px;
        padding: 30px;
        text-align: center;
        color: #64748b;
        font-weight: 800;
    }

    @@media (max-width: 768px) {
        .message-bubble {
            max-width: 90%;
        }
    }
</style>

<div class="chat-detail-page">
    <div class="chat-shell">
        <div class="chat-detail-header">
            <div>
                <h2>💬 Trò chuyện với @khachHang</h2>
                <p>@(string.IsNullOrWhiteSpace(email) ? "Chưa có email" : email)</p>
            </div>

            <a asp-controller="Admin" asp-action="TinNhan" class="btn-back-chat">
                ← Quay lại
            </a>
        </div>

        <div class="chat-messages" id="adminChatMessages">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var laAdmin = item.NguoiGui == "admin";

                    <div class="message-row @(laAdmin ? "admin" : "user")">
                        <div class="message-bubble">
                            @item.NoiDung

                            <div class="message-meta">
                                @(laAdmin ? "Admin" : item.HoTen) · @item.NgayGui.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-detail">
                    Chưa có tin nhắn nào.
                </div>
            }
        </div>

        <div class="chat-reply">
            <form id="adminReplyForm">
                @Html.AntiForgeryToken()

                <input type="hidden" name="taiKhoanId" value="@taiKhoanId" />

                <textarea name="noiDung"
                          id="adminReplyInput"
                          required
                          placeholder="Nhập phản hồi cho khách hàng..."></textarea>

                <div class="reply-actions">
                    <a asp-controller="Admin"
                       asp-action="XoaCuocTroChuyen"
                       asp-route-taiKhoanId="@taiKhoanId"
                       class="btn-delete-chat"
                       onclick="return confirm('Bạn có chắc muốn xóa toàn bộ cuộc trò chuyện này không?');">
                        🗑 Xóa cuộc trò chuyện
                    </a>

                    <button type="submit" class="btn-reply">
                        Gửi phản hồi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const taiKhoanId = @taiKhoanId;

    function scrollAdminChatToBottom() {
        const box = document.getElementById("adminChatMessages");
        if (box) {
            box.scrollTop = box.scrollHeight;
        }
    }

    function renderAdminMessages(messages) {
        const box = document.getElementById("adminChatMessages");
        if (!box) return;

        box.innerHTML = "";

        if (!messages || messages.length === 0) {
            box.innerHTML = `
                <div class="empty-detail">
                    Chưa có tin nhắn nào.
                </div>`;
            return;
        }

        messages.forEach(function (item) {
            const laAdmin = item.nguoiGui === "admin";

            const row = document.createElement("div");
            row.className = "message-row " + (laAdmin ? "admin" : "user");

            const bubble = document.createElement("div");
            bubble.className = "message-bubble";
            bubble.textContent = item.noiDung;

            const meta = document.createElement("div");
            meta.className = "message-meta";
            meta.textContent = (laAdmin ? "Admin" : item.hoTen) + " · " + item.thoiGian;

            bubble.appendChild(meta);
            row.appendChild(bubble);
            box.appendChild(row);
        });

        scrollAdminChatToBottom();
    }

    function loadAdminMessages() {
        fetch('@Url.Action("LayChiTietTinNhan", "Admin")?taiKhoanId=' + taiKhoanId)
            .then(res => res.json())
            .then(data => renderAdminMessages(data))
            .catch(() => {});
    }

    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("adminReplyForm");
        const input = document.getElementById("adminReplyInput");

        if (form && input) {
            form.addEventListener("submit", function (e) {
                e.preventDefault();

                const noiDung = input.value.trim();
                if (!noiDung) return;

                const formData = new FormData();
                formData.append("taiKhoanId", taiKhoanId);
                formData.append("noiDung", noiDung);
                formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "");

                fetch('@Url.Action("TraLoiTinNhanAjax", "Admin")', {
                    method: "POST",
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        input.value = "";
                        loadAdminMessages();
                    }
                });
            });
        }

        loadAdminMessages();
        setInterval(loadAdminMessages, 2000);
    });
</script>