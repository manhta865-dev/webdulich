@model List<webdulich.Models.TaiKhoan>

@* Quản lý tài khoản dạng thẻ: lọc theo vai trò, tìm theo tên, email, số điện thoại. Bấm thẻ để xem chi tiết. *@
@{
    ViewData["Title"] = "Quản lý tài khoản";

    var demVaiTro = ViewBag.DemVaiTro as Dictionary<string, int> ?? new Dictionary<string, int>();
    var soDon = ViewBag.SoDon as Dictionary<int, int> ?? new Dictionary<int, int>();
    string? vaiTroLoc = ViewBag.VaiTro;
    int Dem(string v) => demVaiTro.TryGetValue(v, out var n) ? n : 0;
    var tongTaiKhoan = demVaiTro.Values.Sum();
    var tongAdmin = Dem("admin");
    var tongUser = Dem("user");
    var tongNhanSu = Dem("huongdanvien") + Dem("taixe");
    int? toiId = Context.Session.GetInt32("taiKhoanId");
    var dsLoc = new[] { ("", "Tất cả"), ("user", "Khách hàng"), ("huongdanvien", "Hướng dẫn viên"), ("taixe", "Tài xế"), ("admin", "Quản trị viên") };
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Quản lý tài khoản</h1>
            <p>Danh sách tài khoản người dùng và quản trị viên trong hệ thống TravelVN.</p>
        </div>
    </div>

    <div class="ad-kpis">
        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-user" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Tổng tài khoản</span>
                <strong>@tongTaiKhoan</strong>
            </span>
        </div>

        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-grid" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Quản trị viên</span>
                <strong>@tongAdmin</strong>
            </span>
        </div>

        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-users" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Người dùng</span>
                <strong>@tongUser</strong>
            </span>
        </div>

        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-truck" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Nhân sự</span>
                <strong>@tongNhanSu</strong>
            </span>
        </div>
    </div>

    <div class="ad-toolbar">
        <form asp-controller="Admin" asp-action="TaiKhoan" method="get" class="ad-search">
            <input type="hidden" name="vaiTro" value="@vaiTroLoc" />
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   aria-label="Tìm tài khoản"
                   placeholder="Tìm theo họ tên, email/sđt, vai trò..." />

            <button class="tv-btn tv-btn-chinh" type="submit">Tìm kiếm</button>

            <a asp-controller="Admin" asp-action="TaiKhoan" class="tv-btn tv-btn-vien">Làm mới</a>
        </form>
    </div>

    <div class="tv-chips tk-loc" role="group" aria-label="Lọc theo vai trò">
        @foreach (var (gt, ten) in dsLoc)
        {
            <a asp-action="TaiKhoan" asp-route-vaiTro="@(gt == "" ? null : gt)" asp-route-search="@ViewBag.Search"
               class="tv-chip@((vaiTroLoc ?? "") == gt ? " active" : "")">@ten</a>
        }
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="tk-luoi">
            @foreach (var item in Model)
            {
                int n = soDon.TryGetValue(item.Id, out var x) ? x : 0;
                bool laToi = toiId == item.Id;
                <article class="tk-the">
                    <a asp-action="ChiTietTaiKhoan" asp-route-id="@item.Id" class="tk-the-chinh" aria-label="Xem chi tiết tài khoản @item.HoTen">
                        <span class="tk-the-anh">
                            @if (!string.IsNullOrEmpty(item.AnhDaiDien))
                            {
                                <img src="~/images/avatar/@item.AnhDaiDien" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span aria-hidden="true">@((item.HoTen ?? "?").Trim().Split(' ').Last().FirstOrDefault())</span>
                            }
                        </span>
                        <span class="tk-the-chu">
                            <span class="ad-role @webdulich.Models.VaiTroHienThi.Lop(item.VaiTro)">@webdulich.Models.VaiTroHienThi.Ten(item.VaiTro)</span>
                            <strong>@item.HoTen@(laToi ? " (bạn)" : "")</strong>
                            <span>
                                <svg class="tv-icon" aria-hidden="true"><use href="#i-mail" /></svg>
                                @(string.IsNullOrEmpty(item.Email) ? "Chưa có email" : item.Email)
                            </span>
                            <span>
                                <svg class="tv-icon" aria-hidden="true"><use href="#i-phone" /></svg>
                                @(string.IsNullOrEmpty(item.SoDienThoai) ? "Chưa có số điện thoại" : item.SoDienThoai)
                            </span>
                        </span>
                    </a>
                    <div class="tk-the-chan">
                        <span>
                            <strong>@n</strong> đơn
                            · tham gia @(item.NgayTao == DateTime.MinValue ? "chưa rõ" : item.NgayTao.ToString("dd/MM/yyyy"))
                        </span>
                        <div class="tk-the-nut">
                            <a asp-action="ChiTietTaiKhoan" asp-route-id="@item.Id" class="tv-btn tv-btn-vien ad-btn-nho">Chi tiết</a>
                            @if (!laToi)
                            {
                                <button type="button" class="tv-btn tv-btn-huy ad-btn-nho btn-xoa" data-id="@item.Id"
                                        aria-label="Xóa tài khoản @item.HoTen">Xóa</button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="tv-empty"><p>Không có tài khoản nào khớp bộ lọc.</p></div>
    }
</div>

<div class="modal fade" id="modalXoa" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title fw-bold">
                    Xác nhận xóa tài khoản
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng">
                </button>
            </div>

            <form asp-controller="Admin"
                  asp-action="XoaTaiKhoan"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="taiKhoanCanXoaId"
                       name="id" />

                <div class="modal-body modal-body-custom text-center">
                    <p class="fs-5 mb-2 fw-bold">
                        Bạn có chắc chắn muốn xóa tài khoản này?
                    </p>

                    <small class="text-muted">
                        Hành động này không thể hoàn tác.
                    </small>
                </div>

                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button"
                            class="btn-modal-cancel"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit" class="btn-modal-delete">
                        Xóa tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalElement = document.getElementById("modalXoa");
            const modalXoa = new bootstrap.Modal(modalElement);
            const taiKhoanCanXoaId =
                document.getElementById("taiKhoanCanXoaId");

            document.querySelectorAll(".btn-xoa").forEach(function (button) {
                button.addEventListener("click", function () {
                    taiKhoanCanXoaId.value =
                        this.getAttribute("data-id");

                    modalXoa.show();
                });
            });
        });
    </script>
}
