@model List<webdulich.Models.Tour>

@{
    ViewData["Title"] = "Quản lý Tour";
    string loaiTourHienTai = ViewBag.LoaiTour as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Quản lý tour</h1>
            <p>Quản lý danh sách tour, giá, hình ảnh và đơn khách đặt tour.</p>
        </div>

        <a asp-controller="Admin" asp-action="Create" class="tv-btn tv-btn-chinh">Thêm tour</a>
    </div>

    <div class="ad-toolbar">
        <form asp-controller="Admin" asp-action="Index" method="get" class="ad-search">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   aria-label="Tìm tour"
                   placeholder="Tìm theo tên tour, địa điểm, địa hình, phong cách..." />

            <input type="hidden" name="loaiTour" value="@ViewBag.LoaiTour" />

            <button class="tv-btn tv-btn-chinh" type="submit">Tìm kiếm</button>

            <a asp-controller="Admin" asp-action="Index" class="tv-btn tv-btn-vien">Làm mới</a>
        </form>

        <div class="ad-toolbar-row">
            <div class="tv-chips">
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="tv-chip @(string.IsNullOrEmpty(loaiTourHienTai) ? "active" : "")">Tất cả</a>

                <a asp-controller="Admin"
                   asp-action="Index"
                   asp-route-search="@ViewBag.Search"
                   asp-route-loaiTour="Trong nước"
                   class="tv-chip @(loaiTourHienTai == "Trong nước" ? "active" : "")">Tour trong nước</a>

                <a asp-controller="Admin"
                   asp-action="Index"
                   asp-route-search="@ViewBag.Search"
                   asp-route-loaiTour="Ngoài nước"
                   class="tv-chip @(loaiTourHienTai == "Ngoài nước" ? "active" : "")">Tour ngoài nước</a>
            </div>

            <div class="ad-count"><strong>@(Model != null ? Model.Count : 0)</strong> tour</div>
        </div>
    </div>

    <div class="ad-table-card">
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Tour</th>
                        <th>Địa điểm</th>
                        <th>Địa hình</th>
                        <th>Phong cách</th>
                        <th>Số ngày</th>
                        <th>Phương tiện</th>
                        <th>Giá</th>
                        <th>Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="ad-tour-cell">
                                        <img src="~/images/dulich/@item.HinhAnh" class="ad-thumb" alt="" loading="lazy" />
                                        <div>
                                            <strong>@item.TenTour</strong>
                                            @if (item.LoaiTour == "Ngoài nước")
                                            {
                                                <span class="ad-tag ngoai">Ngoài nước</span>
                                            }
                                            else
                                            {
                                                <span class="ad-tag trong">Trong nước</span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>@item.TenDiaDiemHienThi</td>
                                <td>@item.LoaiDiaHinhHienThi</td>
                                <td>@item.PhongCachHienThi</td>
                                <td>@(item.SoNgay.HasValue ? item.SoNgay + " ngày" : "Chưa cập nhật")</td>
                                <td>@item.PhuongTienHienThi</td>
                                <td class="ad-price">@item.Gia.ToString("N0") VNĐ</td>

                                <td>
                                    <div class="ad-row-actions">
                                        <a asp-controller="Admin" asp-action="DonDatTourTheoTour" asp-route-id="@item.Id" class="tv-btn tv-btn-vien ad-btn-nho">Khách đặt</a>

                                        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.Id" class="tv-btn tv-btn-vien ad-btn-nho">Sửa</a>

                                        <a asp-controller="Admin" asp-action="Delete" asp-route-id="@item.Id"
                                           class="tv-btn tv-btn-huy ad-btn-nho"
                                           onclick="return confirm('Bạn chắc chắn muốn xóa?')">Xóa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="ad-empty-cell">Chưa có tour nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>