@model List<webdulich.Models.LichKhoiHanhTour>

@{
    ViewData["Title"] = "Lịch khởi hành";
    var tour = ViewBag.Tour as webdulich.Models.Tour;
    decimal giaMacDinh = tour?.Gia ?? 0;
    decimal giaTreEmMacDinh = giaMacDinh * 0.5m;
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Lịch khởi hành</h1>
            <p>@tour?.TenTour</p>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="ad-alert ok" role="status">@TempData["success"]</div>
    }

    @if (TempData["error"] != null)
    {
        <div class="ad-alert loi" role="alert">@TempData["error"]</div>
    }

    @{
        string activeTab = ViewBag.TrangThai as string ?? "SapKhoiHanh";
    }

    <div class="tv-chips ad-tabs">
        <a asp-controller="Admin"
           asp-action="LichKhoiHanh"
           asp-route-id="@tour?.Id"
           asp-route-trangThai="SapKhoiHanh"
           class="tv-chip @(activeTab == "SapKhoiHanh" ? "active" : "")">
            Sắp khởi hành (@ViewBag.CountSapKhoiHanh)
        </a>
        <a asp-controller="Admin"
           asp-action="LichKhoiHanh"
           asp-route-id="@tour?.Id"
           asp-route-trangThai="DangDienRa"
           class="tv-chip @(activeTab == "DangDienRa" ? "active" : "")">
            Đang diễn ra (@ViewBag.CountDangDienRa)
        </a>
        <a asp-controller="Admin"
           asp-action="LichKhoiHanh"
           asp-route-id="@tour?.Id"
           asp-route-trangThai="DaHoanThanh"
           class="tv-chip @(activeTab == "DaHoanThanh" ? "active" : "")">
            Đã hoàn thành (@ViewBag.CountDaHoanThanh)
        </a>
        <a asp-controller="Admin"
           asp-action="LichKhoiHanh"
           asp-route-id="@tour?.Id"
           asp-route-trangThai="DaHuy"
           class="tv-chip @(activeTab == "DaHuy" ? "active" : "")">
            Đã hủy (@ViewBag.CountDaHuy)
        </a>
        <a asp-controller="Admin"
           asp-action="LichKhoiHanh"
           asp-route-id="@tour?.Id"
           asp-route-trangThai="TatCa"
           class="tv-chip @(activeTab == "TatCa" ? "active" : "")">
            Tất cả (@ViewBag.CountTatCa)
        </a>
    </div>

    <section class="ad-form-block">
        <h2>Thêm ngày khởi hành</h2>

        <form asp-controller="Admin" asp-action="ThemLichKhoiHanh" method="post" class="ad-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="tourId" value="@tour?.Id" />

            <div class="ad-inline-grid">
                <div>
                    <label class="form-label">Ngày khởi hành</label>
                    <input type="date" name="ngayKhoiHanh" class="form-control" required />
                </div>

                <div>
                    <label class="form-label">Giờ khởi hành</label>
                    <input type="time" name="gioKhoiHanh" class="form-control" />
                </div>

                <div>
                    <label class="form-label">Số chỗ tối đa</label>
                    <input type="number" name="soChoToiDa" class="form-control" min="1" required />
                </div>

                <div>
                    <label class="form-label">Giá người lớn</label>
                    <input type="number" name="giaNguoiLon" class="form-control price-input" min="0" step="1000" value="@giaMacDinh.ToString("0")" required />
                </div>

                <div>
                    <label class="form-label">Giá trẻ em</label>
                    <input type="number" name="giaTreEm" class="form-control price-input" min="0" step="1000" value="@giaTreEmMacDinh.ToString("0")" required />
                </div>

                <div class="full ad-form-actions-trai">
                    <button type="submit" class="tv-btn tv-btn-chinh">Thêm lịch</button>

                    <a asp-controller="Admin"
                       asp-action="QuanLyLichKhoiHanh"
                       class="tv-btn tv-btn-vien">Quay lại</a>
                </div>
            </div>
        </form>

        <p class="ad-hint">
            Mỗi lịch khởi hành có thể đặt giá riêng. Số chỗ còn lại do hệ thống tự tính từ số chỗ tối đa trừ số khách đã đặt.
            Trạng thái tự tính theo ngày thật: sắp khởi hành, đang diễn ra, đã hoàn thành.
            Tạm ngưng bán và hủy lịch là do admin bấm.
            Xe hoặc máy bay được gán tự động theo số chỗ tối đa: xe du lịch đến 16 chỗ dùng xe 16 chỗ,
            đến 29 chỗ dùng xe 29 chỗ, đến 45 chỗ dùng xe 45 chỗ.
        </p>
    </section>

    <div class="ad-table-card ad-khoang-tren">
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Ngày khởi hành</th>
                        <th>Giờ</th>
                        <th>Số chỗ tối đa</th>
                        <th>Giá người lớn</th>
                        <th>Giá trẻ em</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var giaNguoiLon = item.GiaNguoiLon ?? giaMacDinh;
                            var giaTreEm = item.GiaTreEm ?? giaNguoiLon * 0.5m;
                            var formId = $"update-lich-{item.Id}";
                            var trangThai = item.TrangThaiHienThi;

                            var badgeClass = trangThai switch
                            {
                                "Sắp khởi hành" => "status-upcoming",
                                "Đang diễn ra" => "status-running",
                                "Đã hoàn thành" => "status-done",
                                "Đã hủy" => "status-cancelled",
                                _ => "status-upcoming"
                            };

                            var choPhepSua = trangThai == "Sắp khởi hành";
                            var choPhepHuy = trangThai == "Sắp khởi hành";
                            // Lịch đã có khách giữ chỗ: khóa ô ngày (readonly để form vẫn gửi ngày cũ); giờ, giá, số chỗ vẫn sửa được
                            var khoaNgay = item.SoChoToiDa - item.SoChoCon > 0;
                            var nhanTrangThai = choPhepSua && item.DangTamNgung ? "Tạm ngưng bán" : trangThai;
                            if (choPhepSua && item.DangTamNgung)
                            {
                                badgeClass = "status-paused";
                            }

                            <tr class="@(trangThai == "Đã hủy" ? "schedule-cancelled" : "")">
                                <td>
                                    <form id="@formId"
                                          asp-controller="Admin"
                                          asp-action="CapNhatLichKhoiHanh"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                    </form>

                                    <input form="@formId"
                                           type="date"
                                           name="ngayKhoiHanh"
                                           class="form-control"
                                           value="@item.NgayKhoiHanh.ToString("yyyy-MM-dd")"
                                           disabled="@(!choPhepSua)"
                                           readonly="@(choPhepSua && khoaNgay)"
                                           title="@(choPhepSua && khoaNgay ? "Lịch đã có khách nên không đổi ngày được. Muốn dời ngày, hủy lịch này và tạo lịch mới." : null)"
                                           required />
                                    @if (choPhepSua && khoaNgay)
                                    {
                                        <small class="ad-hint-nho xuong-dong">Đã có khách, không đổi ngày. Muốn dời: hủy lịch, tạo lịch mới.</small>
                                    }
                                </td>

                                <td>
                                    <input form="@formId"
                                           type="time"
                                           name="gioKhoiHanh"
                                           class="form-control"
                                           value="@(item.GioKhoiHanh.HasValue ? item.GioKhoiHanh.Value.ToString(@"hh\:mm") : "")"
                                           disabled="@(!choPhepSua)" />
                                </td>

                                <td>
                                    <input form="@formId"
                                           type="number"
                                           name="soChoToiDa"
                                           class="form-control"
                                           min="@Math.Max(1, item.SoChoToiDa - item.SoChoCon)"
                                           value="@item.SoChoToiDa"
                                           disabled="@(!choPhepSua)"
                                           required />
                                    <small class="ad-hint-nho">Còn @item.SoChoCon chỗ</small>
                                    <small class="ad-hint-nho">@(item.SoDoChoNgoi?.TenSoDo ?? "Chưa có sơ đồ chỗ ngồi")</small>
                                </td>

                                <td>
                                    <input form="@formId"
                                           type="number"
                                           name="giaNguoiLon"
                                           class="form-control price-input"
                                           min="0"
                                           step="1000"
                                           value="@giaNguoiLon.ToString("0")"
                                           disabled="@(!choPhepSua)"
                                           required />
                                </td>

                                <td>
                                    <input form="@formId"
                                           type="number"
                                           name="giaTreEm"
                                           class="form-control price-input"
                                           min="0"
                                           step="1000"
                                           value="@giaTreEm.ToString("0")"
                                           disabled="@(!choPhepSua)"
                                           required />
                                </td>

                                <td>
                                    <span class="ad-status @badgeClass">@nhanTrangThai</span>
                                </td>

                                <td>
                                    <div class="ad-row-actions">
                                        @if (choPhepSua)
                                        {
                                            <button form="@formId"
                                                    type="submit"
                                                    class="tv-btn tv-btn-chinh ad-btn-nho">
                                                Lưu
                                            </button>
                                        }

                                        @if (choPhepHuy)
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="DoiTrangThaiBanLich"
                                                  asp-route-id="@item.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="tv-btn tv-btn-vien ad-btn-nho">
                                                    @(item.DangTamNgung ? "Mở bán lại" : "Tạm ngưng bán")
                                                </button>
                                            </form>

                                            <form asp-controller="Admin"
                                                  asp-action="HuyLichKhoiHanh"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Bạn chắc chắn muốn hủy lịch khởi hành này không? Các đơn đặt tour liên quan sẽ chuyển sang trạng thái Đã hủy.');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="tv-btn tv-btn-huy ad-btn-nho">
                                                    Hủy lịch
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="ad-no-action">Không thao tác</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="ad-empty-cell">Chưa có lịch khởi hành cho tour này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>