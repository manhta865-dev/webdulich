@model List<webdulich.Models.DatTours>
@using System.Text.Json

@{
    ViewData["Title"] = "Doanh thu";

    int thangChon = ViewBag.ThangChon ?? DateTime.Today.Month;
    int namChon = ViewBag.NamChon ?? DateTime.Today.Year;
    var namOptions = ViewBag.NamOptions as List<int> ?? new List<int>();

    decimal tongDoanhThu = ViewBag.TongDoanhThu ?? 0;
    int soDonDaThanhToan = ViewBag.SoDonDaThanhToan ?? 0;
    decimal trungBinhDon = ViewBag.TrungBinhDon ?? 0;
    decimal doanhThuNam = ViewBag.DoanhThuNam ?? 0;
    string tourBanChay = ViewBag.TourBanChay ?? "Chưa có dữ liệu";

    var bieuDoNhan = ViewBag.BieuDoNhan as List<string> ?? new List<string>();
    var bieuDoDoanhThu = ViewBag.BieuDoDoanhThu as List<decimal> ?? new List<decimal>();
    var bieuDoSoDon = ViewBag.BieuDoSoDon as List<int> ?? new List<int>();

    string bieuDoNhanJson = JsonSerializer.Serialize(bieuDoNhan);
    string bieuDoDoanhThuJson = JsonSerializer.Serialize(bieuDoDoanhThu);
    string bieuDoSoDonJson = JsonSerializer.Serialize(bieuDoSoDon);
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Báo cáo doanh thu</h1>
            <p>Thống kê các đơn đặt tour đã thanh toán theo tháng và năm.</p>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="DoanhThu" method="get" class="ad-filter">
            <div>
                <label for="thang">Tháng</label>
                <select id="thang" name="thang" class="form-select-custom">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == thangChon)">
                            Tháng @i
                        </option>
                    }
                </select>
            </div>

            <div>
                <label for="nam">Năm</label>
                <select id="nam" name="nam" class="form-select-custom">
                    @foreach (var item in namOptions)
                    {
                        <option value="@item" selected="@(item == namChon)">
                            @item
                        </option>
                    }
                </select>
            </div>

            <div class="ad-filter-actions">
                <button type="submit" class="tv-btn tv-btn-chinh">Xem báo cáo</button>
                <a asp-controller="Admin" asp-action="DoanhThu" class="tv-btn tv-btn-vien">Làm mới</a>
            </div>
    </form>

    <div class="ad-kpis">
        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-wallet" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Doanh thu tháng @thangChon</span>
                <strong>@tongDoanhThu.ToString("N0") VNĐ</strong>
                <small>@soDonDaThanhToan đơn đã thanh toán</small>
            </span>
        </div>

        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-chart" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Doanh thu năm @namChon</span>
                <strong>@doanhThuNam.ToString("N0") VNĐ</strong>
                <small>Tổng doanh thu của 12 tháng</small>
            </span>
        </div>

        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Trung bình mỗi đơn</span>
                <strong>@trungBinhDon.ToString("N0") VNĐ</strong>
                <small>Tính trên tháng đang chọn</small>
            </span>
        </div>

        <div class="ad-kpi ad-kpi-nho">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-box" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Tour bán chạy</span>
                <strong>@tourBanChay</strong>
                <small>Theo số đơn trong tháng</small>
            </span>
        </div>
    </div>

    <section class="ad-card">
        <div class="ad-card-head">
            <h2>Biểu đồ doanh thu hàng tháng (@namChon)</h2>
            <span class="ad-badge">Tổng năm: @doanhThuNam.ToString("N0") VNĐ</span>
        </div>
        <p class="ad-note">Doanh thu thực tế từ các đơn đã thanh toán trong từng tháng.</p>

        <div class="ad-chart-wrap">
            <canvas id="revenueChart"></canvas>
        </div>
    </section>

    <div class="ad-table-card ad-khoang-tren">
        <div class="ad-table-toolbar">
            <h2>Chi tiết đơn đã thanh toán</h2>

            <div class="ad-export">
                <a asp-controller="Admin"
                   asp-action="XuatDoanhThuExcel"
                   asp-route-thang="@ViewBag.ThangChon"
                   asp-route-nam="@ViewBag.NamChon"
                   class="tv-btn tv-btn-vien ad-btn-nho">
                    Xuất Excel
                </a>

                <a asp-controller="Admin"
                   asp-action="BaoCaoDoanhThuPdf"
                   asp-route-thang="@ViewBag.ThangChon"
                   asp-route-nam="@ViewBag.NamChon"
                   target="_blank"
                   class="tv-btn tv-btn-vien ad-btn-nho">
                    Xuất PDF
                </a>
            </div>
        </div>

        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Mã chuyến</th>
                        <th>Khách hàng</th>
                        <th>Tour</th>
                        <th>Ngày đi</th>
                        <th>Số người</th>
                        <th>Phương thức</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="ad-mono">@item.MaChuyenDi</span></td>
                                <td>@item.TenKhach</td>
                                <td>@(item.Tour?.TenTour ?? "Chưa cập nhật")</td>
                                <td>@item.NgayDi.ToString("dd/MM/yyyy")</td>
                                <td>@item.SoNguoi</td>
                                <td>@item.PhuongThucThanhToan</td>
                                <td class="ad-price">@item.TongTien.ToString("N0") VNĐ</td>
                                <td><span class="badge-status status-paid">@item.TrangThaiThanhToan</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="ad-empty-cell">
                                Chưa có đơn đã thanh toán trong tháng @thangChon/@namChon.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const canvas = document.getElementById("revenueChart");

            if (!canvas || typeof Chart === "undefined") {
                return;
            }

            const labels = @Html.Raw(bieuDoNhanJson);
            const revenueData = @Html.Raw(bieuDoDoanhThuJson);
            const orderData = @Html.Raw(bieuDoSoDonJson);

            const context = canvas.getContext("2d");
            const gradient = context.createLinearGradient(0, 0, 0, 360);
            gradient.addColorStop(0, "rgba(10, 110, 138, 0.30)");
            gradient.addColorStop(1, "rgba(10, 110, 138, 0.02)");

            new Chart(context, {
                type: "line",
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: "Doanh thu",
                            data: revenueData,
                            borderColor: "#0A6E8A",
                            backgroundColor: gradient,
                            borderWidth: 3,
                            pointRadius: 5,
                            pointHoverRadius: 7,
                            pointBackgroundColor: "#FFFFFF",
                            pointBorderColor: "#0A6E8A",
                            pointBorderWidth: 2,
                            fill: true,
                            tension: 0.32
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: "top",
                            align: "end",
                            labels: {
                                usePointStyle: true,
                                boxWidth: 9,
                                font: {
                                    weight: "700"
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    const money = new Intl.NumberFormat("vi-VN")
                                        .format(context.parsed.y);
                                    const orders = orderData[context.dataIndex] || 0;
                                    return " " + money + " VNĐ - " + orders + " đơn";
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: {
                                    weight: "700"
                                }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: "rgba(148, 163, 184, 0.22)"
                            },
                            ticks: {
                                callback: function (value) {
                                    return new Intl.NumberFormat("vi-VN", {
                                        notation: "compact",
                                        maximumFractionDigits: 1
                                    }).format(value) + "đ";
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
