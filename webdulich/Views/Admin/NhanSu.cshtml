@model List<webdulich.Models.NhanVien>

@{
    ViewData["Title"] = "Quản lý nhân sự";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Quản lý nhân sự</h1>
            <p>Thêm tài khoản nhân viên, phân loại hướng dẫn viên hoặc tài xế.</p>
        </div>
    </div>

    @if (TempData["error"] != null)
    {
        <div class="ad-alert loi" role="alert">@TempData["error"]</div>
    }

    @if (TempData["success"] != null)
    {
        <div class="ad-alert ok" role="status">@TempData["success"]</div>
    }

    <section class="ad-form-block">
        <h2>Thêm nhân viên</h2>

        <form asp-controller="Admin" asp-action="ThemNhanVien" method="post" class="ad-form">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Họ tên</label>
                    <input name="hoTen" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Số điện thoại</label>
                    <input name="soDienThoai" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Loại nhân viên</label>
                    <select name="loaiNhanVien" class="form-select" required>
                        <option value="HuongDanVien">Hướng dẫn viên</option>
                        <option value="TaiXe">Tài xế</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tài khoản đăng nhập</label>
                    <input name="taiKhoanDangNhap" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Mật khẩu</label>
                    <input name="matKhau" type="password" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Ghi chú</label>
                    <input name="ghiChu" class="form-control" />
                </div>

                <div class="col-12">
                    <button type="submit" class="tv-btn tv-btn-chinh">Thêm nhân viên</button>
                </div>
            </div>
        </form>
    </section>

    <div class="ad-table-card ad-khoang-tren">
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Họ tên</th>
                        <th>Tài khoản</th>
                        <th>SĐT</th>
                        <th>Loại</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th>Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.HoTen</strong></td>
                            <td>@webdulich.Models.DinhDanhTaiKhoan.HienThi(item.TaiKhoan)</td>
                            <td>@item.SoDienThoai</td>
                            <td>
                                @(item.LoaiNhanVien == "HuongDanVien" ? "Hướng dẫn viên" : "Tài xế")
                            </td>
                            <td>
                                @if (item.DangLamViec)
                                {
                                    <span class="ad-badge">Đang làm</span>
                                }
                                else
                                {
                                    <span class="ad-badge tat">Tạm nghỉ</span>
                                }
                            </td>
                            <td>@item.GhiChu</td>
                            <td>
                                <a asp-controller="Admin"
                                   asp-action="DoiTrangThaiNhanVien"
                                   asp-route-id="@item.Id"
                                   class="tv-btn tv-btn-vien ad-btn-nho">
                                    Đổi trạng thái
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>