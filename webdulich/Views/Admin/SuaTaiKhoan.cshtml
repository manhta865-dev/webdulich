@model webdulich.Models.TaiKhoan

@{
    ViewData["Title"] = "Sửa tài khoản";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page ad-form-page">
    <div class="ad-pagehead">
        <div>
            <h1>Sửa tài khoản</h1>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="SuaTaiKhoan" method="post" class="ad-form-block ad-form">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label">Họ tên</label>
            <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TaiKhoanDangNhap" class="form-label">Email hoặc số điện thoại</label>

            <input asp-for="TaiKhoanDangNhap"
                   class="form-control"
                   placeholder="Nhập email hoặc số điện thoại"
                   pattern="(^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$)|(^0\d{9}$)"
                   title="Nhập email hợp lệ hoặc số điện thoại 10 số bắt đầu bằng 0" />

            <span asp-validation-for="TaiKhoanDangNhap" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MatKhau" class="form-label">Mật khẩu</label>
            <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VaiTro" class="form-label">Vai trò</label>
            <select asp-for="VaiTro" class="form-select">
                <option value="user">User</option>
                <option value="admin">Admin</option>
            </select>
        </div>

        <div class="ad-form-actions ad-form-actions-trai">
            <button type="submit" class="tv-btn tv-btn-chinh">Lưu thay đổi</button>

            <a asp-controller="Admin" asp-action="TaiKhoan" class="tv-btn tv-btn-vien">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}