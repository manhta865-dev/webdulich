@model webdulich.Models.SuaTaiKhoanViewModel

@{
    ViewData["Title"] = "Sửa tài khoản";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page ad-form-page">
    <div class="ad-pagehead">
        <div>
            <h1>Sửa tài khoản</h1>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="SuaTaiKhoan" method="post" class="ad-form-block ad-form">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label">Họ tên</label>
            <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="ten@gmail.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
            <input asp-for="SoDienThoai" type="tel" class="form-control" placeholder="0912345678" />
            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            <small class="text-muted">Cần ít nhất email hoặc số điện thoại; cả hai đều dùng để đăng nhập.</small>
        </div>

        <div class="mb-3">
            <label asp-for="MatKhauMoi" class="form-label">Mật khẩu mới</label>
            <input asp-for="MatKhauMoi" type="password" class="form-control" autocomplete="new-password" placeholder="Để trống nếu không đổi" />
            <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VaiTro" class="form-label">Vai trò</label>
            <select asp-for="VaiTro" class="form-select">
                <option value="user">Khách hàng</option>
                <option value="admin">Quản trị viên</option>
                <option value="huongdanvien">Hướng dẫn viên</option>
                <option value="taixe">Tài xế</option>
            </select>
            <span asp-validation-for="VaiTro" class="text-danger"></span>
        </div>

        <div class="ad-form-actions ad-form-actions-trai">
            <button type="submit" class="tv-btn tv-btn-chinh">Lưu thay đổi</button>

            <a asp-controller="Admin" asp-action="TaiKhoan" class="tv-btn tv-btn-vien">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
