@model webdulich.Models.SuaTaiKhoanViewModel

@{
    ViewData["Title"] = "Sửa tài khoản";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page ad-form-page">
    <div class="ad-pagehead">
        <div>
            <h1>Sửa tài khoản</h1>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="SuaTaiKhoan" method="post" class="ad-form-block ad-form">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label">Họ tên</label>
            <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="ten@gmail.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
            <input asp-for="SoDienThoai" type="tel" class="form-control" placeholder="0912345678" />
            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            <small class="text-muted">Cần ít nhất email hoặc số điện thoại; cả hai đều dùng để đăng nhập.</small>
        </div>

        <div class="mb-3">
            <label asp-for="MatKhauMoi" class="form-label">Mật khẩu mới</label>
            <input asp-for="MatKhauMoi" type="password" class="form-control" autocomplete="new-password" placeholder="Để trống nếu không đổi" />
            <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VaiTro" class="form-label">Vai trò</label>
            @if (Model.LaNhanVien)
            {
                @* Nhân viên gắn với hồ sơ nhân sự: chỉ đổi qua lại hướng dẫn viên và tài xế (RB-51) *@
                <select asp-for="VaiTro" class="form-select">
                    <option value="huongdanvien">Hướng dẫn viên</option>
                    <option value="taixe">Tài xế</option>
                </select>
                <small class="text-muted">Chỉ đổi được khi người này không còn chuyến chưa đi xong ở vai trò cũ (đổi người ở <a asp-controller="Admin" asp-action="PhanCongTour" class="tv-link">Phân công tour</a> trước). Nghỉ làm thì đặt Tạm nghỉ ở mục <a asp-controller="Admin" asp-action="NhanSu" class="tv-link">Nhân sự</a>.</small>
            }
            else if (Model.LaChinhMinh)
            {
                <input type="hidden" asp-for="VaiTro" />
                <input class="form-control" value="@webdulich.Models.VaiTroHienThi.Ten(Model.VaiTro)" readonly />
                <small class="text-muted">Không tự đổi vai trò của chính mình.</small>
            }
            else
            {
                <select asp-for="VaiTro" class="form-select" id="chonVaiTro">
                    <option value="user">Khách hàng</option>
                    <option value="admin">Quản trị viên</option>
                </select>
                <small class="text-muted">Hướng dẫn viên, tài xế thêm ở mục Nhân sự.</small>
            }
            <span asp-validation-for="VaiTro" class="text-danger"></span>
        </div>

        @* Nhóm quyền của quản trị viên (RB-51): menu và trang quản trị chỉ mở theo các nhóm được tick *@
        <fieldset class="mb-3 ad-quyen" id="khoiQuyen" @(Model.VaiTro == "admin" ? "" : "hidden")>
            <legend class="form-label">Nhóm quyền quản trị</legend>
            <p class="ad-note">Trang Tổng quan luôn xem được. Nhóm "Tài khoản và phân quyền" là quyền của admin chính: sửa, xóa tài khoản và cấp quyền.</p>
            <div class="ad-quyen-luoi">
                @foreach (var q in webdulich.Models.QuyenAdmin.TatCa)
                {
                    var khoa = Model.LaChinhMinh && q.Ma == webdulich.Models.QuyenAdmin.TaiKhoanQuyen;
                    var daTick = Model.DsQuyen.Contains(q.Ma) || khoa;
                    <label class="ad-quyen-o@(khoa ? " khoa" : "")">
                        <input type="checkbox" name="DsQuyen" value="@q.Ma" @(daTick ? "checked" : "") @(khoa ? "disabled" : "") />
                        <span>
                            <strong>@q.Ten</strong>
                            <small>@(khoa ? "Bạn không tự bỏ quyền này của mình." : q.MoTa)</small>
                        </span>
                    </label>
                }
            </div>
            <span asp-validation-for="DsQuyen" class="text-danger"></span>
        </fieldset>

        <div class="ad-form-actions ad-form-actions-trai">
            <button type="submit" class="tv-btn tv-btn-chinh">Lưu thay đổi</button>

            <a asp-controller="Admin" asp-action="TaiKhoan" class="tv-btn tv-btn-vien">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Chọn "Quản trị viên" thì hiện các ô tick nhóm quyền
        (function () {
            var chon = document.getElementById("chonVaiTro");
            var khoi = document.getElementById("khoiQuyen");
            if (!chon || !khoi) return;
            chon.addEventListener("change", function () { khoi.hidden = chon.value !== "admin"; });
        })();
    </script>
}
