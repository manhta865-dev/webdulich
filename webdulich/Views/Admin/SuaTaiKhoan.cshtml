@model webdulich.Models.TaiKhoan

@{
    ViewData["Title"] = "Sửa tài khoản";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-4 mx-auto p-4" style="max-width: 700px;">
        <h2 class="fw-bold mb-4 text-center">✏️ Sửa tài khoản</h2>

        <form asp-controller="Admin" asp-action="SuaTaiKhoan" method="post">
            <input type="hidden" asp-for="Id" />

            <!-- Họ tên -->
            <div class="mb-3">
                <label asp-for="HoTen" class="form-label fw-bold">Họ tên</label>
                <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên" />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>

            <!-- Email / SĐT -->
            <div class="mb-3">
                <label asp-for="TaiKhoanDangNhap" class="form-label fw-bold">Email hoặc số điện thoại</label>

                <input asp-for="TaiKhoanDangNhap"
                       class="form-control"
                       placeholder="Nhập email hoặc số điện thoại"
                       pattern="(^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$)|(^0\d{9}$)"
                       title="Nhập email hợp lệ hoặc số điện thoại 10 số bắt đầu bằng 0" />

                <span asp-validation-for="TaiKhoanDangNhap" class="text-danger"></span>
            </div>

            <!-- Mật khẩu -->
            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label fw-bold">Mật khẩu</label>
                <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>

            <!-- Vai trò -->
            <div class="mb-3">
                <label asp-for="VaiTro" class="form-label fw-bold">Vai trò</label>
                <select asp-for="VaiTro" class="form-select">
                    <option value="user">User</option>
                    <option value="admin">Admin</option>
                </select>
            </div>

            <!-- Button -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success px-4">
                    💾 Lưu thay đổi
                </button>

                <a asp-controller="Admin" asp-action="TaiKhoan" class="btn btn-secondary">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}