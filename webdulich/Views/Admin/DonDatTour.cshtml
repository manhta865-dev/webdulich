@model List<webdulich.Models.DonDatTourDoc>

@{
    ViewData["Title"] = "Danh sách khách đặt tour";

    var tongDon = Model != null ? Model.Count : 0;
    var dangKiemTra = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "Đang kiểm tra") : 0;
    var chuaThanhToan = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "Chưa thanh toán") : 0;
    var quaHan = Model != null ? Model.Count(x => x.QuaHanChuaXacNhan) : 0;
    var tienDoNhom = ViewBag.TienDoNhom as Dictionary<int, (int DaTra, int Tong)> ?? new Dictionary<int, (int DaTra, int Tong)>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Đơn đặt tour</h1>
            <p>Quản lý đơn đặt tour, theo dõi mã chuyến đi, ngày giờ khởi hành và trạng thái thanh toán. Trang này chỉ liệt kê đơn chưa thanh toán; đơn đã thanh toán xem ở mục Doanh thu.</p>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="ad-alert ok" role="status">@TempData["success"]</div>
    }

    @if (TempData["error"] != null)
    {
        <div class="ad-alert loi" role="alert">@TempData["error"]</div>
    }

    <div class="ad-kpis">
        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-receipt" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Đơn đang hiển thị</span>
                <strong>@tongDon</strong>
            </span>
        </div>

        <div class="ad-kpi@(dangKiemTra > 0 ? " ad-kpi-canh-bao" : "")">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-clock" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Đang kiểm tra</span>
                <strong>@dangKiemTra</strong>
                @if (quaHan > 0)
                {
                    <span class="ad-qua-han">@quaHan đơn quá hạn giữ chỗ</span>
                }
            </span>
        </div>

        <div class="ad-kpi">
            <span class="ad-kpi-icon"><svg class="tv-icon" aria-hidden="true"><use href="#i-wallet" /></svg></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Chưa thanh toán</span>
                <strong>@chuaThanhToan</strong>
            </span>
        </div>
    </div>

    <div class="ad-toolbar">
        <form asp-controller="Admin" asp-action="DonDatTour" method="get" class="ad-search">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   aria-label="Tìm đơn đặt tour"
                   placeholder="Tìm theo mã chuyến đi, nội dung chuyển khoản, khách hàng, SĐT, tour..." />

            <button class="tv-btn tv-btn-chinh" type="submit">Tìm kiếm</button>

            <a asp-controller="Admin" asp-action="DonDatTour" class="tv-btn tv-btn-vien">Làm mới</a>
        </form>
    </div>

    <div class="ad-table-card">
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Đơn</th>
                        <th>Khách hàng</th>
                        <th>Số người</th>
                        <th>Ngày đi</th>
                        <th>Giá tiền</th>
                        <th>Thanh toán</th>
                        <th>Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            var cssStatus = "status-unpaid";

                            if (item.TrangThaiThanhToan == "Đang kiểm tra")
                            {
                                cssStatus = "status-checking";
                            }
                            else if (item.TrangThaiThanhToan == "Đã thanh toán")
                            {
                                cssStatus = "status-paid";
                            }
                            else if (item.TrangThaiThanhToan == "Đã hủy")
                            {
                                cssStatus = "status-cancelled";
                            }

                            var gioDi = item.GioKhoiHanh;

                            <tr>
                                <td>
                                    <div class="ad-cell-stack">
                                        <strong>@item.TenTour</strong>
                                        <span class="ad-mono">@(string.IsNullOrEmpty(item.MaChuyenDi) ? "Chưa có mã" : item.MaChuyenDi)</span>
                                        @if (item.LoaiDon == "Nhom")
                                        {
                                            <span class="ad-nhom">Nhóm@(tienDoNhom.TryGetValue(item.Id, out var td) ? $", {td.DaTra}/{td.Tong} ghế đã trả" : "")</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <div class="ad-cell-stack">
                                        <strong>@item.TenKhach</strong>
                                        <span class="ad-sub">@item.DienThoai</span>
                                        <span class="ad-sub">@item.Email</span>
                                    </div>
                                </td>

                                <td>@item.SoNguoi</td>

                                <td>
                                    <div class="ad-cell-stack">
                                        <strong>@item.NgayDi.ToString("dd/MM/yyyy")</strong>
                                        <span class="ad-sub">Giờ đi: @(gioDi.HasValue ? gioDi.Value.ToString(@"hh\:mm") : "Chưa cập nhật")</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="ad-cell-stack">
                                        <span class="ad-price">@item.TongTien.ToString("N0") VNĐ</span>

                                        @if (!string.IsNullOrWhiteSpace(item.MaKhuyenMai))
                                        {
                                            <span class="ad-sub">Mã khuyến mãi: <span class="ad-mono">@item.MaKhuyenMai</span></span>
                                        }
                                        else
                                        {
                                            <span class="ad-sub">Không có khuyến mãi</span>
                                        }

                                        @if (item.SoTienGiam > 0)
                                        {
                                            <span class="ad-giam">Đã giảm -@item.SoTienGiam.ToString("N0") VNĐ</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <div class="ad-cell-stack">
                                        <span>@(item.LoaiDon == "Nhom" ? "Theo từng ghế" : item.PhuongThucThanhToan)</span>
                                        <span class="badge-status @cssStatus">@item.TrangThaiThanhToan</span>
                                        @if (item.QuaHanChuaXacNhan)
                                        {
                                            @* RB-38: khách đã báo chuyển khoản, quá hạn giữ chỗ: hệ thống không tự hủy, admin kiểm sao kê *@
                                            <span class="ad-qua-han">Quá hạn @item.HanGiuCho!.Value.ToString("HH:mm dd/MM"), cần kiểm sao kê</span>
                                        }
                                        else if (item.LoaiDon != "Nhom" && item.TrangThai == "GiuCho" && item.HanGiuCho.HasValue)
                                        {
                                            <span class="ad-sub">Giữ chỗ đến @item.HanGiuCho.Value.ToString("HH:mm dd/MM")</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <div class="ad-row-actions">
                                        <a asp-controller="Admin"
                                           asp-action="SuaDonDatTour"
                                           asp-route-id="@item.Id"
                                           class="tv-btn tv-btn-vien ad-btn-nho">Chi tiết</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="ad-empty-cell">Chưa có đơn đặt tour nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>