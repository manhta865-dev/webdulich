@model List<webdulich.Models.LichTrinhTour>

@{
    ViewData["Title"] = "Lịch trình tour";

    var tour = ViewBag.Tour as webdulich.Models.Tour;
}

<style>
    body {
        background: radial-gradient(circle at top left, rgba(201,168,76,0.14), transparent 28%), linear-gradient(180deg, #f8f5ee 0%, #eef3f8 100%) !important;
    }

    .schedule-page {
        max-width: 1180px;
        margin: 34px auto 70px;
        padding: 0 14px;
    }

    .schedule-hero {
        background: rgba(255,253,248,0.96);
        border: 1px solid rgba(201,168,76,0.28);
        border-radius: 22px;
        box-shadow: 0 20px 48px rgba(13,27,62,0.12);
        padding: 28px;
        margin-bottom: 22px;
        text-align: center;
    }

        .schedule-hero h2 {
            font-family: 'Playfair Display', serif;
            color: #0d1b3e;
            font-size: 2.2rem;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .schedule-hero p {
            color: #6b6250;
            font-weight: 700;
            margin-bottom: 0;
        }

    .tour-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        padding: 10px 16px;
        border-radius: 999px;
        background: #fff4d5;
        color: #8a5b00;
        border: 1px solid rgba(201,168,76,0.34);
        font-weight: 900;
    }

    .schedule-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.45fr;
        gap: 22px;
        align-items: start;
    }

    .schedule-card {
        background: rgba(255,253,248,0.96);
        border: 1px solid rgba(201,168,76,0.25);
        border-radius: 20px;
        box-shadow: 0 18px 44px rgba(13,27,62,0.1);
        padding: 22px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #0d1b3e;
        font-family: 'Playfair Display', serif;
        font-size: 1.35rem;
        font-weight: 900;
        margin-bottom: 18px;
    }

    .form-label {
        color: #0d1b3e;
        font-weight: 850;
    }

    .form-control {
        min-height: 46px;
        border-radius: 10px;
        border: 1px solid #d8c99d;
        background: #fffdf8;
        font-weight: 650;
    }

        .form-control:focus {
            border-color: #c9a84c;
            box-shadow: 0 0 0 0.2rem rgba(201,168,76,0.16);
        }

    textarea.form-control {
        min-height: 120px;
    }

    .btn-save-schedule {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 12px 18px;
        background: linear-gradient(135deg, #c9a84c, #e8c96d);
        color: #0a0f1e;
        font-weight: 950;
        box-shadow: 0 12px 26px rgba(201,168,76,0.28);
        transition: 0.22s;
    }

        .btn-save-schedule:hover {
            transform: translateY(-2px);
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 10px;
        width: 100%;
        border-radius: 10px;
        padding: 12px 18px;
        background: #0d1b3e;
        color: #f5e6b8 !important;
        text-decoration: none;
        font-weight: 900;
        transition: 0.22s;
    }

        .btn-back:hover {
            color: #e8c96d !important;
            transform: translateY(-2px);
        }

    .timeline {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .timeline-item {
        position: relative;
        border: 1px solid rgba(201,168,76,0.24);
        border-radius: 18px;
        background: linear-gradient(180deg, #fffdf8, #f8f1df);
        padding: 18px 18px 18px 72px;
        box-shadow: 0 12px 28px rgba(13,27,62,0.07);
    }

    .day-badge {
        position: absolute;
        left: 16px;
        top: 18px;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: #0d1b3e;
        color: #f5e6b8;
        display: grid;
        place-items: center;
        font-weight: 950;
        box-shadow: 0 10px 24px rgba(13,27,62,0.18);
    }

    .timeline-title {
        color: #0d1b3e;
        font-size: 1.1rem;
        font-weight: 950;
        margin-bottom: 7px;
    }

    .meal-line {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #eaf6ff;
        color: #075985;
        border: 1px solid #dbeafe;
        font-weight: 850;
        margin-bottom: 10px;
    }

    .timeline-content {
        color: #5f5748;
        font-weight: 650;
        line-height: 1.65;
        white-space: pre-line;
    }

    .delete-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 12px;
        padding: 8px 12px;
        border-radius: 9px;
        background: #b91c1c;
        color: #fff !important;
        text-decoration: none;
        font-weight: 850;
    }

    .empty-box {
        border-radius: 18px;
        padding: 22px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        font-weight: 800;
        line-height: 1.55;
    }

    @@media (max-width: 992px) {
        .schedule-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="schedule-page">
    <div class="schedule-hero">
        <h2>🧭 Lịch trình tour</h2>
        <p>Nhập lịch trình từng ngày để khách hàng xem rõ chuyến đi trước khi đặt tour.</p>

        @if (tour != null)
        {
            <div class="tour-chip">
                📍 @tour.TenTour
            </div>
        }
    </div>

    <div class="schedule-grid">
        <div class="schedule-card">
            <div class="section-title">➕ Thêm ngày lịch trình</div>

            @if (tour != null)
            {
                <form asp-controller="Admin" asp-action="ThemLichTrinh" method="post">
                    <input type="hidden" name="tourId" value="@tour.Id" />

                    <div class="mb-3">
                        <label class="form-label">Ngày thứ</label>
                        <input type="number"
                               name="ngayThu"
                               class="form-control"
                               min="1"
                               placeholder="Ví dụ: 1"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tiêu đề lịch trình</label>
                        <input type="text"
                               name="tieuDe"
                               class="form-control"
                               placeholder="Ví dụ: TP. Hồ Chí Minh - Đà Lạt"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bữa ăn</label>
                        <input type="text"
                               name="buaAn"
                               class="form-control"
                               placeholder="Ví dụ: Ăn sáng, trưa, tối" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nội dung chi tiết</label>
                        <textarea name="noiDung"
                              class="form-control"
                              placeholder="Nhập các hoạt động trong ngày: tham quan, ăn uống, nhận phòng..."></textarea>
                    </div>

                    <button type="submit" class="btn-save-schedule">
                        💾 Lưu lịch trình
                    </button>

                    <a asp-controller="Admin"
                       asp-action="QuanLyLichTrinh"
                       class="btn-back">
                        ← Quay lại danh sách
                    </a>
                </form>
            }
        </div>

        <div class="schedule-card">
            <div class="section-title">📋 Danh sách lịch trình</div>

            @if (Model != null && Model.Any())
            {
                <div class="timeline">
                    @foreach (var item in Model.OrderBy(x => x.NgayThu))
                    {
                        <div class="timeline-item">
                            <div class="day-badge">@item.NgayThu</div>

                            <div class="timeline-title">
                                Ngày @item.NgayThu: @item.TieuDe
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.BuaAn))
                            {
                                <div class="meal-line">
                                    🍽️ @item.BuaAn
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.NoiDung))
                            {
                                <div class="timeline-content">
                                    @item.NoiDung
                                </div>
                            }

                            <a asp-controller="Admin"
                               asp-action="XoaLichTrinh"
                               asp-route-id="@item.Id"
                               class="delete-link"
                               onclick="return confirm('Bạn chắc chắn muốn xóa lịch trình ngày này?')">
                                🗑️ Xóa
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-box">
                    Tour này chưa có lịch trình. Hãy thêm ngày 1, ngày 2... để khách hàng dễ hình dung chuyến đi.
                </div>
            }
        </div>
    </div>
</div>