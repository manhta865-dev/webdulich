@model List<webdulich.Models.LichTrinhTour>

@{
    ViewData["Title"] = "Lịch trình tour";

    var tour = ViewBag.Tour as webdulich.Models.Tour;
    var dsDiemCoSan = ViewBag.DsDiemCoSan as List<webdulich.Models.DiemThamQuan> ?? new List<webdulich.Models.DiemThamQuan>();
    string ToaDo(decimal vi, decimal kinh) => string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{vi:0.######}, {kinh:0.######}");
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Lịch trình tour</h1>
            <p>@tour?.TenTour</p>
        </div>
    </div>

    <p class="ad-note">Nhập lịch trình từng ngày để khách hàng xem rõ chuyến đi trước khi đặt tour.</p>

    @if (TempData["success"] != null)
    {
        <div class="ad-alert ok" role="status">@TempData["success"]</div>
    }

    @if (TempData["error"] != null)
    {
        <div class="ad-alert loi" role="alert">@TempData["error"]</div>
    }

    @if (tour != null)
    {
        <section class="ad-card ad-xuat-phat">
            <h2>Điểm xuất phát của tour</h2>
            <p class="ad-toa-do-nhac">Nơi xe bắt đầu chạy ở ngày đầu tiên. Mỗi ngày bên dưới nhập nơi xe tới vào cuối ngày, ngày sau tự đi tiếp từ đó. Có đủ điểm xuất phát và điểm của mọi ngày thì khách sẽ thấy xe chạy trên bản đồ thật.</p>
            <form asp-controller="Admin" asp-action="CapNhatDiemXuatPhat" asp-route-id="@tour.Id" method="post" class="ad-toa-do">
                <label for="toaDoXuatPhat">Tọa độ</label>
                <input type="text" id="toaDoXuatPhat" name="toaDo" class="form-control" inputmode="decimal" autocomplete="off"
                       value="@(tour.ViDoXuatPhat.HasValue ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{tour.ViDoXuatPhat.Value:0.######}, {tour.KinhDoXuatPhat!.Value:0.######}") : "")"
                       placeholder="Ví dụ: 10.7769, 106.7009" />
                <button type="submit" class="tv-btn tv-btn-vien ad-btn-nho">Lưu</button>
            </form>
        </section>
    }

    <div class="ad-split">
        <section class="ad-card">
            <h2>Thêm ngày lịch trình</h2>

            @if (tour != null)
            {
                <form asp-controller="Admin" asp-action="ThemLichTrinh" method="post" class="ad-form">
                    <input type="hidden" name="tourId" value="@tour.Id" />

                    <div class="mb-3">
                        <label class="form-label">Ngày thứ</label>
                        <input type="number"
                               name="ngayThu"
                               class="form-control"
                               min="1"
                               placeholder="Ví dụ: 1"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tiêu đề lịch trình</label>
                        <input type="text"
                               name="tieuDe"
                               class="form-control"
                               placeholder="Ví dụ: TP. Hồ Chí Minh - Đà Lạt"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bữa ăn</label>
                        <input type="text"
                               name="buaAn"
                               class="form-control"
                               placeholder="Ví dụ: Ăn sáng, trưa, tối" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nội dung chi tiết</label>
                        <textarea name="noiDung"
                                  class="form-control"
                                  placeholder="Nhập các hoạt động trong ngày: tham quan, ăn uống, nhận phòng..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tọa độ nơi tới cuối ngày (không bắt buộc)</label>
                        <input type="text"
                               name="toaDo"
                               class="form-control"
                               inputmode="decimal"
                               autocomplete="off"
                               placeholder="Ví dụ: 11.9404, 108.4583" />
                        <small class="ad-toa-do-nhac">Trên Google Maps, nhấp chuột phải vào điểm đó, bấm dòng số đầu tiên để sao chép rồi dán vào đây.</small>
                    </div>

                    <div class="ad-form-actions ad-form-actions-trai">
                        <button type="submit" class="tv-btn tv-btn-chinh">Lưu lịch trình</button>

                        <a asp-controller="Admin"
                           asp-action="QuanLyLichTrinh"
                           class="tv-btn tv-btn-vien">Quay lại danh sách</a>
                    </div>
                </form>
            }
        </section>

        <section class="ad-card">
            <h2>Danh sách lịch trình</h2>

            @if (Model != null && Model.Any())
            {
                <div class="ad-timeline">
                    @foreach (var item in Model.OrderBy(x => x.NgayThu))
                    {
                        <div class="ad-timeline-item">
                            <div class="ad-day">@item.NgayThu</div>

                            <div>
                                <strong>Ngày @item.NgayThu: @item.TieuDe</strong>

                                @if (!string.IsNullOrWhiteSpace(item.BuaAn))
                                {
                                    <div class="ad-meal">Bữa ăn: @item.BuaAn</div>
                                }
                            </div>

                            <form asp-controller="Admin" asp-action="XoaLichTrinh" asp-route-id="@item.Id" method="post" class="ad-lt-xoa"
                                  data-xac-nhan-tieu-de="Xóa ngày @item.NgayThu?"
                                  data-xac-nhan="Nội dung và tọa độ của ngày này sẽ bị xóa, không lấy lại được. Đường xe chạy của ngày kế tiếp sẽ được tính lại."
                                  data-xac-nhan-nut="Xóa ngày này" data-xac-nhan-nguy-hiem>
                                <button type="submit" class="tv-btn tv-btn-huy ad-btn-nho">Xóa</button>
                            </form>

                            @if (!string.IsNullOrWhiteSpace(item.NoiDung))
                            {
                                <div class="ad-timeline-content">@item.NoiDung</div>
                            }

                            <form asp-controller="Admin" asp-action="CapNhatToaDoLichTrinh" asp-route-id="@item.Id" method="post" class="ad-toa-do">
                                <label for="toaDo-@item.Id">Nơi tới cuối ngày</label>
                                <input type="text" id="toaDo-@item.Id" name="toaDo" class="form-control" inputmode="decimal" autocomplete="off"
                                       value="@item.ToaDoDangChu" placeholder="11.9404, 108.4583" />
                                <button type="submit" class="tv-btn tv-btn-vien ad-btn-nho">Lưu</button>
                                @if (item.ViDo.HasValue)
                                {
                                    <small class="ad-toa-do-tt">@(string.IsNullOrEmpty(item.DuongDi) ? "Chưa có đường xe chạy, bản đồ nối tạm bằng nét đứt" : "Đã có đường xe chạy")</small>
                                }
                            </form>

                            @* Điểm tham quan trong ngày (Mo23): chip địa điểm và Street View ở trang Khám phá 3D *@
                            @{
                                var dsDiem = item.DsDiemThamQuan.OrderBy(x => x.ThuTu).ToList();
                                var dsChon = dsDiemCoSan.Where(d => dsDiem.All(x => x.DiemThamQuanId != d.Id)).ToList();
                            }
                            <details class="ad-diem" @(dsDiem.Any() ? "open" : "")>
                                <summary>Điểm tham quan trong ngày (@dsDiem.Count)</summary>
                                @if (dsDiem.Any())
                                {
                                    <ol class="ad-diem-ds">
                                        @for (int k = 0; k < dsDiem.Count; k++)
                                        {
                                            var d = dsDiem[k].DiemThamQuan!;
                                            <li>
                                                <form asp-controller="AdminDiemThamQuan" asp-action="Sua" asp-route-id="@d.Id" method="post" class="ad-diem-sua">
                                                    <input type="hidden" name="tourId" value="@item.TourId" />
                                                    <input type="text" name="ten" value="@d.Ten" class="form-control" maxlength="150" aria-label="Tên điểm" required />
                                                    <input type="text" name="toaDo" value="@ToaDo(d.ViDo, d.KinhDo)" class="form-control" inputmode="decimal" aria-label="Tọa độ điểm" required />
                                                    <button type="submit" class="tv-btn tv-btn-vien ad-btn-nho">Lưu</button>
                                                </form>
                                                <div class="ad-diem-nut">
                                                    <form asp-controller="AdminDiemThamQuan" asp-action="DoiThuTu" method="post">
                                                        <input type="hidden" name="lichTrinhId" value="@item.Id" />
                                                        <input type="hidden" name="diemId" value="@d.Id" />
                                                        <input type="hidden" name="huong" value="-1" />
                                                        <button type="submit" class="tv-btn tv-btn-vien ad-btn-nho" aria-label="Đưa @d.Ten lên trước" @(k == 0 ? "disabled" : "")>Lên</button>
                                                    </form>
                                                    <form asp-controller="AdminDiemThamQuan" asp-action="DoiThuTu" method="post">
                                                        <input type="hidden" name="lichTrinhId" value="@item.Id" />
                                                        <input type="hidden" name="diemId" value="@d.Id" />
                                                        <input type="hidden" name="huong" value="1" />
                                                        <button type="submit" class="tv-btn tv-btn-vien ad-btn-nho" aria-label="Đưa @d.Ten ra sau" @(k == dsDiem.Count - 1 ? "disabled" : "")>Xuống</button>
                                                    </form>
                                                    <form asp-controller="AdminDiemThamQuan" asp-action="Go" method="post"
                                                          data-xac-nhan-tieu-de="Gỡ @d.Ten khỏi ngày @item.NgayThu?"
                                                          data-xac-nhan="Điểm vẫn được giữ để thêm lại vào ngày khác."
                                                          data-xac-nhan-nut="Gỡ điểm">
                                                        <input type="hidden" name="lichTrinhId" value="@item.Id" />
                                                        <input type="hidden" name="diemId" value="@d.Id" />
                                                        <button type="submit" class="tv-btn tv-btn-huy ad-btn-nho">Gỡ</button>
                                                    </form>
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                }
                                <form asp-controller="AdminDiemThamQuan" asp-action="Them" method="post" class="ad-diem-them">
                                    <input type="hidden" name="lichTrinhId" value="@item.Id" />
                                    @if (dsChon.Any())
                                    {
                                        <select name="diemCoSanId" class="form-select" aria-label="Chọn điểm có sẵn">
                                            <option value="">Điểm mới</option>
                                            @foreach (var d in dsChon)
                                            {
                                                <option value="@d.Id">@d.Ten</option>
                                            }
                                        </select>
                                    }
                                    <input type="text" name="ten" class="form-control" maxlength="150" placeholder="Tên điểm, ví dụ: Thác Datanla" aria-label="Tên điểm mới" />
                                    <input type="text" name="toaDo" class="form-control" inputmode="decimal" autocomplete="off" placeholder="11.9001, 108.4497" aria-label="Tọa độ điểm mới" />
                                    <button type="submit" class="tv-btn tv-btn-chinh ad-btn-nho">Thêm điểm</button>
                                </form>
                                <small class="ad-toa-do-nhac">Tọa độ lấy từ Google Maps: nhấp chuột phải đúng chỗ, bấm dòng số đầu tiên rồi dán vào. Street View hiện ảnh 360 gần tọa độ nhất.</small>
                            </details>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="tv-empty">
                    <p>Tour này chưa có lịch trình. Hãy thêm ngày 1, ngày 2... để khách hàng dễ hình dung chuyến đi.</p>
                </div>
            }
        </section>
    </div>
</div>