@model webdulich.Models.ChiTietDonViewModel

@{
    var don = Model.Don;
    ViewData["Title"] = "Chi tiết đơn " + don.MaChuyenDi;

    var cssStatus = don.TrangThaiThanhToan switch
    {
        "Đang kiểm tra" => "status-checking",
        "Đã thanh toán" => "status-paid",
        "Đã hủy" => "status-cancelled",
        _ => "status-unpaid"
    };
    var gioDi = don.GioKhoiHanh.HasValue ? don.GioKhoiHanh.Value.ToString(@"hh\:mm") : "Chưa cập nhật";
    var tenTrangThaiGiaoDich = new Dictionary<string, string>
    {
        ["ChoXacNhan"] = "Chờ xác nhận",
        ["ThanhCong"] = "Thành công",
        ["ThatBai"] = "Không hiệu lực"
    };
    // Đơn nhóm: tiền xác nhận theo từng ghế ngay trong bảng giao dịch, không có nút xác nhận cả đơn
    bool laNhom = don.LoaiDon == "Nhom";
    bool choXacNhanTien = !don.DaHuy && !don.DaThanhToan && !laNhom;
    var thuTuGhe = Model.DsGhe.Select((g, i) => new { g.Id, ThuTu = i + 1 }).ToDictionary(x => x.Id, x => x.ThuTu);
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page ad-form-page">
    <div class="ad-pagehead">
        <div>
            <h1>Đơn @don.MaChuyenDi</h1>
            <p>@don.TenTour, khởi hành @don.NgayDi.ToString("dd/MM/yyyy") lúc @gioDi. Đặt ngày @don.NgayDat.ToString("dd/MM/yyyy HH:mm").</p>
        </div>
        <span class="badge-status @cssStatus">@don.TrangThaiThanhToan</span>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="ad-alert ok" role="status">@TempData["success"]</div>
    }

    @if (TempData["error"] != null)
    {
        <div class="ad-alert loi" role="alert">@TempData["error"]</div>
    }

    <div class="ad-info-tiles">
        <div class="ad-info-tile">
            <span>Số người</span>
            <strong>@don.SoNguoi (@don.SoNguoiLon người lớn, @don.SoTreNho trẻ nhỏ)</strong>
        </div>
        <div class="ad-info-tile">
            <span>Phải trả</span>
            <strong>@don.TongTien.ToString("N0") VNĐ</strong>
        </div>
        <div class="ad-info-tile">
            <span>Khuyến mãi</span>
            <strong>@(string.IsNullOrEmpty(don.MaKhuyenMai) ? "Không có" : $"{don.MaKhuyenMai} (-{don.SoTienGiam:N0} VNĐ)")</strong>
        </div>
        <div class="ad-info-tile">
            <span>Thanh toán bằng</span>
            <strong>@(laNhom ? "Chuyển khoản theo từng ghế" : don.PhuongThucThanhToan)</strong>
        </div>
    </div>

    @* ---------- Thanh toán ---------- *@
    <section class="ad-form-block">
        <h2>Thanh toán</h2>

        @if (Model.DsGiaoDich.Any())
        {
            <div class="ad-table-wrap">
                <table class="ad-table">
                    <thead>
                        <tr>
                            <th>Ngày tạo</th>
                            @if (laNhom)
                            {
                                <th>Ghế</th>
                                <th>Người trả</th>
                            }
                            <th>Phương thức</th>
                            <th>Số tiền</th>
                            <th>Trạng thái</th>
                            <th>Xác nhận lúc</th>
                            @if (laNhom)
                            {
                                <th>Xử lý</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gd in Model.DsGiaoDich)
                        {
                            var gheGd = gd.HanhKhachDatTourId.HasValue ? Model.DsGhe.FirstOrDefault(g => g.Id == gd.HanhKhachDatTourId.Value) : null;
                            <tr>
                                <td>@gd.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                @if (laNhom)
                                {
                                    <td>
                                        @if (gheGd != null)
                                        {
                                            <span>Ghế @thuTuGhe[gheGd.Id]</span><br />
                                            <small class="ad-note">@gheGd.MaThanhToan</small>
                                        }
                                    </td>
                                    <td>@(gd.NguoiTra?.HoTen ?? "")@(gheGd != null && gd.NguoiTraId.HasValue && gd.NguoiTraId != gheGd.TaiKhoanId ? " (trả hộ)" : "")</td>
                                }
                                <td>@gd.PhuongThuc</td>
                                <td class="ad-price">@gd.SoTien.ToString("N0") VNĐ</td>
                                <td>@(tenTrangThaiGiaoDich.TryGetValue(gd.TrangThai, out var ten) ? ten : gd.TrangThai)</td>
                                <td>@(gd.NgayXacNhan?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                @if (laNhom)
                                {
                                    <td>
                                        @if (gd.TrangThai == "ChoXacNhan")
                                        {
                                            <div class="ad-gd-nut">
                                                @if (gheGd?.NgayNha == null)
                                                {
                                                    <form method="post" asp-action="XacNhanGiaoDichGhe" asp-route-id="@gd.Id"
                                                          data-xac-nhan-tieu-de="Xác nhận đã nhận tiền ghế @(gheGd != null ? thuTuGhe[gheGd.Id] : 0)?"
                                                          data-xac-nhan="Chỉ bấm khi sao kê đã có @gd.SoTien.ToString("N0") VNĐ với nội dung @gheGd?.MaThanhToan (@gd.PhuongThuc). Ghế sẽ chuyển sang Đã trả."
                                                          data-xac-nhan-nut="Đã nhận tiền">
                                                        <input type="hidden" name="dongY" value="true" />
                                                        <button type="submit" class="tv-btn tv-btn-chinh">Đã nhận</button>
                                                    </form>
                                                }
                                                <form method="post" asp-action="XacNhanGiaoDichGhe" asp-route-id="@gd.Id"
                                                      data-xac-nhan-tieu-de="Từ chối giao dịch này?"
                                                      data-xac-nhan="Dùng khi sao kê không có khoản @gd.SoTien.ToString("N0") VNĐ với nội dung @gheGd?.MaThanhToan. Ghế quay về chưa trả, người trả phải báo chuyển khoản lại."
                                                      data-xac-nhan-nut="Từ chối" data-xac-nhan-nguy-hiem>
                                                    <input type="hidden" name="dongY" value="false" />
                                                    <button type="submit" class="tv-btn tv-btn-vien">Từ chối</button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="ad-note">Chưa có giao dịch nào cho đơn này.</p>
        }

        <div class="ad-form-actions ad-form-actions-trai">
            @if (choXacNhanTien)
            {
                <form method="post" asp-action="XacNhanDaNhanTien" asp-route-id="@don.Id"
                      data-xac-nhan-tieu-de="Xác nhận đã nhận đủ tiền?"
                      data-xac-nhan="Đơn @don.MaChuyenDi, số tiền @don.TongTien.ToString("N0") VNĐ. Đơn sẽ chuyển sang Đã thanh toán."
                      data-xac-nhan-nut="Đã nhận đủ">
                    <button type="submit" class="tv-btn tv-btn-chinh">Xác nhận đã nhận tiền</button>
                </form>
            }

            @if (!don.DaHuy)
            {
                <form method="post" asp-action="HuyDonDatTour" asp-route-id="@don.Id"
                      data-xac-nhan-tieu-de="Hủy đơn @don.MaChuyenDi?"
                      data-xac-nhan="Mọi ghế bị nhả và chỗ trả lại cho lịch, giao dịch đang chờ thành không hiệu lực.@(Model.DsGiaoDich.Any(g => g.TrangThai == "ThanhCong") ? " Đơn đã có tiền nhận: cần hoàn tiền cho khách ngoài hệ thống." : "")"
                      data-xac-nhan-nut="Hủy đơn" data-xac-nhan-nguy-hiem>
                    <button type="submit" class="tv-btn tv-btn-huy">Hủy đơn</button>
                </form>
            }
        </div>

        @if (don.DaThanhToan && !don.DaHuy)
        {
            <p class="ad-note">Đơn đã thanh toán. Nếu hủy, tiền đã nhận cần hoàn ngoài hệ thống.</p>
        }
    </section>

    @* ---------- Hành khách ---------- *@
    <section class="ad-form-block">
        <h2>Hành khách</h2>

        @if (Model.DsGhe.Any())
        {
            <div class="ad-passengers">
                @for (int i = 0; i < Model.DsGhe.Count; i++)
                {
                    var ghe = Model.DsGhe[i];
                    var typeClass = ghe.LoaiHanhKhach == "Trẻ nhỏ" ? "child" : "adult";

                    <div class="ad-passenger@(ghe.NgayNha.HasValue && !don.DaHuy ? " ad-passenger-nha" : "")">
                        <div class="ad-passenger-head">
                            <strong>Hành khách @(i + 1): @(string.IsNullOrWhiteSpace(ghe.HoTen) ? "Chưa điền tên" : ghe.HoTen)</strong>
                            <span class="ad-type @typeClass">@ghe.LoaiHanhKhach</span>
                        </div>

                        <div class="ad-passenger-info">
                            <div>
                                <span>Giấy tờ</span>
                                <strong>@(string.IsNullOrWhiteSpace(ghe.SoGiayTo) ? "Chưa điền" : $"{ghe.LoaiGiayTo} {ghe.SoGiayTo}")</strong>
                            </div>
                            @if (Model.ChoTheoGhe.TryGetValue(ghe.Id, out var maCho))
                            {
                                <div>
                                    <span>Chỗ ngồi</span>
                                    <strong>@maCho</strong>
                                </div>
                            }
                            <div>
                                <span>Giá lúc đặt</span>
                                <strong>@ghe.GiaLucDat.ToString("N0") VNĐ</strong>
                            </div>
                            @if (ghe.NgayNha.HasValue && !don.DaHuy)
                            {
                                <div>
                                    <span>Đã bỏ khỏi đơn</span>
                                    <strong>@ghe.NgayNha.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="ad-note">Đơn này chưa có hành khách.</p>
        }
    </section>

    @* ---------- Đổi số người ---------- *@
    @if (Model.DuocDoiSoNguoi)
    {
        <section class="ad-form-block">
            <h2>Đổi số người</h2>
            <p class="ad-note">
                Giá hiện tại của lịch: người lớn @Model.GiaNguoiLon.ToString("N0") VNĐ, trẻ nhỏ @Model.GiaTreEm.ToString("N0") VNĐ.
                Lịch còn @Model.SoChoCon chỗ. Người thêm mới chưa có tên và giấy tờ; người bớt đi là người thêm sau cùng.
            </p>

            <form method="post" asp-action="DoiSoNguoiDon" asp-route-id="@don.Id" class="ad-form">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="soNguoiLon">Người lớn</label>
                        <input type="number" id="soNguoiLon" name="soNguoiLon" class="form-control" min="1" value="@don.SoNguoiLon" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="soTreNho">Trẻ nhỏ</label>
                        <input type="number" id="soTreNho" name="soTreNho" class="form-control" min="0" value="@don.SoTreNho" required />
                    </div>
                    <div class="col-md-4 mb-3 d-flex align-items-end">
                        <button type="submit" class="tv-btn tv-btn-vien">Cập nhật số người</button>
                    </div>
                </div>
            </form>
        </section>
    }

    @* ---------- Thông tin liên hệ ---------- *@
    <form asp-controller="Admin" asp-action="SuaDonDatTour" method="post" class="ad-form">
        <input type="hidden" name="Id" value="@don.Id" />

        <section class="ad-form-block">
            <h2>Thông tin liên hệ</h2>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="TenKhach">Tên người liên hệ</label>
                    <input id="TenKhach" name="TenKhach" class="form-control" value="@don.TenKhach" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="DienThoai">Điện thoại</label>
                    <input id="DienThoai" name="DienThoai" class="form-control" value="@don.DienThoai" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="Email">Email</label>
                    <input id="Email" name="Email" type="email" class="form-control" value="@don.Email" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="DiaChi">Địa chỉ</label>
                    <input id="DiaChi" name="DiaChi" class="form-control" value="@don.DiaChi" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="GhiChu">Ghi chú</label>
                    <textarea id="GhiChu" name="GhiChu" class="form-control" rows="3">@don.GhiChu</textarea>
                </div>
            </div>
        </section>

        <div class="ad-form-actions">
            <button type="submit" class="tv-btn tv-btn-chinh">Lưu thông tin liên hệ</button>
            <a asp-controller="Admin" asp-action="DonDatTour" class="tv-btn tv-btn-vien">Quay lại</a>
        </div>
    </form>
</div>
