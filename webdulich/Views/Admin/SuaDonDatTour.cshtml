@model webdulich.Models.DatTours

@{
    ViewData["Title"] = "Sửa đơn đặt tour";

    var tours = ViewBag.Tours as List<webdulich.Models.Tour>;
    var trangThaiList = ViewBag.TrangThaiList as List<string>;

    var danhSachHanhKhach = Model.HanhKhachDatTours != null
        ? Model.HanhKhachDatTours.OrderBy(x => x.Id).ToList()
        : new List<webdulich.Models.HanhKhachDatTour>();

    var cssStatus = "status-unpaid";

    if (Model.TrangThaiThanhToan == "Đang kiểm tra")
    {
        cssStatus = "status-checking";
    }
    else if (Model.TrangThaiThanhToan == "Đã thanh toán")
    {
        cssStatus = "status-paid";
    }

    var gioDiHienThi = "Chưa cập nhật";
    if (Model.LichKhoiHanhTour != null && Model.LichKhoiHanhTour.GioKhoiHanh.HasValue)
    {
        gioDiHienThi = Model.LichKhoiHanhTour.GioKhoiHanh.Value.ToString(@"hh\:mm");
    }
    var phuongTienHienThi = Model.Tour?.PhuongTienHienThi ?? "Chưa cập nhật";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page ad-form-page">
    <div class="ad-pagehead">
        <div>
            <h1>Sửa đơn đặt tour</h1>
            <p>Cập nhật thông tin khách hàng, lịch đi, tour và trạng thái thanh toán.</p>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="SuaDonDatTour" method="post" class="ad-form">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="MaChuyenDi" />
        <input type="hidden" asp-for="PhuongThucThanhToan" />
        <input type="hidden" asp-for="LichKhoiHanhTourId" />
        <input type="hidden" asp-for="TaiKhoanId" />

        <div class="ad-info-tiles">
            <div class="ad-info-tile">
                <span>Mã chuyến đi</span>
                <strong>@(string.IsNullOrEmpty(Model.MaChuyenDi) ? "Chưa có" : Model.MaChuyenDi)</strong>
            </div>

            <div class="ad-info-tile">
                <span>Giờ khởi hành</span>
                <strong>@gioDiHienThi</strong>
            </div>

            <div class="ad-info-tile">
                <span>Phương tiện</span>
                <strong>@phuongTienHienThi</strong>
            </div>

            <div class="ad-info-tile">
                <span>Thanh toán bằng</span>
                <strong>@(string.IsNullOrEmpty(Model.PhuongThucThanhToan) ? "Chưa cập nhật" : Model.PhuongThucThanhToan)</strong>
            </div>
        </div>

        <section class="ad-form-block">
            <h2>Thông tin khách hàng</h2>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TenKhach" class="form-label">Tên khách</label>
                    <input asp-for="TenKhach" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DienThoai" class="form-label">Điện thoại</label>
                    <input asp-for="DienThoai" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                    <input asp-for="DiaChi" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                    <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </section>

        <section class="ad-form-block">
            <h2>Danh sách hành khách</h2>
            <p class="ad-note">Tổng cộng @Model.SoNguoi người trong đơn đặt tour này.</p>

            @if (danhSachHanhKhach.Any())
            {
                <div class="ad-passengers">
                    @for (int i = 0; i < danhSachHanhKhach.Count; i++)
                    {
                        var hanhKhach = danhSachHanhKhach[i];
                        var typeClass = hanhKhach.LoaiHanhKhach == "Trẻ nhỏ" ? "child" : "adult";

                        <div class="ad-passenger">
                            <div class="ad-passenger-head">
                                <strong>Hành khách @(i + 1): @hanhKhach.HoTen</strong>

                                <span class="ad-type @typeClass">@hanhKhach.LoaiHanhKhach</span>
                            </div>

                            <div class="ad-passenger-info">
                                <div>
                                    <span>Loại giấy tờ</span>
                                    <strong>@hanhKhach.LoaiGiayTo</strong>
                                </div>

                                <div>
                                    <span>Số giấy tờ</span>
                                    <strong>@hanhKhach.SoGiayTo</strong>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="tv-empty">
                    <p>Đơn này chưa có dữ liệu hành khách chi tiết. Có thể đây là đơn được tạo trước khi thêm chức năng nhập thông tin từng hành khách.</p>
                </div>
            }
        </section>

        <section class="ad-form-block">
            <h2>Thông tin đơn đặt tour</h2>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="SoNguoi" class="form-label">Số người</label>
                    <input asp-for="SoNguoi" type="number" min="1" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="NgayDi" class="form-label">Ngày đi</label>
                    <input asp-for="NgayDi" type="date" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="TourId" class="form-label">Tour</label>
                    <select asp-for="TourId" class="form-select">
                        @if (tours != null)
                        {
                            foreach (var tour in tours)
                            {
                                <option value="@tour.Id">@tour.TenTour</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TongTien" class="form-label">Giá tiền</label>
                    <input asp-for="TongTien" class="form-control money-input" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TrangThaiThanhToan" class="form-label">Trạng thái thanh toán</label>

                    <div class="ad-status-row">
                        <select asp-for="TrangThaiThanhToan" class="form-select" id="trangThaiSelect">
                            @if (trangThaiList != null)
                            {
                                foreach (var tt in trangThaiList)
                                {
                                    <option value="@tt">@tt</option>
                                }
                            }
                        </select>

                        <span id="statusBadge" class="badge-status @cssStatus">@Model.TrangThaiThanhToan</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="ad-form-actions">
            <button type="submit" class="tv-btn tv-btn-chinh">Lưu thay đổi</button>
            <a asp-controller="Admin" asp-action="DonDatTour" class="tv-btn tv-btn-vien">Quay lại</a>
        </div>
    </form>
</div>

<script>
    const trangThaiSelect = document.getElementById("trangThaiSelect");
    const statusBadge = document.getElementById("statusBadge");

    function updateStatusBadge() {
        const value = trangThaiSelect.value;
        statusBadge.textContent = value;

        statusBadge.classList.remove("status-unpaid", "status-checking", "status-paid");

        if (value === "Đang kiểm tra") {
            statusBadge.classList.add("status-checking");
        } else if (value === "Đã thanh toán") {
            statusBadge.classList.add("status-paid");
        } else {
            statusBadge.classList.add("status-unpaid");
        }
    }

    if (trangThaiSelect && statusBadge) {
        trangThaiSelect.addEventListener("change", updateStatusBadge);
    }
</script>