@model webdulich.Models.DatTours

@{
    ViewData["Title"] = "Sửa đơn đặt tour";

    var tours = ViewBag.Tours as List<webdulich.Models.Tour>;
    var trangThaiList = ViewBag.TrangThaiList as List<string>;

    var danhSachHanhKhach = Model.HanhKhachDatTours != null
        ? Model.HanhKhachDatTours.OrderBy(x => x.Id).ToList()
        : new List<webdulich.Models.HanhKhachDatTour>();

    var cssStatus = "status-unpaid";

    if (Model.TrangThaiThanhToan == "Đang kiểm tra")
    {
        cssStatus = "status-checking";
    }
    else if (Model.TrangThaiThanhToan == "Đã thanh toán")
    {
        cssStatus = "status-paid";
    }

    var gioDiHienThi = "Chưa cập nhật";
    if (Model.LichKhoiHanhTour != null && Model.LichKhoiHanhTour.GioKhoiHanh.HasValue)
    {
        gioDiHienThi = Model.LichKhoiHanhTour.GioKhoiHanh.Value.ToString(@"hh\:mm");
    }
    var phuongTienHienThi = Model.Tour?.PhuongTienHienThi ?? "Chưa cập nhật";
}

<style>
    body {
        background: radial-gradient(circle at top left, rgba(201,168,76,0.14), transparent 28%), linear-gradient(180deg, #f8f5ee 0%, #eef3f8 100%) !important;
    }

    .edit-order-page {
        max-width: 1180px;
        margin: 34px auto 70px;
        padding: 0 14px;
    }

    .edit-shell {
        background: rgba(255,253,248,0.96);
        border: 1px solid rgba(201,168,76,0.28);
        border-radius: 24px;
        box-shadow: 0 22px 54px rgba(13,27,62,0.14);
        overflow: hidden;
    }

    .edit-hero {
        padding: 30px 34px;
        background: radial-gradient(circle at top right, rgba(232,201,109,0.22), transparent 36%), linear-gradient(135deg, #0d1b3e, #122455);
        border-bottom: 3px solid #c9a84c;
        color: #f8fafc;
    }

        .edit-hero h2 {
            margin: 0;
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.8rem, 3vw, 2.5rem);
            font-weight: 900;
            color: #f5e6b8;
        }

        .edit-hero p {
            margin: 8px 0 0;
            color: rgba(245,230,184,0.78);
            font-weight: 650;
        }

    .edit-body {
        padding: 30px;
    }

    .top-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

    .summary-chip {
        border-radius: 18px;
        padding: 16px 18px;
        border: 1px solid rgba(201,168,76,0.22);
        background: linear-gradient(135deg, #fffdf8, #f8f1df);
    }

        .summary-chip span {
            display: block;
            color: #766a55;
            font-size: 0.86rem;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .summary-chip strong {
            display: block;
            color: #0d1b3e;
            font-size: 1rem;
            font-weight: 950;
            word-break: break-word;
        }

    .edit-section {
        margin-bottom: 24px;
        padding: 22px;
        border-radius: 20px;
        background: rgba(255,255,255,0.82);
        border: 1px solid rgba(201,168,76,0.24);
        box-shadow: 0 12px 28px rgba(13,27,62,0.06);
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 18px;
        color: #0d1b3e;
        font-family: 'Playfair Display', serif;
        font-size: 1.35rem;
        font-weight: 900;
    }

    .section-subnote {
        margin-top: -10px;
        margin-bottom: 18px;
        color: #766a55;
        font-weight: 700;
    }

    .form-label {
        color: #0d1b3e;
        font-weight: 850;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        min-height: 48px;
        border-radius: 12px;
        border: 1px solid #d8c99d;
        background-color: #fffdf8;
        color: #0a0f1e;
        font-weight: 650;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #c9a84c;
            box-shadow: 0 0 0 0.22rem rgba(201,168,76,0.18);
        }

    textarea.form-control {
        min-height: 96px;
    }

    .passenger-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .passenger-card {
        border-radius: 18px;
        border: 1px solid rgba(201,168,76,0.26);
        background: linear-gradient(135deg, #fffdf8, #f8f1df);
        padding: 18px;
        position: relative;
        overflow: hidden;
    }

        .passenger-card::after {
            content: "";
            position: absolute;
            width: 96px;
            height: 96px;
            right: -34px;
            top: -34px;
            border-radius: 50%;
            background: rgba(201,168,76,0.14);
        }

    .passenger-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        position: relative;
        z-index: 1;
    }

    .passenger-name {
        color: #0d1b3e;
        font-weight: 950;
        font-size: 1.05rem;
    }

    .passenger-type {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 0.82rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .type-adult {
        background: #eaf6ff;
        color: #075985;
        border: 1px solid #bfdbfe;
    }

    .type-child {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fed7aa;
    }

    .passenger-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        position: relative;
        z-index: 1;
    }

    .info-mini {
        border-radius: 12px;
        background: rgba(255,255,255,0.72);
        border: 1px solid rgba(201,168,76,0.18);
        padding: 11px 12px;
    }

        .info-mini span {
            display: block;
            color: #766a55;
            font-size: 0.8rem;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .info-mini strong {
            display: block;
            color: #0d1b3e;
            font-weight: 950;
            word-break: break-word;
        }

    .empty-passenger {
        border-radius: 16px;
        padding: 16px 18px;
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        font-weight: 800;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 142px;
        padding: 9px 15px;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 900;
        border: 1px solid transparent;
        margin-top: 10px;
    }

    .status-unpaid {
        background: #fee2e2;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .status-checking {
        background: #fff2c7;
        color: #8a5b00;
        border-color: #f3d27a;
    }

    .status-paid {
        background: #dcfce7;
        color: #166534;
        border-color: #86efac;
    }

    .money-input {
        color: #a78328;
        font-weight: 950;
    }

    .edit-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: flex-end;
        margin-top: 8px;
    }

    .btn-save {
        border: none;
        border-radius: 12px;
        padding: 12px 24px;
        background: linear-gradient(135deg, #c9a84c, #e8c96d);
        color: #0a0f1e;
        text-decoration: none;
        font-weight: 950;
        box-shadow: 0 12px 26px rgba(201,168,76,0.28);
        transition: 0.25s;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            color: #0a0f1e;
        }

    .btn-back {
        border: 1px solid rgba(13,27,62,0.2);
        border-radius: 12px;
        padding: 12px 24px;
        background: #0d1b3e;
        color: #f5e6b8;
        text-decoration: none;
        font-weight: 900;
        transition: 0.25s;
    }

        .btn-back:hover {
            color: #e8c96d;
            transform: translateY(-2px);
        }

    @@media (max-width: 992px) {
        .top-summary,
        .passenger-grid {
            grid-template-columns: 1fr;
        }

        .edit-body {
            padding: 20px;
        }

        .passenger-info {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="edit-order-page">
    <div class="edit-shell">
        <div class="edit-hero">
            <h2>✏️ Sửa đơn đặt tour</h2>
            <p>Cập nhật thông tin khách hàng, lịch đi, tour và trạng thái thanh toán.</p>
        </div>

        <div class="edit-body">
            <form asp-controller="Admin" asp-action="SuaDonDatTour" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="MaChuyenDi" />
                <input type="hidden" asp-for="PhuongThucThanhToan" />
                <input type="hidden" asp-for="LichKhoiHanhTourId" />
                <input type="hidden" asp-for="TaiKhoanId" />

                <div class="top-summary">
                    <div class="summary-chip">
                        <span>Mã chuyến đi</span>
                        <strong>@(string.IsNullOrEmpty(Model.MaChuyenDi) ? "Chưa có" : Model.MaChuyenDi)</strong>
                    </div>

                    <div class="summary-chip">
                        <span>Giờ khởi hành</span>
                        <strong>@gioDiHienThi</strong>
                    </div>
                    <div class="summary-chip">
                        <span>Phương tiện</span>
                        <strong>@phuongTienHienThi</strong>
                    </div>
                    <div class="summary-chip">
                        <span>Thanh toán bằng</span>
                        <strong>@(string.IsNullOrEmpty(Model.PhuongThucThanhToan) ? "Chưa cập nhật" : Model.PhuongThucThanhToan)</strong>
                    </div>
                </div>

                <div class="edit-section">
                    <h3 class="section-title">👤 Thông tin khách hàng</h3>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TenKhach" class="form-label">Tên khách</label>
                            <input asp-for="TenKhach" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DienThoai" class="form-label">Điện thoại</label>
                            <input asp-for="DienThoai" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                            <input asp-for="DiaChi" class="form-control" />
                        </div>

                        <div class="col-12 mb-0">
                            <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                            <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <div class="edit-section">
                    <h3 class="section-title">🧾 Danh sách hành khách</h3>
                    <div class="section-subnote">
                        Tổng cộng @Model.SoNguoi người trong đơn đặt tour này.
                    </div>

                    @if (danhSachHanhKhach.Any())
                    {
                        <div class="passenger-grid">
                            @for (int i = 0; i < danhSachHanhKhach.Count; i++)
                            {
                                var hanhKhach = danhSachHanhKhach[i];
                                var typeClass = hanhKhach.LoaiHanhKhach == "Trẻ nhỏ" ? "type-child" : "type-adult";

                                <div class="passenger-card">
                                    <div class="passenger-head">
                                        <div class="passenger-name">
                                            Hành khách @(i + 1): @hanhKhach.HoTen
                                        </div>

                                        <span class="passenger-type @typeClass">
                                            @hanhKhach.LoaiHanhKhach
                                        </span>
                                    </div>

                                    <div class="passenger-info">
                                        <div class="info-mini">
                                            <span>Loại giấy tờ</span>
                                            <strong>@hanhKhach.LoaiGiayTo</strong>
                                        </div>

                                        <div class="info-mini">
                                            <span>Số giấy tờ</span>
                                            <strong>@hanhKhach.SoGiayTo</strong>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-passenger">
                            Đơn này chưa có dữ liệu hành khách chi tiết. Có thể đây là đơn được tạo trước khi thêm chức năng nhập thông tin từng hành khách.
                        </div>
                    }
                </div>

                <div class="edit-section">
                    <h3 class="section-title">🧳 Thông tin đơn đặt tour</h3>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="SoNguoi" class="form-label">Số người</label>
                            <input asp-for="SoNguoi" type="number" min="1" class="form-control" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="NgayDi" class="form-label">Ngày đi</label>
                            <input asp-for="NgayDi" type="date" class="form-control" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="TourId" class="form-label">Tour</label>
                            <select asp-for="TourId" class="form-select">
                                @if (tours != null)
                                {
                                    foreach (var tour in tours)
                                    {
                                        <option value="@tour.Id">@tour.TenTour</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="TongTien" class="form-label">Giá tiền</label>
                            <input asp-for="TongTien" class="form-control money-input" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="TrangThaiThanhToan" class="form-label">Trạng thái thanh toán</label>
                            <select asp-for="TrangThaiThanhToan" class="form-select" id="trangThaiSelect">
                                @if (trangThaiList != null)
                                {
                                    foreach (var tt in trangThaiList)
                                    {
                                        <option value="@tt">@tt</option>
                                    }
                                }
                            </select>

                            <span id="statusBadge" class="badge-status @cssStatus">
                                @Model.TrangThaiThanhToan
                            </span>
                        </div>
                    </div>
                </div>

                <div class="edit-actions">
                    <a asp-controller="Admin" asp-action="DonDatTour" class="btn-back">
                        ← Quay lại
                    </a>

                    <button type="submit" class="btn-save">
                        💾 Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const trangThaiSelect = document.getElementById("trangThaiSelect");
    const statusBadge = document.getElementById("statusBadge");

    function updateStatusBadge() {
        const value = trangThaiSelect.value;
        statusBadge.textContent = value;

        statusBadge.classList.remove("status-unpaid", "status-checking", "status-paid");

        if (value === "Đang kiểm tra") {
            statusBadge.classList.add("status-checking");
        } else if (value === "Đã thanh toán") {
            statusBadge.classList.add("status-paid");
        } else {
            statusBadge.classList.add("status-unpaid");
        }
    }

    if (trangThaiSelect && statusBadge) {
        trangThaiSelect.addEventListener("change", updateStatusBadge);
    }
</script>