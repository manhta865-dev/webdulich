@model List<webdulich.Models.KhuyenMai>
@{
    ViewData["Title"] = "Khuyến mãi";
    var khuyenMaiSua = ViewBag.KhuyenMaiSua as webdulich.Models.KhuyenMai;
    bool dangSua = khuyenMaiSua != null;
    string actionForm = dangSua ? "SuaKhuyenMai" : "ThemKhuyenMai";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Quản lý khuyến mãi</h1>
            <p>Tạo mã giảm giá để khách copy ở trang chủ và áp dụng khi thanh toán.</p>
        </div>
    </div>

    @if (TempData["ThanhCong"] != null)
    {
        <div class="ad-alert ok" role="status">@TempData["ThanhCong"]</div>
    }

    @if (TempData["Loi"] != null)
    {
        <div class="ad-alert loi" role="alert">@TempData["Loi"]</div>
    }

    <form method="post" action="@Url.Action(actionForm, "Admin")" class="ad-form-block ad-form">
        @Html.AntiForgeryToken()

        @if (dangSua)
        {
            <input type="hidden" name="Id" value="@khuyenMaiSua!.Id" />
        }

        <h2>@(dangSua ? "Sửa khuyến mãi" : "Thêm khuyến mãi")</h2>

        <div class="ad-fields">
            <div class="ad-field">
                <label>Tên khuyến mãi</label>
                <input name="TenKhuyenMai" value="@(khuyenMaiSua?.TenKhuyenMai ?? "")" required placeholder="Ví dụ: Summer Sale" />
            </div>

            <div class="ad-field">
                <label>Mã khuyến mãi</label>
                <input name="MaKhuyenMai" value="@(khuyenMaiSua?.MaKhuyenMai ?? "")" required placeholder="Ví dụ: SUMMER2026" />
            </div>

            <div class="ad-field">
                <label>Kiểu giảm</label>
                <select name="KieuGiamGia">
                    @if (khuyenMaiSua?.KieuGiamGia == "PhanTram")
                    {
                        <option value="Tien">Giảm tiền</option>
                        <option value="PhanTram" selected>Giảm phần trăm</option>
                    }
                    else
                    {
                        <option value="Tien" selected>Giảm tiền</option>
                        <option value="PhanTram">Giảm phần trăm</option>
                    }
                </select>
            </div>

            <div class="ad-field">
                <label>Giá trị giảm</label>
                <input type="number" step="0.1" min="0" name="GiaTriGiam" value="@(khuyenMaiSua?.GiaTriGiam.ToString("0.##") ?? "")" required placeholder="1500000 hoặc 10" />
            </div>

            <div class="ad-field">
                <label>Ngày bắt đầu</label>
                <input type="date" name="NgayBatDau" value="@((khuyenMaiSua?.NgayBatDau ?? DateTime.Today).ToString("yyyy-MM-dd"))" required />
            </div>

            <div class="ad-field">
                <label>Ngày kết thúc</label>
                <input type="date" name="NgayKetThuc" value="@((khuyenMaiSua?.NgayKetThuc ?? DateTime.Today.AddMonths(1)).ToString("yyyy-MM-dd"))" required />
            </div>

            <div class="ad-field">
                <label>Màu thẻ</label>
                <input type="color" name="MauNen" value="@(khuyenMaiSua?.MauNen ?? "#ff6b4a")" />
            </div>

            <div class="ad-field">
                <label>Thứ tự hiển thị</label>
                <input type="number" name="ThuTu" value="@(khuyenMaiSua?.ThuTu ?? 1)" min="1" />
            </div>

            <div class="ad-field">
                <label>Số lượt tối đa</label>
                <input type="number" name="SoLuotDungToiDa" value="@(khuyenMaiSua?.SoLuotDungToiDa?.ToString() ?? "")" min="1" placeholder="Bỏ trống nếu không giới hạn" />
            </div>

            <div class="ad-field">
                <label>Trạng thái</label>
                <select name="TrangThai">
                    @if (khuyenMaiSua?.TrangThai == "TamNgung")
                    {
                        <option value="HoatDong">Hoạt động</option>
                        <option value="TamNgung" selected>Tạm ngưng</option>
                    }
                    else
                    {
                        <option value="HoatDong" selected>Hoạt động</option>
                        <option value="TamNgung">Tạm ngưng</option>
                    }
                </select>
            </div>

            <div class="ad-field full">
                <label>Mô tả</label>
                <textarea name="MoTa" placeholder="Ví dụ: Giảm ngay 1.500.000đ cho tất cả tour.">@(khuyenMaiSua?.MoTa ?? "")</textarea>
            </div>
        </div>

        <div class="ad-form-actions ad-form-actions-trai">
            <button type="submit" class="tv-btn tv-btn-chinh">@(dangSua ? "Lưu cập nhật" : "Thêm khuyến mãi")</button>

            @if (dangSua)
            {
                <a asp-controller="Admin" asp-action="KhuyenMai" class="tv-btn tv-btn-vien">Hủy sửa</a>
            }
        </div>
    </form>

    <div class="ad-toolbar ad-khoang-tren">
        <form method="get" asp-controller="Admin" asp-action="KhuyenMai" class="ad-search">
            <input name="search" value="@ViewBag.Search" class="form-control" aria-label="Tìm khuyến mãi" placeholder="Tìm theo tên hoặc mã khuyến mãi..." />
            <button type="submit" class="tv-btn tv-btn-chinh">Tìm</button>
            <a asp-controller="Admin" asp-action="KhuyenMai" class="tv-btn tv-btn-vien">Làm mới</a>
        </form>
    </div>

    <div class="ad-table-card">
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Tên khuyến mãi</th>
                        <th>Mã</th>
                        <th>Giảm</th>
                        <th>Thời gian</th>
                        <th>Lượt dùng</th>
                        <th>Màu</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="ad-cell-stack">
                                        <strong>@item.TenKhuyenMai</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.MoTa))
                                        {
                                            <span class="ad-sub">@item.MoTa</span>
                                        }
                                    </div>
                                </td>
                                <td><span class="ad-mono">@item.MaKhuyenMai</span></td>
                                <td>@item.GiaTriHienThi</td>
                                <td>@item.NgayBatDau.ToString("dd/MM/yyyy") - @item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                                <td>@item.SoLuotDaDungThucTe / @(item.SoLuotDungToiDa?.ToString() ?? "Không giới hạn")</td>
                                <td><span class="ad-color-dot" style="background:@item.MauNen"></span></td>
                                <td>
                                    <span class="ad-badge@(item.DangHoatDong ? "" : " tat")">@item.TrangThaiHienThi</span>
                                </td>
                                <td>
                                    <div class="ad-row-actions">
                                        <a asp-controller="Admin" asp-action="SuaKhuyenMai" asp-route-id="@item.Id" class="tv-btn tv-btn-vien ad-btn-nho">Sửa</a>

                                        <form method="post" asp-controller="Admin" asp-action="DoiTrangThaiKhuyenMai">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="tv-btn tv-btn-vien ad-btn-nho">
                                                @(item.TrangThai == "HoatDong" ? "Tạm ngưng" : "Mở lại")
                                            </button>
                                        </form>

                                        <form method="post" asp-controller="Admin" asp-action="XoaKhuyenMai" onsubmit="return confirm('Bạn chắc chắn muốn xóa khuyến mãi này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="tv-btn tv-btn-huy ad-btn-nho">Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="ad-empty-cell">Chưa có khuyến mãi nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>