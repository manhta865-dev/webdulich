@model List<webdulich.Models.PhanCongTour>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Phân công tour";

    var lichList = ViewBag.LichKhoiHanhList as List<SelectListItem>;
    var hdvList = ViewBag.HuongDanVienList as List<SelectListItem>;
    var taiXeList = ViewBag.TaiXeList as List<SelectListItem> ?? new List<SelectListItem>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="ad-page">
    <div class="ad-pagehead">
        <div>
            <h1>Phân công tour</h1>
            <p>Chọn lịch khởi hành, hướng dẫn viên và tài xế phụ trách tour.</p>
        </div>
    </div>

    <section class="ad-form-block">
        <h2>Thêm phân công</h2>

        <form asp-controller="Admin" asp-action="ThemPhanCongTour" method="post" class="ad-form">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Lịch khởi hành</label>
                    <select name="LichKhoiHanhTourId" class="form-select" asp-items="lichList" required>
                        <option value="">-- Chọn lịch --</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Hướng dẫn viên</label>
                    <select name="HuongDanVienId" class="form-select" asp-items="hdvList" required>
                        <option value="">-- Chọn hướng dẫn viên --</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tài xế</label>

                    <select name="TaiXeId" class="form-select">
                        <option value="">-- Không cần tài xế --</option>

                        @foreach (var tx in taiXeList)
                        {
                            if (!string.IsNullOrWhiteSpace(tx.Value))
                            {
                                <option value="@tx.Value">@tx.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Ghi chú</label>
                    <input name="GhiChu" class="form-control" placeholder="Ví dụ: tour nước ngoài không cần tài xế..." />
                </div>

                <div class="col-12">
                    <button type="submit" class="tv-btn tv-btn-chinh">Lưu phân công</button>
                </div>
            </div>
        </form>
    </section>

    <div class="ad-table-card ad-khoang-tren">
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Tour</th>
                        <th>Ngày đi</th>
                        <th>Giờ đi</th>
                        <th>Hướng dẫn viên</th>
                        <th>Tài xế</th>
                        <th>Ghi chú</th>
                        <th>Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var lich = item.LichKhoiHanhTour;
                        var tour = lich?.Tour;

                        <tr>
                            <td><strong>@tour?.TenTour</strong></td>
                            <td>@lich?.NgayKhoiHanh.ToString("dd/MM/yyyy")</td>
                            <td>
                                @(lich?.GioKhoiHanh.HasValue == true
                                    ? lich.GioKhoiHanh.Value.ToString(@"hh\:mm")
                                    : "Chưa cập nhật")
                            </td>
                            <td>
                                <span class="ad-pill">@item.HuongDanVien?.TaiKhoan?.HoTen</span>
                            </td>
                            <td>
                                @if (item.TaiXe != null)
                                {
                                    <span class="ad-pill taixe">@item.TaiXe.TaiKhoan?.HoTen</span>
                                }
                                else
                                {
                                    <span class="ad-pill trong">Không cần tài xế</span>
                                }
                            </td>
                            <td>@item.GhiChu</td>
                            <td>
                                <div class="ad-row-actions">
                                    <a asp-controller="Admin"
                                       asp-action="SuaPhanCongTour"
                                       asp-route-id="@item.Id"
                                       class="tv-btn tv-btn-vien ad-btn-nho">
                                        Sửa
                                    </a>

                                    <form asp-controller="Admin" asp-action="XoaPhanCongTour" asp-route-id="@item.Id" method="post" class="ad-form-gon"
                                          data-xac-nhan-tieu-de="Xóa phân công này?"
                                          data-xac-nhan="Nhân viên sẽ không còn thấy chuyến này trong lịch làm việc."
                                          data-xac-nhan-nut="Xóa phân công" data-xac-nhan-nguy-hiem>
                                        <button type="submit" class="tv-btn tv-btn-huy ad-btn-nho">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="ad-empty-cell">Chưa có phân công tour nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>