@model List<webdulich.Models.BaiViet>

@{
    ViewData["Title"] = "Bài viết";
    int trang = ViewBag.Trang;
    int tongTrang = ViewBag.TongTrang;
    var baiDau = trang == 1 ? Model.FirstOrDefault() : null;
    var baiCon = baiDau == null ? Model : Model.Skip(1).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bai-viet.css" asp-append-version="true" />
}

<div class="bv-trang">
    <h1>Bài viết</h1>
    <p class="bv-mo-ta">Kinh nghiệm và gợi ý cho chuyến đi của bạn và cả nhóm.</p>

    @if (Model.Count == 0)
    {
        <div class="tv-empty">
            <h3>Chưa có bài viết nào</h3>
            <p>Trong lúc chờ, bạn có thể <a asp-controller="DiaDiem" asp-action="DanhSach">xem các tour đang mở</a>.</p>
        </div>
    }

    @if (baiDau != null)
    {
        <a href="/BaiViet/@baiDau.DuongDan" class="bv-dau">
            <div class="bv-anh">
                @if (!string.IsNullOrEmpty(baiDau.AnhBia))
                {
                    <img src="~/images/baiviet/@baiDau.AnhBia" alt="" />
                }
            </div>
            <div class="bv-chu">
                <time>@baiDau.NgayDang?.ToString("dd/MM/yyyy")</time>
                <h2>@baiDau.TieuDe</h2>
                <p>@baiDau.TomTat</p>
            </div>
        </a>
    }

    @if (baiCon.Count > 0)
    {
        <div class="bv-luoi">
            @foreach (var bai in baiCon)
            {
                <a href="/BaiViet/@bai.DuongDan" class="bv-the">
                    <div class="bv-anh">
                        @if (!string.IsNullOrEmpty(bai.AnhBia))
                        {
                            <img src="~/images/baiviet/@bai.AnhBia" alt="" loading="lazy" />
                        }
                    </div>
                    <time>@bai.NgayDang?.ToString("dd/MM/yyyy")</time>
                    <h2>@bai.TieuDe</h2>
                    <p>@bai.TomTat</p>
                </a>
            }
        </div>
    }

    @if (tongTrang > 1)
    {
        <nav class="bv-phan-trang" aria-label="Chuyển trang bài viết">
            @if (trang > 1)
            {
                <a asp-action="Index" asp-route-trang="@(trang - 1)" class="tv-btn tv-btn-vien">Trang trước</a>
            }
            <span>Trang @trang trên @tongTrang</span>
            @if (trang < tongTrang)
            {
                <a asp-action="Index" asp-route-trang="@(trang + 1)" class="tv-btn tv-btn-vien">Trang sau</a>
            }
        </nav>
    }
</div>
