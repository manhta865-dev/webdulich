@model webdulich.Models.MoiNhomViewModel
@{
    ViewData["Title"] = "Lời mời đi " + Model.TenTour;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dat-tour.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/don-nhom.css" asp-append-version="true" />
}

<div class="dt-page">
    @* Thư mời dạng vé: thân vé là chuyến đi, cuống vé là hạn nhận ghế và trả tiền *@
    <div class="tv-ve tv-ve-ngang dn-ve-dau">
        <div class="dn-ve-dau-than dn-ve-moi-than">
            @if (!string.IsNullOrEmpty(Model.HinhAnh))
            {
                <img src="~/images/dulich/@Model.HinhAnh" alt="" class="dn-ve-moi-anh" />
            }
            <div class="dn-ve-moi-chu">
                <span class="dn-ve-dau-nhan">@Model.TenTruongNhom mời bạn đi cùng</span>
                <h1>@Model.TenTour</h1>
                <dl class="dn-ve-dau-ds">
                    <div><dt>Khởi hành</dt><dd class="tv-ma">@Model.NgayDi.ToString("dd/MM/yyyy")</dd></div>
                    @if (Model.GioKhoiHanh.HasValue)
                    {
                        <div><dt>Giờ đi</dt><dd class="tv-ma">@Model.GioKhoiHanh.Value.ToString(@"hh\:mm")</dd></div>
                    }
                    <div><dt>Mã đơn</dt><dd class="tv-ma">@Model.MaChuyenDi</dd></div>
                </dl>
            </div>
        </div>
        <div class="tv-ve-duc-lo-doc" aria-hidden="true"></div>
        <div class="dn-ve-dau-cuong dem@(Model.DaGiaHan ? " gia-han" : "")">
            <div class="dn-dong-ho@(Model.DaGiaHan ? " gia-han" : "")" data-han="@GioVN.Iso(Model.HanGiuCho)">
                <span>Nhận ghế và trả trước</span>
                <strong data-dem>--:--:--</strong>
                <small>@Model.HanGiuCho.ToString("HH:mm dd/MM/yyyy")</small>
            </div>
            <span class="tv-ma-vach" aria-hidden="true"></span>
        </div>
    </div>

    @if (TempData["ThanhCong"] != null)
    {
        <div class="dn-alert ok" role="status">@TempData["ThanhCong"]</div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="dn-alert loi" role="alert">@TempData["Loi"]</div>
    }

    @if (Model.LaTruongNhom)
    {
        <div class="dn-alert ok" role="status">
            Đây là đơn của bạn. <a asp-action="ChiTiet" asp-route-id="@Model.DonId">Mở trang tiến độ của nhóm</a>.
        </div>
    }

    <div class="dt-layout">
        <section class="dt-block">
            <div class="dn-tien-do-head">
                <h2>Chọn ghế của bạn</h2>
                <span>Còn @Model.SoGheTrong ghế</span>
            </div>
            <p class="dt-note">
                Mỗi người nhận một ghế, tự điền thông tin và tự chuyển khoản phần của mình.
                @(Model.DaDangNhap ? "" : "Bạn cần đăng nhập để nhận ghế, xong sẽ quay lại trang này.")
            </p>

            @* Mỗi ghế là một tấm vé; không hiện tên ai vì ai có link cũng xem được *@
            <ol class="dn-vg-ds" data-moc-dong>
                @foreach (var g in Model.DsGhe)
                {
                    <li class="tv-ve tv-ve-ngang dn-vg @(g.NhanDuoc ? "con-nhan" : "da-co-nguoi")">
                        <div class="dn-vg-than">
                            <div class="dn-vg-dau">
                                <span class="tv-ma">GHẾ @g.ThuTu.ToString("00")</span>
                                @if (g.MaCho != null)
                                {
                                    <span class="tv-ma dn-vg-cho">CHỖ @g.MaCho</span>
                                }
                            </div>
                            <strong class="dn-vg-ten">@g.LoaiHanhKhach</strong>
                            <span class="dn-vg-phu">@(g.MaCho != null ? "Chỗ " + g.MaCho + " đã chọn sẵn" : "Chọn chỗ ngồi sau khi nhận ghế")</span>
                            @if (!g.NhanDuoc)
                            {
                                <div class="dn-vg-moc">
                                    @if (g.ConTrong)
                                    {
                                        <span class="dn-vg-ghi-chu">Trưởng nhóm điền hộ</span>
                                    }
                                    else
                                    {
                                        <span class="tv-moc tv-moc-xam">Đã có người nhận</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="tv-ve-duc-lo-doc" aria-hidden="true"></div>
                        <div class="dn-vg-cuong">
                            <span class="dn-vg-tien"><span class="tv-ma">@g.PhaiTra.ToString("N0")</span> VNĐ</span>
                            @if (g.NhanDuoc)
                            {
                                <form asp-action="NhanGhe" method="post" class="dn-nhan-form">
                                    <input type="hidden" name="ma" value="@Model.Ma" />
                                    <input type="hidden" name="gheId" value="@g.Id" />
                                    <button type="submit" class="tv-btn tv-btn-chinh">@(Model.DaDangNhap ? "Nhận ghế này" : "Đăng nhập để nhận")</button>
                                </form>
                            }
                        </div>
                    </li>
                }
            </ol>
            <p class="dn-hint">Trang này không hiện tên ai, vì ai có link cũng xem được.</p>
        </section>

        <aside class="dt-block">
            <h2>Cách tham gia</h2>
            <ol class="dn-cach">
                <li>Nhận một ghế còn trống.</li>
                <li>Điền họ tên và giấy tờ của bạn.</li>
                <li>Chọn hoặc đổi chỗ ngồi nếu muốn.</li>
                <li>Chuyển khoản phần của bạn trước hạn. Ghế chưa trả khi hết hạn sẽ bị nhả.</li>
            </ol>
        </aside>
    </div>
</div>

<script>
    (function () {
        var dongHo = document.querySelector("[data-han]");
        if (!dongHo) return;
        var han = new Date(dongHo.dataset.han).getTime(), o = dongHo.querySelector("[data-dem]");
        var hai = function (n) { return (n < 10 ? "0" : "") + n; };
        var chay = function () {
            var con = Math.max(0, Math.floor((han - Date.now()) / 1000));
            o.textContent = hai(Math.floor(con / 3600)) + ":" + hai(Math.floor(con % 3600 / 60)) + ":" + hai(con % 60);
            dongHo.classList.toggle("sap-het", con < 3600);
        };
        chay();
        setInterval(chay, 1000);
    })();
</script>
<script src="~/js/moc-dong.js" asp-append-version="true"></script>
