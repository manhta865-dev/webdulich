@model webdulich.Models.DonNhomChiTietViewModel
@using webdulich.Models
@{
    var don = Model.Don;
    ViewData["Title"] = "Đơn nhóm " + don.MaChuyenDi;
    int tongGhe = Model.DsGhe.Count(g => g.TrangThai != TrangThaiGhe.DaNha);
    int phanTram = tongGhe == 0 ? 0 : Model.SoGheDaTra * 100 / tongGhe;
    string CssTrangThai(string t) => t switch
    {
        TrangThaiGhe.DaTra => "da-tra",
        TrangThaiGhe.ChoXacNhan => "cho",
        TrangThaiGhe.DaDien => "da-dien",
        TrangThaiGhe.DaNhan => "da-nhan",
        TrangThaiGhe.DaNha => "da-nha",
        _ => "trong"
    };
    // Cùng điều kiện với máy chủ: nút nào hiện ra là bấm được
    var conGiuCho = Model.ConNhanThayDoi;
    int soGheTrong = Model.DsGhe.Count(g => g.TrangThai == TrangThaiGhe.ChuaNhan);
    // Lời mời soạn sẵn để dán vào nhóm chat; link đặt cuối để ứng dụng chat tự nhận thành liên kết
    var loiMoi = conGiuCho
        ? $"Mình đã giữ {Model.DsGhe.Count} chỗ tour {don.TenTour}, khởi hành {don.NgayDi:dd/MM/yyyy}. "
          + $"Mỗi người bấm link, nhận một ghế, điền thông tin và tự chuyển khoản phần của mình trước {Model.HanGiuCho!.Value:HH:mm dd/MM}. "
          + $"Quá hạn ghế chưa trả sẽ bị nhả.\n{Model.LinkMoi}"
        : "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dat-tour.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/don-nhom.css" asp-append-version="true" />
}

<div class="dt-page">
    <div class="dn-head">
        <div>
            <span class="dn-ma">Đơn nhóm @don.MaChuyenDi</span>
            <h1>@don.TenTour</h1>
            <p>Khởi hành @don.NgayDi.ToString("dd/MM/yyyy")@(don.GioKhoiHanh.HasValue ? " lúc " + don.GioKhoiHanh.Value.ToString(@"hh\:mm") : ""), @Model.DsGhe.Count ghế.</p>
        </div>
        @if (conGiuCho)
        {
            <div class="dn-dong-ho@(Model.DaGiaHan ? " gia-han" : "")" data-han="@GioVN.Iso(Model.HanGiuCho!.Value)">
                <span>@(Model.DaGiaHan ? "Đã gia hạn, còn" : "Giữ chỗ còn")</span>
                <strong data-dem>--:--:--</strong>
                <small>đến @Model.HanGiuCho.Value.ToString("HH:mm dd/MM/yyyy")</small>
            </div>
        }
        else if (don.TrangThai != "GiuCho")
        {
            <span class="dn-trang-thai @(don.DaHuy ? "huy" : "chot")">@(don.DaHuy ? "Đơn đã hủy" : "Đơn đã chốt")</span>
        }
    </div>

    @if (conGiuCho && Model.DaGiaHan)
    {
        @* N5: hết hạn lần đầu mà còn ghế chưa trả thì được gia hạn một lần *@
        <div class="dn-alert canh-bao" role="status">Đơn đã được gia hạn, đây là lần cuối. Ghế chưa trả trước @Model.HanGiuCho!.Value.ToString("HH:mm dd/MM") sẽ bị nhả, bạn nhắc các thành viên nhé.</div>
    }
    @if (!conGiuCho && don.TrangThai == "GiuCho")
    {
        @* Đơn chưa chốt nhưng đã quá hạn, tới ngày đi hoặc lịch bị hủy: nói rõ vì sao không còn nút thay đổi *@
        <div class="dn-alert canh-bao" role="status">@Model.LyDoKhongNhan</div>
    }

    @if (TempData["ThanhCong"] != null)
    {
        <div class="dn-alert ok" role="status">@TempData["ThanhCong"]</div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="dn-alert loi" role="alert">@TempData["Loi"]</div>
    }

    <div class="dt-layout">
        <div>
            <section class="dt-block">
                <div class="dn-tien-do-head">
                    <h2>Tiến độ của nhóm</h2>
                    <span>@Model.SoGheDaTra/@tongGhe ghế đã trả</span>
                </div>
                @if (tongGhe > 0)
                {
                    @* Mỗi ghế trả xong xe tiến một đoạn. Vị trí tính sẵn ở máy chủ, CSS chỉ tạo hiệu ứng chạy tới đó *@
                    bool duChuyen = Model.SoGheDaTra == tongGhe;
                    int soChoXacNhan = Model.DsGhe.Count(g => g.TrangThai == TrangThaiGhe.ChoXacNhan);
                    <div class="dn-duong@(duChuyen ? " xong" : "")" style="--tien: @phanTram" role="progressbar"
                         aria-valuemin="0" aria-valuemax="@tongGhe" aria-valuenow="@Model.SoGheDaTra"
                         aria-valuetext="@Model.SoGheDaTra trên @tongGhe ghế đã trả" aria-label="Tiến độ trả tiền của nhóm">
                        <div class="dn-duong-nen"><span class="dn-duong-da-di"></span></div>
                        <div class="dn-duong-moc" aria-hidden="true">
                            @for (int i = 1; i < tongGhe; i++)
                            {
                                <span class="@(i <= Model.SoGheDaTra ? "qua" : "")" style="left: @(i * 100 / tongGhe)%"></span>
                            }
                        </div>
                        <svg class="dn-duong-co" viewBox="0 0 24 40" aria-hidden="true">
                            <path d="M5 38V4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                            <path d="M6 5h15l-4 6 4 6H6z" fill="currentColor" />
                        </svg>
                        <svg class="dn-duong-xe" viewBox="0 0 56 34" aria-hidden="true">
                            <rect x="2" y="3" width="52" height="24" rx="6" fill="currentColor" />
                            <path d="M8 8h9v8H8zM20 8h9v8h-9zM32 8h9v8h-9z" fill="#FFFFFF" />
                            <path d="M44 8h6a2 2 0 0 1 2 2v6h-8z" fill="#FFFFFF" />
                            <circle cx="15" cy="28" r="5" fill="#17262E" />
                            <circle cx="41" cy="28" r="5" fill="#17262E" />
                            <circle cx="15" cy="28" r="2" fill="#FFFFFF" />
                            <circle cx="41" cy="28" r="2" fill="#FFFFFF" />
                        </svg>
                    </div>
                    <p class="dn-duong-chu">
                        @(duChuyen ? "Cả nhóm đã trả đủ, xe tới đích."
                            : Model.SoGheDaTra == 0 ? "Xe chờ ghế đầu tiên trả tiền để lăn bánh."
                            : $"Còn {tongGhe - Model.SoGheDaTra} ghế nữa là xe tới đích.")
                        @if (soChoXacNhan > 0)
                        {
                            <span>@soChoXacNhan ghế đang chờ TravelVN xác nhận tiền.</span>
                        }
                    </p>
                }

                <ol class="dn-ghe-ds">
                    @foreach (var g in Model.DsGhe)
                    {
                        <li class="dn-ghe @CssTrangThai(g.TrangThai)">
                            <span class="dn-ghe-so">@g.ThuTu</span>
                            <div class="dn-ghe-ten">
                                <strong>@(g.TenChu ?? "Ghế trống")@(g.LaCuaToi ? " (bạn)" : "")</strong>
                                <small>@g.LoaiHanhKhach, @g.PhaiTra.ToString("N0") VNĐ@(g.TienGiam > 0 ? " (đã giảm " + g.TienGiam.ToString("N0") + ")" : "")@(g.MaCho != null ? ", chỗ " + g.MaCho : "")</small>
                            </div>
                            <span class="dn-nhan">@g.TrangThai</span>
                            @if (g.BiTuChoi && g.ChuaTra)
                            {
                                <span class="dn-nhan dn-tu-choi">Bị từ chối, cần trả lại</span>
                            }
                            @if (g.TruongNhomMoDuoc)
                            {
                                @* Ghế của mình, hoặc ghế không có tài khoản để điền hộ (RB-20: không mở ghế người khác) *@
                                <a asp-action="GheCuaToi" asp-route-id="@g.Id" class="dn-ghe-mo">
                                    @(g.LaCuaToi ? "Ghế của tôi" : !conGiuCho || g.TrangThai is TrangThaiGhe.DaTra or TrangThaiGhe.ChoXacNhan ? "Xem" : g.DaCoChu ? "Sửa" : "Điền hộ")
                                </a>
                            }
                            else if (g.TruongNhomTraHoDuoc && conGiuCho)
                            {
                                <a asp-action="TraHo" asp-route-id="@g.Id" class="dn-ghe-mo">Trả hộ</a>
                            }
                            @if (conGiuCho && (g.DuocMoiRa || (g.ChuaTra && tongGhe > 1)))
                            {
                                @* Thao tác ít dùng gom vào một menu nhỏ để hàng ghế không rối *@
                                <details class="dn-ghe-them">
                                    <summary aria-label="Thao tác khác với ghế @g.ThuTu">Thêm</summary>
                                    <div class="dn-ghe-them-ds">
                                        @if (g.DuocMoiRa)
                                        {
                                            <form asp-action="MoiRaKhoiGhe" asp-route-id="@g.Id" method="post"
                                                  data-xac-nhan-tieu-de="Mời @g.TenChu ra khỏi ghế @g.ThuTu?"
                                                  data-xac-nhan="Thông tin họ đã điền sẽ bị xóa và ghế trở về trống để người khác nhận qua link mời. Bạn nên báo trước cho họ."
                                                  data-xac-nhan-nut="Mời ra khỏi ghế" data-xac-nhan-nguy-hiem>
                                                <button type="submit">Mời ra khỏi ghế</button>
                                            </form>
                                        }
                                        @if (g.ChuaTra && tongGhe > 1)
                                        {
                                            <form asp-action="BotGhe" asp-route-id="@g.Id" method="post"
                                                  data-xac-nhan-tieu-de="Bớt ghế @g.ThuTu khỏi đơn?"
                                                  data-xac-nhan="Đơn sẽ còn @(tongGhe - 1) ghế. Chỗ này trả lại cho lịch để người khác đặt, sau đó không lấy lại được."
                                                  data-xac-nhan-nut="Bớt ghế" data-xac-nhan-nguy-hiem>
                                                <button type="submit" class="nguy-hiem">Bớt ghế này</button>
                                            </form>
                                        }
                                    </div>
                                </details>
                            }
                        </li>
                    }
                </ol>
                <p class="dn-hint">
                    Bạn thấy tên và trạng thái của từng ghế, không thấy giấy tờ của người khác.
                    @if (conGiuCho)
                    {
                        <text>Ghế trẻ nhỏ và người không có tài khoản thì bấm "Điền hộ". Thành viên đã điền xong mà chưa chuyển được thì bạn bấm "Trả hộ".</text>
                    }
                </p>
            </section>

            @if (Model.SoDo != null)
            {
                @* Bản 2D dựng sẵn ở máy chủ; js/so-do-3d.js đổi sang 3D khi trình duyệt chạy được *@
                <section class="dt-block" id="soDoNhom">
                    <div class="dn-tien-do-head">
                        <h2>@(Model.SoDo.LaMayBay ? "Máy bay của nhóm" : "Xe của nhóm")</h2>
                        <span>@Model.SoDo.TenSoDo</span>
                    </div>
                    <div class="dn-3d" hidden aria-hidden="true">
                        <canvas></canvas>
                        <div class="dn-3d-tip" hidden></div>
                    </div>
                    <div class="dn-2d">
                        <p class="dn-2d-dau">@(Model.SoDo.LaMayBay ? "Đầu máy bay" : "Đầu xe")</p>
                        <div class="dn-2d-luoi" style="--so-cot: @Model.SoDo.SoCot">
                            @foreach (var c in Model.SoDo.DsCho)
                            {
                                string moTa = c.Ten != null ? $"{c.Ma}: {c.Ten}, {c.TrangThai}" : c.Loai == "khach-khac" ? $"{c.Ma}: khách ngoài nhóm" : $"{c.Ma}: còn trống";
                                <span class="dn-cho @c.Loai@(c.Ten != null ? " cua-nhom" : "")" style="grid-row: @c.Hang; grid-column: @c.Cot" title="@moTa">@c.Ma</span>
                            }
                        </div>
                    </div>
                    <ul class="dn-chu-giai">
                        <li><i class="dn-cho da-tra"></i>Đã trả</li>
                        <li><i class="dn-cho cho"></i>Chờ xác nhận</li>
                        <li><i class="dn-cho da-dien"></i>Đã điền, chưa trả</li>
                        <li><i class="dn-cho da-nhan"></i>Đã nhận, chưa điền</li>
                        <li><i class="dn-cho trong"></i>Chưa có người nhận</li>
                        <li><i class="dn-cho khach-khac"></i>Khách ngoài nhóm</li>
                        <li><i class="dn-cho con-trong"></i>Còn trống</li>
                    </ul>
                    <p class="dn-hint dn-3d-nhac" hidden>Kéo để xoay. Rê chuột hoặc chạm vào một ghế để xem tên.</p>
                </section>
                <script type="application/json" id="soDoNhomDuLieu">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SoDo))</script>
                <script type="module" src="~/js/so-do-3d.js" asp-append-version="true"></script>
            }
        </div>

        <aside>
            @if (Model.LinkMoi != null && conGiuCho)
            {
                <section class="dt-block dn-moi">
                    <h2>Mời cả nhóm</h2>
                    <p class="dt-note">Còn @soGheTrong ghế chưa có người nhận. Gửi lời mời dưới đây vào nhóm chat của cả đoàn.</p>

                    <blockquote class="dn-loi-moi" id="loiMoi">@loiMoi</blockquote>

                    <div class="dn-nut-moi">
                        <button type="button" class="tv-btn tv-btn-chinh" data-chep="loi-moi">Sao chép lời mời</button>
                        <button type="button" class="tv-btn tv-btn-vien" id="nutChiaSe" hidden>Chia sẻ qua ứng dụng</button>
                    </div>
                    <span class="dn-da-chep" id="daChep" role="status" hidden></span>

                    <div class="dn-link-tho">
                        <span>Chỉ cần link?</span>
                        <button type="button" class="dn-nut-chu" data-chep="link">Sao chép link</button>
                    </div>
                    <input type="hidden" id="linkMoi" value="@Model.LinkMoi" />

                    <form asp-action="DoiLinkMoi" asp-route-id="@don.Id" method="post" class="dn-link-tho"
                          data-xac-nhan-tieu-de="Đổi link mời?"
                          data-xac-nhan="Link cũ sẽ không mở được nữa. Người đã nhận ghế vẫn giữ ghế của mình. Sau khi đổi, bạn gửi lại lời mời mới vào nhóm chat."
                          data-xac-nhan-nut="Tạo link mới">
                        <span>Lỡ gửi link nhầm chỗ?</span>
                        <button type="submit" class="dn-nut-chu">Đổi link mời</button>
                    </form>
                </section>
            }

            <section class="dt-block">
                <h2>Tổng tiền</h2>
                <div class="dt-line"><span>Tổng cả nhóm</span><span>@don.TongTien.ToString("N0") VNĐ</span></div>
                @if (don.SoTienGiam > 0)
                {
                    <div class="dt-line"><span>Khuyến mãi @don.MaKhuyenMai</span><span>-@don.SoTienGiam.ToString("N0") VNĐ</span></div>
                }
                <div class="dt-line"><span>Đã trả</span><span>@Model.DsGhe.Where(g => g.TrangThai == TrangThaiGhe.DaTra).Sum(g => g.PhaiTra).ToString("N0") VNĐ</span></div>
            </section>

            @if (don.TrangThai == "GiuCho")
            {
                int soGheCho = Model.DsGhe.Count(g => g.TrangThai == TrangThaiGhe.ChoXacNhan);
                int soGheChuaTra = Model.DsGhe.Count(g => g.ChuaTra);
                bool coTien = Model.SoGheDaTra > 0 || soGheCho > 0;
                <section class="dt-block">
                    <h2>Chốt hoặc hủy đơn</h2>
                    @if (soGheCho > 0)
                    {
                        <p class="dt-note">Còn @soGheCho ghế đang chờ TravelVN xác nhận tiền. Chốt được sau khi xác nhận xong.</p>
                    }
                    else if (Model.SoGheDaTra == 0)
                    {
                        <p class="dt-note">Chưa ghế nào trả tiền nên chưa chốt được.</p>
                    }
                    else
                    {
                        <p class="dt-note">Chốt ngay thì đi với @Model.SoGheDaTra ghế đã trả@(soGheChuaTra > 0 ? $", {soGheChuaTra} ghế chưa trả sẽ bị nhả" : "").</p>
                        <form asp-action="ChotDon" asp-route-id="@don.Id" method="post"
                              data-xac-nhan-tieu-de="Chốt đơn với @Model.SoGheDaTra ghế đã trả?"
                              data-xac-nhan="@(soGheChuaTra > 0 ? $"{soGheChuaTra} ghế chưa trả sẽ bị nhả và trả chỗ cho lịch. " : "")Sau khi chốt, link mời hết hiệu lực và danh sách đi không đổi được nữa."
                              data-xac-nhan-nut="Chốt đơn" data-xac-nhan-nguy-hiem="@(soGheChuaTra > 0 ? "true" : "false")">
                            <button type="submit" class="tv-btn tv-btn-chinh dn-nut-day">Chốt đơn</button>
                        </form>
                    }

                    @if (coTien)
                    {
                        <p class="dn-hint">Đã có người trả tiền nên không tự hủy đơn được. Cần hủy và hoàn tiền thì liên hệ TravelVN.</p>
                    }
                    else
                    {
                        <form asp-action="HuyDonNhom" asp-route-id="@don.Id" method="post" class="dn-huy-don"
                              data-xac-nhan-tieu-de="Hủy cả đơn nhóm?"
                              data-xac-nhan="Mọi ghế bị nhả, chỗ trả lại cho lịch và link mời hết hiệu lực. Các thành viên đã nhận ghế cũng mất ghế."
                              data-xac-nhan-nut="Hủy đơn" data-xac-nhan-nguy-hiem>
                            <button type="submit" class="tv-btn tv-btn-huy dn-nut-day">Hủy đơn nhóm</button>
                        </form>
                    }
                </section>
            }
        </aside>
    </div>
</div>

<script>
    (function () {
        // Đồng hồ đếm ngược tới hạn giữ chỗ
        var dongHo = document.querySelector("[data-han]");
        if (dongHo) {
            var han = new Date(dongHo.dataset.han).getTime(), o = dongHo.querySelector("[data-dem]");
            var hai = function (n) { return (n < 10 ? "0" : "") + n; };
            var chay = function () {
                var con = Math.max(0, Math.floor((han - Date.now()) / 1000));
                o.textContent = hai(Math.floor(con / 3600)) + ":" + hai(Math.floor(con % 3600 / 60)) + ":" + hai(con % 60);
                dongHo.classList.toggle("sap-het", con < 3600);
            };
            chay();
            setInterval(chay, 1000);
        }


        var loiMoi = document.getElementById("loiMoi"), link = document.getElementById("linkMoi");
        if (!loiMoi) return;
        var baoChep = document.getElementById("daChep");

        // Web host chạy HTTP nên Clipboard API có thể không dùng được hoặc bị từ chối: chép qua ô ẩn
        function chep(chu, thongBao) {
            var xong = function () { baoChep.textContent = thongBao; baoChep.hidden = false; };
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(chu).then(xong, function () { chepQuaO(chu); xong(); });
                return;
            }
            chepQuaO(chu);
            xong();
        }

        function chepQuaO(chu) {
            var o = document.createElement("textarea");
            o.value = chu;
            o.setAttribute("readonly", "");
            o.className = "dn-an";
            document.body.appendChild(o);
            o.select();
            document.execCommand("copy");
            document.body.removeChild(o);
        }

        document.querySelectorAll("[data-chep]").forEach(function (nut) {
            nut.addEventListener("click", function () {
                if (nut.dataset.chep === "link") chep(link.value, "Đã sao chép link.");
                else chep(loiMoi.textContent, "Đã sao chép lời mời, dán vào nhóm chat là xong.");
            });
        });

        // Bảng chia sẻ của điện thoại (Zalo, Messenger...), chỉ có trên HTTPS và trình duyệt hỗ trợ
        var nutChiaSe = document.getElementById("nutChiaSe");
        if (navigator.share) {
            nutChiaSe.hidden = false;
            nutChiaSe.addEventListener("click", function () {
                var chu = loiMoi.textContent.replace(link.value, "").trim();
                navigator.share({ title: document.title, text: chu, url: link.value }).catch(function () { });
            });
        }
    })();
</script>

