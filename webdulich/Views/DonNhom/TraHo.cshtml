@model webdulich.Models.TraHoViewModel
@{
    ViewData["Title"] = "Trả hộ ghế " + Model.ThuTu;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dat-tour.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/don-nhom.css" asp-append-version="true" />
}

<div class="dt-page">
    <a asp-action="ChiTiet" asp-route-id="@Model.DonId" class="dn-quay-lai">
        <svg class="tv-icon" aria-hidden="true"><use href="#i-arrow" /></svg>Trang tiến độ của nhóm
    </a>
    @* Đầu trang là vé của đúng ghế đang trả hộ: thân vé là tour và người giữ ghế, cuống vé là số ghế *@
    <div class="tv-ve tv-ve-ngang dn-ve-dau">
        <div class="dn-ve-dau-than">
            <span class="dn-ve-dau-nhan">Đơn nhóm <span class="tv-ma">@Model.MaChuyenDi</span></span>
            <h1>Trả hộ @(Model.TenChu ?? "ghế " + Model.ThuTu)</h1>
            <p class="dn-ve-dau-mo-ta">@Model.TenTour. Bạn chuyển khoản phần của ghế này thay cho thành viên, rồi tự thu lại với họ.</p>
        </div>
        <div class="tv-ve-duc-lo-doc" aria-hidden="true"></div>
        <div class="dn-ve-dau-cuong">
            <span class="dn-ve-dau-ghe tv-ma">GHẾ @Model.ThuTu.ToString("00")</span>
            <span class="tv-ma-vach" aria-hidden="true"></span>
        </div>
    </div>

    @if (TempData["Loi"] != null)
    {
        <div class="dn-alert loi" role="alert">@TempData["Loi"]</div>
    }

    <div class="dt-layout">
        <div>
            <section class="dt-block">
                <h2>Trước khi trả hộ</h2>
                <ul class="dn-cach">
                    <li>Mỗi ghế có mã QR và nội dung chuyển khoản riêng. Quét đúng mã của ghế này để TravelVN ghi nhận đúng người.</li>
                    <li>Bạn chỉ thấy tên thành viên, không thấy giấy tờ của họ.</li>
                    <li>Sau khi bạn báo đã chuyển, thành viên không sửa được thông tin và không trả lại ghế được nữa.</li>
                </ul>
            </section>
        </div>

        <aside>
            <partial name="_TraTienGhe" model="Model.TraTien" />
        </aside>
    </div>
</div>

