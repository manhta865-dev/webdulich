@model List<webdulich.Models.Video>

@{
    ViewData["Title"] = "Video";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/video.css" asp-append-version="true" />
}

<div class="vd-trang">
    <h1>Video</h1>
    <p class="vd-mo-ta">Xem trước các điểm đến trước khi chọn tour.</p>

    @if (Model.Count == 0)
    {
        <div class="tv-empty">
            <h3>Chưa có video nào</h3>
            <p>Trong lúc chờ, bạn có thể <a asp-controller="DiaDiem" asp-action="DanhSach">xem các tour đang mở</a>.</p>
        </div>
    }
    else
    {
        <div class="vd-luoi">
            @foreach (var video in Model)
            {
                <partial name="_TheVideo" model="video" />
            }
        </div>
    }
</div>

<script src="~/js/video-nhe.js" asp-append-version="true"></script>
