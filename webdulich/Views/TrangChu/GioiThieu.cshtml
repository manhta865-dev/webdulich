<script>
    // Khối hiện dần khi cuộn tới; số liệu đếm lên. Bỏ qua khi người dùng tắt chuyển động hoặc trình duyệt cũ.
    (function () {
        var giam = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (giam || !("IntersectionObserver" in window)) return;
        document.documentElement.classList.add("gt-co-hieu-ung");
        var quan = new IntersectionObserver(function (ds) {
            ds.forEach(function (m) {
                if (!m.isIntersecting) return;
                m.target.classList.add("da-hien");
                quan.unobserve(m.target);
            });
        }, { rootMargin: "0px 0px -10% 0px" });
        document.querySelectorAll(".gt-hien").forEach(function (k) { quan.observe(k); });

        document.querySelectorAll("[data-dem]").forEach(function (el) {
            var dich = parseInt(el.dataset.dem, 10);
            if (!(dich > 0)) return;
            var batDau = null;
            el.textContent = "0";
            function buoc(t) {
                if (batDau === null) batDau = t;
                var p = Math.min((t - batDau) / 900, 1);
                el.textContent = Math.round(dich * (1 - Math.pow(1 - p, 3))).toLocaleString("vi-VN");
                if (p < 1) requestAnimationFrame(buoc);
            }
            requestAnimationFrame(buoc);
            // Tab chạy nền thì trình duyệt dừng requestAnimationFrame: vẫn hiện đúng số cuối
            setTimeout(function () { el.textContent = dich.toLocaleString("vi-VN"); }, 1500);
        });
    })();
</script>
