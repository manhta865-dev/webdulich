                        <p class="section-desc">Sao chép mã voucher và áp dụng trực tiếp tại bước thanh toán để nhận mức chiết khấu tốt nhất.</p>
                    </div>
                </div>

                <div class="promo-slider-wrap">
                    <div class="promo-slider">
                        @foreach (var km in khuyenMais)
                        {
                            <div class="promo-card-home" style="background: linear-gradient(135deg, @km.MauNen, #1e1b4b);">
                                <div class="promo-card-top">
                                    <span class="promo-badge-mini">TravelVN Voucher</span>
                                    <h3>@km.TenKhuyenMai</h3>
                                    <p>@(string.IsNullOrWhiteSpace(km.MoTa) ? $"Giảm {km.GiaTriHienThi} khi đặt tour." : km.MoTa)</p>
                                </div>
                                <div class="promo-card-bottom">
                                    <span class="promo-code-pill">@km.MaKhuyenMai</span>
                                    <button type="button" class="promo-copy-btn" onclick="copyPromoCode('@km.MaKhuyenMai')">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                                        Sao chép mã
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <div id="promoToast" class="promo-toast">Đã sao chép mã khuyến mãi</div>

            <script>
                function copyPromoCode(code) {
                    if (navigator.clipboard && window.isSecureContext) {
                        navigator.clipboard.writeText(code).then(function () {
                            showPromoToast(code);
                        });
                    } else {
                        const textArea = document.createElement("textarea");
                        textArea.value = code;
                        textArea.style.position = "fixed";
                        textArea.style.left = "-999999px";
                        document.body.appendChild(textArea);
                        textArea.focus();
                        textArea.select();
                        try {
                            document.execCommand('copy');
                            showPromoToast(code);
                        } catch (err) {
                            alert("Không thể copy mã");
                        }
                        document.body.removeChild(textArea);
                    }
                }

                function showPromoToast(code) {
                    const toast = document.getElementById("promoToast");
                    if (!toast) return;
                    toast.textContent = "Đã sao chép mã: " + code;
                    toast.classList.add("show");
                    setTimeout(function () {
                        toast.classList.remove("show");
                    }, 1800);
                }
            </script>
        }

