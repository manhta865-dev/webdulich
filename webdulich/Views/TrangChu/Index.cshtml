<script>
    // Dải tour xếp quạt: thẻ giữa nằm thẳng, hai thẻ bên nghiêng ra sau; cuống vé ở tấm vé lớn đổi theo thẻ giữa
    (function () {
        var xap = document.getElementById("tcXap");
        if (!xap) return;
        var the = xap.querySelectorAll(".tc-xap-the");
        var cuong = document.getElementById("tcCuong");
        var hienTai = 0, timer = null, daBamTay = false;

        function doiCuong(a) {
            if (!cuong) return;
            cuong.href = a.href;
            cuong.querySelector('[data-cuong="anh"]').src = a.dataset.anh;
            cuong.querySelector('[data-cuong="ten"]').textContent = a.dataset.ten;
            cuong.querySelector('[data-cuong="gia"]').textContent = a.dataset.gia;
            var ngay = cuong.querySelector('[data-cuong="ngay"]');
            ngay.hidden = !a.dataset.ngay;
            ngay.textContent = a.dataset.ngay + " ngày";
        }

        function hien(n) {
            var dem = the.length;
            hienTai = (n + dem) % dem;
            the.forEach(function (a, k) {
                var lech = (k - hienTai + dem) % dem;
                if (lech > dem / 2) lech -= dem;
                a.dataset.vt = Math.abs(lech) <= 1 ? String(lech) : "an";
                a.tabIndex = lech === 0 ? 0 : -1;
            });
            doiCuong(the[hienTai]);
        }

        function chay() {
            if (timer || daBamTay || the.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            timer = setInterval(function () { hien(hienTai + 1); }, 5000);
        }
        function dung() { clearInterval(timer); timer = null; }

        xap.querySelectorAll("[data-xap]").forEach(function (nut) {
            nut.addEventListener("click", function () {
                daBamTay = true; dung();
                hien(hienTai + Number(nut.dataset.xap));
            });
        });
        // Bấm thẻ nghiêng bên cạnh thì đưa nó ra giữa thay vì mở trang tour
        the.forEach(function (a, k) {
            a.addEventListener("click", function (e) {
                if (k !== hienTai) { e.preventDefault(); daBamTay = true; dung(); hien(k); }
            });
        });
        xap.addEventListener("mouseenter", dung);
        xap.addEventListener("mouseleave", chay);
        xap.addEventListener("focusin", dung);

        // Rê chuột vào một ảnh (kể cả ảnh nghiêng phía sau) thì ảnh trồi lên, rồi nghiêng theo con trỏ
        // và có vệt sáng chạy theo, giống tấm vé ở trang Ghế của tôi (ve-lat.js). Điện thoại và người chọn giảm chuyển động thì bỏ qua.
        if (window.matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
            the.forEach(function (a) {
                a.addEventListener("pointerenter", function () { a.classList.add("dang-tro"); });
                a.addEventListener("pointermove", function (e) {
                    var k = a.getBoundingClientRect();
                    var x = (e.clientX - k.left) / k.width - 0.5;
                    var y = (e.clientY - k.top) / k.height - 0.5;
                    a.classList.add("dang-nghieng");
                    a.style.setProperty("--rx", (-y * 14).toFixed(2) + "deg");
                    a.style.setProperty("--ry", (x * 16).toFixed(2) + "deg");
                    a.style.setProperty("--mx", Math.round((x + 0.5) * 100) + "%");
                    a.style.setProperty("--my", Math.round((y + 0.5) * 100) + "%");
                });
                a.addEventListener("pointerleave", function () {
                    a.classList.remove("dang-tro", "dang-nghieng");
                    a.style.removeProperty("--rx");
                    a.style.removeProperty("--ry");
                });
            });
        }

        hien(0);
        chay();
    })();

    // Lọc tour trong nước / nước ngoài
    (function () {
        var nut = document.querySelectorAll(".tc-loc [data-loc]");
        var o = document.querySelectorAll("#tcLuoiTour .tc-o-tour");
        nut.forEach(function (b) {
            b.addEventListener("click", function () {
                nut.forEach(function (x) {
                    x.classList.toggle("active", x === b);
                    x.setAttribute("aria-pressed", x === b ? "true" : "false");
                });
                o.forEach(function (the) {
                    the.hidden = !!b.dataset.loc && the.dataset.nhom !== b.dataset.loc;
                });
            });
        });
    })();

    // Khối bảng ghế: khi cuộn tới thì đóng mộc lên từng vé ghế, lần lượt từ trên xuống (một lần)
    (function () {
        var hinh = document.querySelector(".home-nhom-hinh");
        if (!hinh || !("IntersectionObserver" in window)
            || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        hinh.classList.add("cho-dong");
        var quanSat = new IntersectionObserver(function (muc) {
            if (!muc[0].isIntersecting) return;
            quanSat.disconnect();
            hinh.querySelectorAll(".tv-moc").forEach(function (moc, k) {
                moc.style.animationDelay = (k * 180) + "ms";
                moc.classList.add("tv-moc-dong");
            });
        }, { threshold: 0.5 });
        quanSat.observe(hinh);
    })();
</script>

@if (khuyenMais.Any())
{
    <script>
        function copyPromoCode(code) {
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(code).then(function () {
                    showPromoToast(code);
                });
            } else {
                const textArea = document.createElement("textarea");
                textArea.value = code;
                textArea.style.position = "fixed";
                textArea.style.left = "-999999px";
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                try {
                    document.execCommand('copy');
                    showPromoToast(code);
                } catch (err) {
                    showPromoToast(code, "Chưa sao chép được, bạn hãy tự chép mã: ");
                }
                document.body.removeChild(textArea);
            }
        }

        function showPromoToast(code, loiNhan) {
            const toast = document.getElementById("promoToast");
            if (!toast) return;
            toast.textContent = (loiNhan || "Đã sao chép mã: ") + code;
            toast.classList.add("show");
            setTimeout(function () {
                toast.classList.remove("show");
            }, 1800);
        }
    </script>
}
