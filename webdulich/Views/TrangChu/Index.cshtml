@using Microsoft.AspNetCore.Http
@model List<webdulich.Models.Tour>
@{
    ViewData["Title"] = "Trang chủ";
    var khuyenMais = ViewBag.KhuyenMais as List<webdulich.Models.KhuyenMai> ?? new List<webdulich.Models.KhuyenMai>();

    // Tour trong nước và nước ngoài do TrangChuController đã chuẩn bị sẵn (tối đa 6 tour mỗi nhóm).
    var tourTrongNuoc = ViewBag.TourTrongNuoc as List<webdulich.Models.Tour> ?? new List<webdulich.Models.Tour>();
    var tourNgoaiNuoc = ViewBag.TourNgoaiNuoc as List<webdulich.Models.Tour> ?? new List<webdulich.Models.Tour>();
    var coNhomTour = tourTrongNuoc.Any() || tourNgoaiNuoc.Any();
    var dsVideo = ViewBag.Videos as List<webdulich.Models.Video> ?? new List<webdulich.Models.Video>();
    var dsBaiViet = ViewBag.BaiViets as List<webdulich.Models.BaiViet> ?? new List<webdulich.Models.BaiViet>();

    // Điểm đến ở phần đầu trang. Ảnh lấy trong wwwroot/images/dulich, chỉ dùng ảnh đủ nét để phủ kín màn hình.
    var diemDens = new[]
    {
        new { Ten = "Hạ Long", Vung = "Miền Bắc", Anh = "halong.jpg", MoTa = "Vịnh có hàng nghìn đảo đá vôi nhô lên từ mặt nước xanh, nổi tiếng với các chuyến du thuyền." },
        new { Ten = "Đà Lạt", Vung = "Tây Nguyên", Anh = "dalat1.jpg", MoTa = "Thành phố cao nguyên mát mẻ quanh năm, có đồi thông, hồ nước và những vườn hoa." },
        new { Ten = "Đà Nẵng", Vung = "Miền Trung", Anh = "danang.jpg", MoTa = "Thành phố biển có bãi cát dài, cầu Vàng ở Bà Nà và nhiều món ăn địa phương." },
        new { Ten = "Phú Quốc", Vung = "Miền Nam", Anh = "phuquoc.jpg", MoTa = "Hòn đảo lớn nhất Việt Nam, có biển trong, bãi cát trắng và các điểm lặn ngắm san hô." },
        new { Ten = "Nha Trang", Vung = "Miền Trung", Anh = "nhatrang.jpg", MoTa = "Thành phố biển có vịnh nước xanh, các đảo gần bờ và nhiều khu vui chơi ven biển." }
    };
}

@section TimKiemMenu {
    <form method="get" asp-controller="DiaDiem" asp-action="DanhSach" class="tv-nav-tim" role="search">
        <svg class="tv-icon" aria-hidden="true"><use href="#i-compass" /></svg>
        <input type="text" name="keyword" placeholder="Bạn muốn đi đâu? Ví dụ Đà Lạt, Phú Quốc" aria-label="Điểm đến" />
        <button type="submit">Tìm tour</button>
    </form>
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/don-nhom.css" asp-append-version="true" />
    @if (dsVideo.Count > 0)
    {
        <link rel="stylesheet" href="~/css/video.css" asp-append-version="true" />
    }
    @if (dsBaiViet.Count > 0)
    {
        <link rel="stylesheet" href="~/css/bai-viet.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/trang-chu.css" asp-append-version="true" />
}

<section class="hero" id="hero" aria-roledescription="carousel" aria-label="Điểm đến nổi tiếng">
    <h1 class="visually-hidden">Tìm chuyến đi tiếp theo của bạn</h1>

    @for (var i = 0; i < diemDens.Length; i++)
    {
        var d = diemDens[i];
        <div class="hero-slide@(i == 0 ? " is-active" : "")">
            <img src="~/images/dulich/@d.Anh" alt="Ảnh @d.Ten"
                 loading="@(i == 0 ? "eager" : "lazy")" fetchpriority="@(i == 0 ? "high" : "auto")" />
            <div class="hero-text">
                <span class="hero-place">
                    <svg class="tv-icon" aria-hidden="true"><use href="#i-pin" /></svg>
                    @d.Vung, Việt Nam
                </span>
                <h2 class="hero-title">@d.Ten</h2>
                <p class="hero-desc">@d.MoTa</p>
                <a asp-controller="DiaDiem" asp-action="DanhSach" asp-route-keyword="@d.Ten" class="tv-btn tv-btn-sang">Xem tour @d.Ten</a>
            </div>
        </div>
    }

    <div id="hero-globe" class="hero-globe" data-tour="@Url.Action("DanhSach", "DiaDiem")"
         data-diem="@System.Text.Json.JsonSerializer.Serialize(ViewBag.DiemQuaDiaCau)">
        <canvas aria-hidden="true"></canvas>
        <a class="hero-globe-label" href="#" tabindex="-1">Việt Nam</a>
    </div>

    @* Màn hình nhỏ: ô tìm kiếm nằm trong ảnh lớn. Màn hình rộng: ô tìm kiếm nằm trên thanh menu (section TimKiemMenu) *@
    <form method="get" asp-controller="DiaDiem" asp-action="DanhSach" class="hero-search home-search">
        <input type="text" name="keyword" placeholder="Bạn muốn đi đâu? Ví dụ Đà Lạt, Phú Quốc" aria-label="Điểm đến" />
        <button type="submit" class="tv-btn tv-btn-chinh">Tìm tour</button>
    </form>

    <div class="hero-thumbs">
        @for (var i = 0; i < diemDens.Length; i++)
        {
            var d = diemDens[i];
            <button type="button" class="hero-thumb@(i == 0 ? " is-active" : "")" aria-label="Xem @d.Ten" aria-current="@(i == 0 ? "true" : "false")">
                <img src="~/images/dulich/@d.Anh" alt="" loading="lazy" />
                <span><small>@d.Vung</small>@d.Ten</span>
            </button>
        }
    </div>
</section>

<div class="home-wrap">
    @if (khuyenMais.Any())
    {
        <section class="tv-section">
            <div class="tv-section-head">
                <div>
                    <h2>Mã giảm giá đang áp dụng</h2>
                    <p>Sao chép mã và nhập ở bước thanh toán.</p>
                </div>
            </div>

            <div class="promo-list">
                @foreach (var km in khuyenMais)
                {
                    <div class="promo-card" style="border-left-color: @km.MauNen">
                        <h3>@km.TenKhuyenMai</h3>
                        <p>@(string.IsNullOrWhiteSpace(km.MoTa) ? $"Giảm {km.GiaTriHienThi} khi đặt tour." : km.MoTa)</p>
                        <div class="promo-foot">
                            <span class="promo-code">@km.MaKhuyenMai</span>
                            <button type="button" class="tv-btn tv-btn-vien" onclick="copyPromoCode('@km.MaKhuyenMai')">Sao chép mã</button>
                        </div>
                    </div>
                }
            </div>
        </section>

        <div id="promoToast" class="promo-toast" role="status">Đã sao chép mã khuyến mãi</div>
    }

    @if (coNhomTour)
    {
        if (tourTrongNuoc.Any())
        {
            <section class="tv-section">
                <div class="tv-section-head">
                    <div>
                        <h2>Tour trong nước</h2>
                        <p>Chọn một tour để xem lịch trình và các ngày khởi hành.</p>
                    </div>
                    <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-link tv-link-di">Xem tất cả tour</a>
                </div>
                <div class="tv-grid-photo">
                    @foreach (var item in tourTrongNuoc)
                    {
                        <partial name="_TheTour" model="item" />
                    }
                </div>
            </section>
        }

        if (tourNgoaiNuoc.Any())
        {
            <section class="tv-section">
                <div class="tv-section-head">
                    <div>
                        <h2>Tour nước ngoài</h2>
                    </div>
                    <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-link tv-link-di">Xem tất cả tour</a>
                </div>
                <div class="tv-grid-photo">
                    @foreach (var item in tourNgoaiNuoc)
                    {
                        <partial name="_TheTour" model="item" />
                    }
                </div>
            </section>
        }
    }
    else
    {
        <section class="tv-section">
            <div class="tv-section-head">
                <div>
                    <h2>Một số tour để bắt đầu</h2>
                    <p>Chọn một tour để xem lịch trình và các ngày khởi hành.</p>
                </div>
                <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-link tv-link-di">Xem tất cả tour</a>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="tv-grid-photo">
                    @foreach (var item in Model)
                    {
                        <partial name="_TheTour" model="item" />
                    }
                </div>
            }
            else
            {
                <div class="tv-empty">
                    <h3>Chưa có tour để hiển thị</h3>
                    <p>Vui lòng quay lại sau.</p>
                </div>
            }
        </section>
    }

    @* Tính năng chính của web: đặt theo nhóm. Hình xe là minh họa, không phải số liệu thật *@
    <section class="tv-section home-nhom">
        <div class="home-nhom-chu">
            <h2>Đi cùng nhóm, mỗi người tự trả phần mình</h2>
            <p>Không phải đứng ra thu tiền và gom giấy tờ của cả nhóm nữa.</p>
            <ol class="home-nhom-buoc">
                <li>Một người giữ chỗ và gửi link mời vào nhóm chat.</li>
                <li>Mỗi thành viên nhận một ghế, tự điền thông tin và chuyển khoản phần của mình.</li>
                <li>Cả nhóm trả đủ trước hạn là xong. Trưởng nhóm thấy ai đã trả, không thấy giấy tờ của người khác.</li>
            </ol>
            <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-btn tv-btn-chinh">Chọn tour để đặt cho nhóm</a>
        </div>
        <figure class="home-nhom-hinh" aria-hidden="true">
            <figcaption>Hình minh họa: 3 trên 5 ghế đã trả</figcaption>
            <div class="dn-duong" style="--tien: 60">
                <div class="dn-duong-nen"><span class="dn-duong-da-di"></span></div>
                <div class="dn-duong-moc">
                    <span class="qua" style="left: 20%"></span>
                    <span class="qua" style="left: 40%"></span>
                    <span class="qua" style="left: 60%"></span>
                    <span style="left: 80%"></span>
                </div>
                <svg class="dn-duong-co" viewBox="0 0 24 40">
                    <path d="M5 38V4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                    <path d="M6 5h15l-4 6 4 6H6z" fill="currentColor" />
                </svg>
                <svg class="dn-duong-xe" viewBox="0 0 56 34">
                    <rect x="2" y="3" width="52" height="24" rx="6" fill="currentColor" />
                    <path d="M8 8h9v8H8zM20 8h9v8h-9zM32 8h9v8h-9z" fill="#FFFFFF" />
                    <path d="M44 8h6a2 2 0 0 1 2 2v6h-8z" fill="#FFFFFF" />
                    <circle cx="15" cy="28" r="5" fill="#17262E" />
                    <circle cx="41" cy="28" r="5" fill="#17262E" />
                    <circle cx="15" cy="28" r="2" fill="#FFFFFF" />
                    <circle cx="41" cy="28" r="2" fill="#FFFFFF" />
                </svg>
            </div>
            <ul class="home-nhom-ghe">
                <li class="da-tra">Ghế 1<span>Đã trả</span></li>
                <li class="da-tra">Ghế 2<span>Đã trả</span></li>
                <li class="da-tra">Ghế 3<span>Đã trả</span></li>
                <li class="cho">Ghế 4<span>Chờ xác nhận</span></li>
                <li>Ghế 5<span>Chưa trả</span></li>
            </ul>
        </figure>
    </section>

</div>

@if (dsVideo.Count > 0)
{
    var videoChinh = dsVideo[0];
    @* Dải tối tràn bề ngang: video đầu tự chạy không tiếng khi cuộn tới (js/video-nen.js), các video sau xếp bên dưới *@
    <section class="home-dai-video" aria-labelledby="tieuDeVideo">
        <div class="home-dai-video-trong">
            <div class="home-dai-video-dau">
                <h2 id="tieuDeVideo">Xem trước chuyến đi</h2>
                <a asp-controller="Video" asp-action="Index" class="home-dai-video-link">Xem tất cả video</a>
            </div>
            <div class="home-video-lon" data-video-nen="@videoChinh.MaYouTube">
                <img src="@videoChinh.AnhXemTruoc" alt="" loading="lazy" referrerpolicy="no-referrer" />
                <div class="home-video-lon-chu">
                    <h3>@videoChinh.TieuDe</h3>
                    <a href="@videoChinh.LinkXem" target="_blank" rel="noopener" class="tv-btn tv-btn-sang" data-video-bat-tieng>Xem có tiếng</a>
                </div>
            </div>
            @if (dsVideo.Count > 1)
            {
                <div class="home-video-con">
                    @foreach (var video in dsVideo.Skip(1))
                    {
                        <partial name="_TheVideo" model="video" />
                    }
                </div>
            }
        </div>
    </section>
}

<div class="home-wrap">
    @if (dsBaiViet.Count > 0)
    {
        <section class="tv-section">
            <div class="tv-section-head">
                <div>
                    <h2>Bài viết mới</h2>
                </div>
                <a asp-controller="BaiViet" asp-action="Index" class="tv-link tv-link-di">Xem tất cả bài viết</a>
            </div>
            <div class="bv-luoi">
                @foreach (var bai in dsBaiViet)
                {
                    <a href="/BaiViet/@bai.DuongDan" class="bv-the">
                        <div class="bv-anh">
                            @if (!string.IsNullOrEmpty(bai.AnhBia))
                            {
                                <img src="~/images/baiviet/@bai.AnhBia" alt="" loading="lazy" />
                            }
                        </div>
                        <time>@bai.NgayDang?.ToString("dd/MM/yyyy")</time>
                        <h3>@bai.TieuDe</h3>
                        <p>@bai.TomTat</p>
                    </a>
                }
            </div>
        </section>
    }
</div>

<section class="home-band">
    <div class="home-band-inner">
        <h2>Đặt tour qua ba bước</h2>
        <ol class="band-steps">
            <li>
                <strong>Chọn tour</strong>
                <span>Tìm theo điểm đến hoặc để web gợi ý theo sở thích của bạn.</span>
            </li>
            <li>
                <strong>Chọn ngày khởi hành</strong>
                <span>Xem ngày còn chỗ, nhập số người và thông tin hành khách.</span>
            </li>
            <li>
                <strong>Thanh toán</strong>
                <span>Kiểm tra giá, nhập mã giảm giá nếu có và hoàn tất đơn.</span>
            </li>
        </ol>
        <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-btn tv-btn-sang">Bắt đầu chọn tour</a>
    </div>
</section>

<script type="module" src="~/js/hero-3d.js" asp-append-version="true"></script>
@if (dsVideo.Count > 0)
{
    <script src="~/js/video-nhe.js" asp-append-version="true"></script>
    <script src="~/js/video-nen.js" asp-append-version="true"></script>
}

<script>
    (function () {
        var hero = document.getElementById("hero");
        if (!hero) return;

        var slides = hero.querySelectorAll(".hero-slide");
        var thumbs = hero.querySelectorAll(".hero-thumb");
        var hienTai = 0;
        var timer = null;
        var daBamTay = false;

        function hien(n) {
            hienTai = (n + slides.length) % slides.length;
            slides.forEach(function (s, k) { s.classList.toggle("is-active", k === hienTai); });
            thumbs.forEach(function (t, k) {
                t.classList.toggle("is-active", k === hienTai);
                t.setAttribute("aria-current", k === hienTai ? "true" : "false");
            });
        }

        function chay() {
            if (timer || daBamTay || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            timer = setInterval(function () { hien(hienTai + 1); }, 6000);
        }

        function dung() {
            clearInterval(timer);
            timer = null;
        }

        thumbs.forEach(function (t, k) {
            t.addEventListener("click", function () {
                daBamTay = true;
                dung();
                hien(k);
            });
        });

        hero.addEventListener("mouseenter", dung);
        hero.addEventListener("mouseleave", chay);
        hero.addEventListener("focusin", dung);
        hero.addEventListener("focusout", chay);
        chay();
    })();
</script>

@if (khuyenMais.Any())
{
    <script>
        function copyPromoCode(code) {
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(code).then(function () {
                    showPromoToast(code);
                });
            } else {
                const textArea = document.createElement("textarea");
                textArea.value = code;
                textArea.style.position = "fixed";
                textArea.style.left = "-999999px";
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                try {
                    document.execCommand('copy');
                    showPromoToast(code);
                } catch (err) {
                    alert("Không thể sao chép mã. Bạn hãy chọn mã và sao chép thủ công.");
                }
                document.body.removeChild(textArea);
            }
        }

        function showPromoToast(code) {
            const toast = document.getElementById("promoToast");
            if (!toast) return;
            toast.textContent = "Đã sao chép mã: " + code;
            toast.classList.add("show");
            setTimeout(function () {
                toast.classList.remove("show");
            }, 1800);
        }
    </script>
}