        @{
            var khuyenMais = ViewBag.KhuyenMais as List<webdulich.Models.KhuyenMai> ?? new List<webdulich.Models.KhuyenMai>();
        }

        @if (khuyenMais.Any())
        {
            <section class="promo-home-section">
                <div class="section-head">
                    <div>
                        <div class="section-kicker">Đặc quyền thành viên</div>
