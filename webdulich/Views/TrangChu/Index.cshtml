@using Microsoft.AspNetCore.Http
@model List<webdulich.Models.Tour>
@{
    ViewData["Title"] = "Trang chủ";
    var khuyenMais = ViewBag.KhuyenMais as List<webdulich.Models.KhuyenMai> ?? new List<webdulich.Models.KhuyenMai>();

    // Tour trong nước và nước ngoài do TrangChuController đã chuẩn bị sẵn (tối đa 6 tour mỗi nhóm).
    var tourTrongNuoc = ViewBag.TourTrongNuoc as List<webdulich.Models.Tour> ?? new List<webdulich.Models.Tour>();
    var tourNgoaiNuoc = ViewBag.TourNgoaiNuoc as List<webdulich.Models.Tour> ?? new List<webdulich.Models.Tour>();
    var dsVideo = ViewBag.Videos as List<webdulich.Models.Video> ?? new List<webdulich.Models.Video>();
    var dsBaiViet = ViewBag.BaiViets as List<webdulich.Models.BaiViet> ?? new List<webdulich.Models.BaiViet>();
    int soGio = ViewBag.SoGioGiuCho ?? 24;

    // Mọi tour hiện ở trang chủ, kèm nhóm để lọc (trong nước / nước ngoài). Chưa phân nhóm thì dùng 3 tour mặc định.
    var dsTour = tourTrongNuoc.Select(t => (Tour: t, Nhom: "trong"))
        .Concat(tourNgoaiNuoc.Select(t => (Tour: t, Nhom: "ngoai")))
        .ToList();
    if (!dsTour.Any() && Model != null)
    {
        dsTour = Model.Select(t => (Tour: t, Nhom: "")).ToList();
    }

    // Tour xếp quạt ở đầu trang (tối đa 6), tour đầu tiên in lên cuống vé
    var tourXap = dsTour.Select(x => x.Tour).Take(6).ToList();
    var tourCuong = tourXap.FirstOrDefault();

    // Điểm đến lấy từ chính các tour đang bán: tên, ảnh của tour đầu tiên, số tour
    var diemDen = dsTour.Select(x => x.Tour)
        .Where(t => !string.IsNullOrWhiteSpace(t.TenDiaDiemHienThi) && t.TenDiaDiemHienThi != "Chưa cập nhật")
        .GroupBy(t => t.TenDiaDiemHienThi.Trim().ToLower())
        .Select(g => (Ten: g.First().TenDiaDiemHienThi.Trim(), Anh: g.First().HinhAnh, SoTour: g.Count()))
        .ToList();

    string GiaTu(webdulich.Models.Tour t) => t.Gia.ToString("N0") + " VNĐ";
}

@section TimKiemMenu {
    <form method="get" asp-controller="DiaDiem" asp-action="DanhSach" class="tv-nav-tim" role="search">
        <svg class="tv-icon" aria-hidden="true"><use href="#i-compass" /></svg>
        <input type="text" name="keyword" placeholder="Bạn muốn đi đâu? Ví dụ Đà Lạt, Phú Quốc" aria-label="Điểm đến" />
        <button type="submit">Tìm tour</button>
    </form>
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/don-nhom.css" asp-append-version="true" />
    @if (dsVideo.Count > 0)
    {
        <link rel="stylesheet" href="~/css/video.css" asp-append-version="true" />
    }
    @if (dsBaiViet.Count > 0)
    {
        <link rel="stylesheet" href="~/css/bai-viet.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/trang-chu.css" asp-append-version="true" />
}

@* ===== 1. Đầu trang: vé chính, cuống vé tách được, tour xếp quạt và hàng điểm đến trên một hàng ===== *@
<section class="tc-dau">
    <div class="tc-trong">
        <div class="tc-dau-hang">
        @* Vé chính và cuống vé là hai mảnh liền nhau; rê chuột (hoặc dùng phím Tab) vào vé thì cuống tách ra như bị xé *@
        <div class="tc-ve-bo">
        <div class="tv-ve tc-ve">
            <div class="tc-ve-than">
                <div class="tc-ve-dau tv-ma">
                    <span><svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg> TRAVELVN</span>
                    <span>VÉ ĐI NHÓM</span>
                </div>
                <div class="tc-ve-tuyen tv-ma" aria-hidden="true">
                    <span>NHÓM CỦA BẠN</span>
                    <span class="tc-ve-tuyen-giua"><svg class="tv-icon"><use href="#i-plane" /></svg></span>
                    <span>CHUYẾN ĐI TIẾP THEO</span>
                </div>

                <h1 class="tc-ve-tieu-de">Đi cùng nhóm, mỗi người tự trả phần mình</h1>
                <p class="tc-ve-mo-ta">Một người giữ chỗ và gửi link mời. Mỗi thành viên tự nhận ghế, tự điền thông tin và chuyển khoản phần của mình. Ai đã trả, còn bao lâu, cả nhóm cùng thấy.</p>

                <ul class="tc-ve-nhan">
                    <li><svg class="tv-icon" aria-hidden="true"><use href="#i-clock" /></svg>Giữ chỗ @soGio giờ</li>
                    <li><svg class="tv-icon" aria-hidden="true"><use href="#i-send" /></svg>Link mời vào nhóm chat</li>
                    <li><svg class="tv-icon" aria-hidden="true"><use href="#i-bank" /></svg>Chuyển khoản bằng mã QR</li>
                    <li><svg class="tv-icon" aria-hidden="true"><use href="#i-check" /></svg>Biết ngay ai đã trả</li>
                </ul>

                @* Màn hình rộng có ô tìm kiếm trên thanh menu (section TimKiemMenu) nên ô này ẩn đi *@
                <form method="get" asp-controller="DiaDiem" asp-action="DanhSach" class="tc-tim" role="search">
                    <input type="text" name="keyword" placeholder="Bạn muốn đi đâu? Ví dụ Đà Lạt" aria-label="Điểm đến" />
                    <button type="submit" class="tv-btn tv-btn-chinh">Tìm tour</button>
                </form>

                <div class="tc-ve-nut">
                    <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-btn tv-btn-chinh">Chọn tour</a>
                    <a href="#dat-nhom" class="tv-btn tv-btn-vien">Xem cách đặt nhóm</a>
                </div>
            </div>

        </div>

            @* Cuống vé: tour đang ở giữa dải xếp quạt bên cạnh (script cuối trang đổi theo) *@
            @if (tourCuong != null)
            {
                <a class="tc-ve-cuong" id="tcCuong" href="@Url.Action("ChiTiet", "DiaDiem", new { id = tourCuong.Id })">
                    <span class="tc-ve-cuong-dau tv-ma"><svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg> CUỐNG VÉ</span>
                    <span class="tc-ve-cuong-anh">
                        <img src="~/images/dulich/@tourCuong.HinhAnh" alt="" data-cuong="anh" />
                        <span class="tv-pill-tren" data-cuong="ngay" @(tourCuong.SoNgay.HasValue ? "" : "hidden")>@(tourCuong.SoNgay) ngày</span>
                    </span>
                    <span class="tc-ve-cuong-ten" data-cuong="ten">@tourCuong.TenTour</span>
                    <span class="tc-ve-cuong-gia">Từ <strong data-cuong="gia">@GiaTu(tourCuong)</strong></span>
                    <span class="tv-ma-vach" aria-hidden="true"></span>
                </a>
            }
        </div>

        <div class="tc-dau-phai">
            @if (tourXap.Any())
            {
                <div class="tc-xap" id="tcXap" aria-roledescription="carousel" aria-label="Một số tour đang bán">
                    <div class="tc-xap-khung">
                        @for (var i = 0; i < tourXap.Count; i++)
                        {
                            var t = tourXap[i];
                            <a class="tc-xap-the" href="@Url.Action("ChiTiet", "DiaDiem", new { id = t.Id })"
                               data-ten="@t.TenTour" data-gia="@GiaTu(t)" data-ngay="@t.SoNgay"
                               data-anh="@Url.Content("~/images/dulich/" + t.HinhAnh)"
                               aria-label="@t.TenTour">
                                <img src="~/images/dulich/@t.HinhAnh" alt="" loading="@(i < 3 ? "eager" : "lazy")" />
                                <span>@t.TenTour</span>
                            </a>
                        }
                    </div>
                    @if (tourXap.Count > 1)
                    {
                        <div class="tc-xap-nut">
                            <button type="button" data-xap="-1" aria-label="Tour trước"><svg class="tv-icon tc-lat" aria-hidden="true"><use href="#i-arrow" /></svg></button>
                            <button type="button" data-xap="1" aria-label="Tour sau"><svg class="tv-icon" aria-hidden="true"><use href="#i-arrow" /></svg></button>
                        </div>
                    }
                </div>
            }

        @if (diemDen.Any())
        {
            <nav class="tc-diem" aria-label="Điểm đến">
                @foreach (var d in diemDen)
                {
                    <a asp-controller="DiaDiem" asp-action="DanhSach" asp-route-keyword="@d.Ten">
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-pin" /></svg>@d.Ten
                    </a>
                }
            </nav>
        }
        </div>
        </div>
    </div>
</section>

<div class="home-wrap">
    @* ===== 2. Sáu lý do chọn TravelVN: thẻ ảnh có cuống vé, rê chuột thì thẻ nhấc lên, cuống đổi màu và nghiêng.
         Mỗi câu là điều web đang làm thật (cùng nội dung mục Cam kết ở trang Giới thiệu); ảnh minh họa lấy từ Unsplash,
         lưu ở wwwroot/images/ly-do, nguồn và giấy phép ghi ở docs/NGUON_ANH.md ===== *@
    @{
        var lyDo = new[]
        {
            new { Anh = "ly-do-gia.jpg", Icon = "i-receipt", Ten = "Giá rõ ràng theo từng lịch", MoTa = "Giá hiện theo đúng lịch khởi hành bạn chọn, mỗi ghế một phần.", GhiChu = "Khuyến mãi trừ thẳng vào phần của từng người", Moc = "" },
            new { Anh = "ly-do-giay-to.jpg", Icon = "i-users", Ten = "Giấy tờ riêng tư", MoTa = "Số giấy tờ chỉ bạn và TravelVN xem được.", GhiChu = "Trưởng nhóm không thấy, hướng dẫn viên chỉ thấy vài số cuối", Moc = "" },
            new { Anh = "ly-do-doi-chieu.jpg", Icon = "i-bank", Ten = "Đối chiếu từng khoản", MoTa = "Mỗi ghế có nội dung chuyển khoản riêng nên tiền của ai vào đúng ghế người đó.", GhiChu = "Nhân viên đối chiếu sao kê rồi mới xác nhận ghế", Moc = "Đã trả" },
            new { Anh = "ly-do-han-chot.jpg", Icon = "i-clock", Ten = "Hạn chốt minh bạch", MoTa = "Hạn giữ chỗ hiện ngay trên đơn, cả nhóm cùng thấy đồng hồ đếm ngược.", GhiChu = "Ghế đã trả luôn được giữ, chỉ ghế chưa trả bị nhả", Moc = "" },
            new { Anh = "ly-do-ban-do.jpg", Icon = "i-route", Ten = "Xem trước hành trình trên bản đồ", MoTa = "Trang tour có bản đồ 3D vẽ các điểm dừng của lịch trình.", GhiChu = "Đường đi theo đường thật, có nền vệ tinh", Moc = "" },
            new { Anh = "ly-do-lich.jpg", Icon = "i-calendar", Ten = "Chọn ngày theo lịch tháng", MoTa = "Xem mọi lịch khởi hành trên một tấm lịch để chọn ngày cả nhóm rảnh.", GhiChu = "Thấy ngay ngày nào còn chỗ, ngày nào sắp hết", Moc = "" }
        };
    }
    <section class="tv-section tc-ly-do-khoi">
        <div class="tc-tieu-de">
            <h2>6 lý do chọn TravelVN cho chuyến đi nhóm</h2>
        </div>
        <div class="tc-ly-do-luoi">
            @foreach (var l in lyDo)
            {
                <article class="tc-ly-do">
                    <div class="tc-ly-do-the">
                        <div class="tc-ly-do-anh">
                            <img src="~/images/ly-do/@l.Anh" alt="" loading="lazy" />
                            <span class="tc-ly-do-icon"><svg class="tv-icon" aria-hidden="true"><use href="#@l.Icon" /></svg></span>
                            @if (!string.IsNullOrEmpty(l.Moc))
                            {
                                <span class="tv-moc tv-moc-xanh tc-ly-do-moc" aria-hidden="true">@l.Moc</span>
                            }
                        </div>
                        <h3>@l.Ten</h3>
                        <p>@l.MoTa</p>
                    </div>
                    <div class="tc-ly-do-cuong">
                        <svg class="tv-icon" aria-hidden="true"><use href="#i-plane" /></svg>
                        <span>@l.GhiChu</span>
                    </div>
                </article>
            }
        </div>
    </section>

    @* ===== 3. So sánh hai tấm vé: cách đặt cũ và cách của TravelVN ===== *@
    <section class="tv-section">
        <div class="tc-tieu-de">
            <h2>Hai cách đặt tour cho một nhóm</h2>
        </div>
        <div class="tc-so-sanh">
            <div class="tv-ve tc-so-ve tc-so-cu">
                <div class="tc-so-dau"><h3>Kiểu cũ</h3><span class="tv-ma">MỘT NGƯỜI LO HẾT</span></div>
                <div class="tv-ve-duc-lo" aria-hidden="true"></div>
                <ul>
                    <li>Một người đứng ra đặt và ứng tiền cho cả nhóm</li>
                    <li>Gom ảnh giấy tờ của từng người qua tin nhắn</li>
                    <li>Đi đòi lại tiền từng người, có khi sau chuyến đi</li>
                    <li>Không biết ai đã trả, ai chưa</li>
                    <li>Không có hạn chốt, cả nhóm chờ người chậm nhất</li>
                </ul>
            </div>
            <span class="tc-so-vs" aria-hidden="true">VS</span>
            <div class="tv-ve tc-so-ve tc-so-moi">
                <div class="tc-so-dau"><h3>Trên TravelVN</h3><span class="tv-ma">MỖI NGƯỜI MỘT GHẾ</span></div>
                <div class="tv-ve-duc-lo" aria-hidden="true"></div>
                <ul>
                    <li>Trưởng nhóm chỉ giữ chỗ và trả phần ghế của mình</li>
                    <li>Mỗi người tự điền thông tin của mình</li>
                    <li>Mỗi người tự chuyển khoản phần mình bằng mã QR</li>
                    <li>Bảng ghế cho thấy ngay ai đã trả</li>
                    <li>Có hạn giữ chỗ, quá hạn ghế chưa trả tự nhả</li>
                </ul>
            </div>
        </div>
    </section>

    @* ===== 4. Tất cả tour, lọc nhanh trong nước / nước ngoài ===== *@
    <section class="tv-section">
        <div class="tv-section-head">
            <div>
                <h2>Chọn tour</h2>
                <p>Chọn một tour để xem lịch trình và các ngày khởi hành.</p>
            </div>
            <a asp-controller="DiaDiem" asp-action="DanhSach" class="tv-link tv-link-di">Xem tất cả tour</a>
        </div>

        @if (dsTour.Any())
        {
            if (tourTrongNuoc.Any() && tourNgoaiNuoc.Any())
            {
                <div class="tc-loc" role="group" aria-label="Lọc tour">
                    <button type="button" class="tv-chip active" data-loc="" aria-pressed="true">Tất cả</button>
                    <button type="button" class="tv-chip" data-loc="trong" aria-pressed="false">Trong nước</button>
                    <button type="button" class="tv-chip" data-loc="ngoai" aria-pressed="false">Nước ngoài</button>
                </div>
            }
            <div class="tv-grid-photo" id="tcLuoiTour">
                @foreach (var x in dsTour)
                {
                    <div class="tc-o-tour" data-nhom="@x.Nhom">
                        <partial name="_TheTour" model="x.Tour" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="tv-empty">
                <h3>Chưa có tour để hiển thị</h3>
                <p>Vui lòng quay lại sau.</p>
            </div>
        }
    </section>

    @* ===== 5. Đi đâu: quả địa cầu bên trái, lưới điểm đến lấy từ tour đang bán bên phải, viền kiểu phong bì thư máy bay ===== *@
    <section class="tv-section tc-di-dau">
        <div class="tc-tieu-de">
            <h2>Nhóm bạn muốn đi đâu?</h2>
        </div>
        <div class="tc-di-dau-hang">
            @* Quả địa cầu 3D (wwwroot/js/hero-3d.js): mỗi điểm đến có tour là một chấm, bấm vào để xem tour.
               Giữ id hero-globe và các lớp hero-globe-* vì script tìm theo tên này *@
            <figure class="tc-dia-cau">
                <div id="hero-globe" class="hero-globe" data-tour="@Url.Action("DanhSach", "DiaDiem")"
                     data-diem="@System.Text.Json.JsonSerializer.Serialize(ViewBag.DiemQuaDiaCau)">
                    <canvas aria-hidden="true"></canvas>
                    <a class="hero-globe-label" href="#" tabindex="-1">Việt Nam</a>
                </div>
                <figcaption>Xoay quả địa cầu, bấm vào một điểm đến để xem tour ở đó.</figcaption>
            </figure>

            @if (diemDen.Count >= 3)
            {
                <div class="tc-luoi-diem">
                    @foreach (var d in diemDen.Take(5))
                    {
                        <a asp-controller="DiaDiem" asp-action="DanhSach" asp-route-keyword="@d.Ten" class="tc-o-diem">
                            <img src="~/images/dulich/@d.Anh" alt="" loading="lazy" />
                            <span class="tc-o-diem-chu">
                                <strong>@d.Ten</strong>
                                <small>@d.SoTour tour</small>
                                <span class="tc-o-diem-xem" aria-hidden="true">Xem tour <svg class="tv-icon"><use href="#i-arrow" /></svg></span>
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </section>

    @* ===== 6. Đặt nhóm trên TravelVN: 6 việc web làm thay trưởng nhóm (đều là tính năng đã chạy) ===== *@
    <section class="tv-section" id="dat-nhom">
        <div class="tc-tieu-de">
            <h2>Đặt nhóm trên TravelVN</h2>
            <p>Những việc trước đây một người phải ôm hết, giờ chia đều cho cả nhóm.</p>
        </div>
        <div class="tc-tinh-nang">
            <article>
                <div class="tc-mini"><span class="tc-mini-dong-ho tv-ma">@(soGio.ToString("00")):00:00</span><small>còn lại để cả nhóm trả</small></div>
                <h3>Giữ chỗ có hạn</h3>
                <p>Ghế được giữ tối đa @soGio giờ. Hết hạn mà chưa trả thì ghế đó được nhả cho người khác.</p>
            </article>
            <article>
                <div class="tc-mini"><span class="tc-mini-link tv-ma"><svg class="tv-icon" aria-hidden="true"><use href="#i-send" /></svg>Link mời nhóm</span><small>dán vào Zalo, Messenger</small></div>
                <h3>Một link cho cả nhóm</h3>
                <p>Trưởng nhóm gửi một link vào nhóm chat, mỗi người tự bấm vào và nhận một ghế.</p>
            </article>
            <article>
                <div class="tc-mini tc-mini-form" aria-hidden="true"><span></span><span></span><span class="ngan"></span></div>
                <h3>Ai nấy tự điền</h3>
                <p>Mỗi người tự điền họ tên, ngày sinh và giấy tờ của mình. Không phải chụp gửi cho trưởng nhóm.</p>
            </article>
            <article>
                <div class="tc-mini"><span class="tc-mini-qr" aria-hidden="true"></span><span class="tv-ma">TV-K7Q2PX-3</span></div>
                <h3>Mỗi người một mã QR</h3>
                <p>Mỗi ghế có mã QR và nội dung chuyển khoản riêng, nên tiền của ai vào ghế người đó.</p>
            </article>
            <article>
                <div class="tc-mini"><span class="tc-mini-nhac"><svg class="tv-icon" aria-hidden="true"><use href="#i-clock" /></svg>Ghế 03 sắp hết hạn giữ chỗ</span></div>
                <h3>Nhắc trước khi hết hạn</h3>
                <p>Ai đăng nhập mà còn ghế chưa trả sẽ thấy lời nhắc ngay trên web, kèm thời gian còn lại.</p>
            </article>
            <article>
                <div class="tc-mini"><span class="tc-mini-an tv-ma">079 ••• •• 312</span><small>trưởng nhóm thấy</small></div>
                <h3>Giấy tờ giữ riêng</h3>
                <p>Trưởng nhóm thấy ai đã trả nhưng không thấy số giấy tờ của người khác.</p>
            </article>
        </div>
    </section>

    @* ===== 7. Bảng ghế của một đơn nhóm (minh họa) và mã giảm giá ===== *@
    <section class="tv-section home-nhom">
        <div class="home-nhom-chu">
            <h2>Mỗi ghế là một tấm vé có chủ</h2>
            <p>Trưởng nhóm và cả nhóm cùng nhìn một bảng ghế. Ghế nào đã trả được đóng mộc, ghế nào còn trống thấy ngay.</p>
            <ol class="home-nhom-buoc">
                <li>Một người giữ chỗ và gửi link mời vào nhóm chat.</li>
