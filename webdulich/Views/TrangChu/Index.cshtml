@using Microsoft.AspNetCore.Http
@model List<webdulich.Models.Tour>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --navy-950: #060d1a;
        --navy-900: #0b162c;
        --navy-800: #132342;
        --gold-500: #d4a359;
        --gold-400: #e6b973;
        --gold-soft: rgba(212, 163, 89, 0.14);
        --brand-blue: #0f62fe;
        --brand-coral: #ff5722;
        --brand-coral-hover: #e64a19;
        --emerald: #059669;
        --surface-bg: #f8f9fc;
        --surface-card: #ffffff;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #64748b;
        --border-subtle: #e2e8f0;
        --border-focus: #cbd5e1;
        --shadow-sm: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
        --shadow-md: 0 12px 32px -4px rgba(15, 23, 42, 0.08);
        --shadow-lg: 0 24px 56px -8px rgba(11, 22, 44, 0.14);
        --radius-sm: 10px;
        --radius-md: 16px;
        --radius-lg: 24px;
        --radius-xl: 32px;
    }

    body {
        background: var(--surface-bg) !important;
        color: var(--text-primary);
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    .home-modern {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        overflow-x: hidden;
    }

    .home-inner {
        max-width: 1340px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ================= HERO SECTION ================= */
    .modern-hero {
        position: relative;
        min-height: 690px;
        padding: 72px 0 96px;
        color: #ffffff;
        overflow: hidden;
        background: var(--navy-950);
        display: flex;
        align-items: center;
    }

    .hero-banner-slider {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
    }

    .hero-banner-slide {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        opacity: 0;
        transform: scale(1.06);
        transition: opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1), transform 6s ease-out;
    }

        .hero-banner-slide.active {
            opacity: 1;
            transform: scale(1);
        }

    /* Lớp phủ đa tầng giúp chữ luôn nổi bật trên mọi bức ảnh */
    .hero-banner-slider::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 35%, rgba(11, 22, 44, 0.45) 0%, rgba(6, 13, 26, 0.82) 100%), linear-gradient(180deg, rgba(6, 13, 26, 0.65) 0%, rgba(6, 13, 26, 0.35) 50%, rgba(6, 13, 26, 0.92) 100%);
        z-index: 1;
    }

    .hero-slider-btn {
        position: absolute;
        top: 50%;
        z-index: 5;
        width: 48px;
        height: 48px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 50%;
        background: rgba(11, 22, 44, 0.45);
        backdrop-filter: blur(12px);
        color: #ffffff;
        display: grid;
        place-items: center;
        cursor: pointer;
        transform: translateY(-50%);
        transition: all 0.25s ease;
    }

        .hero-slider-btn:hover {
            background: var(--gold-500);
            border-color: var(--gold-500);
            color: var(--navy-950);
            transform: translateY(-50%) scale(1.06);
        }

    .hero-slider-prev {
        left: 28px;
    }

    .hero-slider-next {
        right: 28px;
    }

    .hero-slider-dots {
        position: absolute;
        left: 50%;
        bottom: 42px;
        z-index: 5;
        display: flex;
        gap: 8px;
        transform: translateX(-50%);
    }

    .hero-dot {
        width: 8px;
        height: 8px;
        border: none;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.35);
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
    }

        .hero-dot.active {
            width: 32px;
            background: var(--gold-400);
        }

    .hero-content-modern {
        position: relative;
        z-index: 2;
        max-width: 1040px;
        margin: 0 auto;
        text-align: center;
    }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 18px;
        border-radius: 999px;
        background: rgba(212, 163, 89, 0.16);
        border: 1px solid rgba(212, 163, 89, 0.45);
        backdrop-filter: blur(12px);
        color: var(--gold-400);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    .hero-title-modern {
        font-size: clamp(2.5rem, 4.8vw, 4.35rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.12;
        margin-bottom: 18px;
        color: #ffffff;
        text-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

        .hero-title-modern em {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-style: italic;
            font-weight: 600;
            color: var(--gold-400);
            font-size: 1.12em;
            letter-spacing: 0;
        }

    .hero-subtitle-modern {
        font-size: clamp(1rem, 1.5vw, 1.18rem);
        color: rgba(255, 255, 255, 0.82);
        max-width: 680px;
        margin: 0 auto 30px;
        font-weight: 400;
        line-height: 1.65;
    }

    /* Navigation Pills */
    .travel-tabs {
        display: inline-flex;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
        padding: 6px;
        border-radius: 999px;
        background: rgba(11, 22, 44, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(16px);
        margin: 0 auto 24px;
    }

    .travel-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 999px;
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .travel-tab svg {
            width: 16px;
            height: 16px;
            stroke-width: 2;
            color: var(--gold-400);
            transition: transform 0.25s ease;
        }

        .travel-tab:hover,
        .travel-tab.active {
            background: rgba(255, 255, 255, 0.14);
            color: #ffffff;
        }

            .travel-tab:hover svg {
                transform: translateY(-1px);
            }

    /* Executive Search Command Bar */
    .search-panel-modern {
        max-width: 920px;
        margin: 0 auto;
        padding: 14px 18px 16px;
        border-radius: var(--radius-lg);
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 28px 64px rgba(4, 10, 24, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.9);
    }

    .search-form-modern {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f5f9;
    }

    .search-input-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 56px;
        padding: 0 16px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }

        .search-input-wrap:focus-within {
            background: #ffffff;
            border-color: var(--brand-blue);
            box-shadow: 0 0 0 4px rgba(15, 98, 254, 0.08);
        }

    .search-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: #eff6ff;
        color: var(--brand-blue);
        flex-shrink: 0;
    }

    .search-input-wrap input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        color: var(--text-primary);
        font-size: 1rem;
        font-weight: 600;
    }

        .search-input-wrap input::placeholder {
            color: #94a3b8;
            font-weight: 500;
        }

    .search-btn-modern {
        border: none;
        border-radius: 14px;
        height: 56px;
        padding: 0 32px;
        background: linear-gradient(135deg, var(--brand-coral), #ff7043);
        color: #ffffff;
        font-size: 0.96rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(255, 87, 34, 0.28);
        transition: all 0.25s ease;
    }

        .search-btn-modern:hover {
            background: linear-gradient(135deg, var(--brand-coral-hover), var(--brand-coral));
            transform: translateY(-1px);
            box-shadow: 0 14px 30px rgba(255, 87, 34, 0.38);
        }

    .quick-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
        padding: 0 4px;
    }

    .quick-row-label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    .quick-chip-group {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .quick-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 13px;
        border-radius: 999px;
        background: #f1f5f9;
        color: var(--text-secondary);
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }

        .quick-chip svg {
            width: 14px;
            height: 14px;
            color: var(--brand-blue);
        }

        .quick-chip:hover {
            background: #eff6ff;
            color: var(--brand-blue);
            border-color: #bfdbfe;
        }

    /* Trust Metrics Bar */
    .hero-trust {
        max-width: 920px;
        margin: 28px auto 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        background: rgba(11, 22, 44, 0.68);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(16px);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    .trust-card {
        padding: 16px 20px;
        text-align: left;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .trust-card:last-child {
            border-right: none;
        }

    .trust-card-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(212, 163, 89, 0.15);
        border: 1px solid rgba(212, 163, 89, 0.3);
        color: var(--gold-400);
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .trust-card strong {
        display: block;
        font-size: 1rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
    }

    .trust-card span {
        color: rgba(255, 255, 255, 0.68);
        font-size: 0.8rem;
        font-weight: 500;
    }

    /* ================= TICKER BAR ================= */
    .marquee-container {
        margin: -26px auto 0;
        position: relative;
        z-index: 4;
        max-width: 1180px;
        overflow: hidden;
        background: var(--navy-900);
        border: 1px solid rgba(212, 163, 89, 0.35);
        color: #ffffff;
        border-radius: 999px;
        padding: 12px 24px;
        box-shadow: var(--shadow-md);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .marquee-badge {
        background: var(--gold-500);
        color: var(--navy-950);
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 4px 10px;
        border-radius: 999px;
        flex-shrink: 0;
    }

    .marquee-viewport {
        overflow: hidden;
        flex: 1;
    }

    .marquee-text {
        display: inline-block;
        white-space: nowrap;
        padding-left: 100%;
        animation: marquee 22s linear infinite;
        font-weight: 600;
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 0.02em;
    }

        .marquee-text:hover {
            animation-play-state: paused;
        }

    @@keyframes marquee {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-100%);
        }
    }

    /* ================= SECTION HEADERS ================= */
    .section-block {
        padding: 76px 0 0;
    }

    .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 32px;
    }

    .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--brand-coral);
        font-weight: 800;
        letter-spacing: 0.1em;
        font-size: 0.76rem;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

        .section-kicker::before {
            content: "";
            width: 20px;
            height: 2px;
            background: currentColor;
            border-radius: 2px;
        }

    .section-title {
        color: var(--text-primary);
        font-size: clamp(1.75rem, 2.8vw, 2.4rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.18;
        margin: 0;
    }

    .section-desc {
        color: var(--text-muted);
        font-size: 0.98rem;
        font-weight: 500;
        margin: 8px 0 0;
        max-width: 620px;
        line-height: 1.6;
    }

    .section-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: var(--shadow-sm);
        transition: all 0.25s ease;
    }

        .section-link:hover {
            border-color: var(--navy-900);
            background: var(--navy-900);
            color: #ffffff;
            transform: translateY(-2px);
        }

    /* ================= PROMO VOUCHERS (BOARDING PASS STYLE) ================= */
    .promo-home-section {
        padding: 64px 0 0;
    }

    .promo-slider {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(320px, 410px);
        gap: 20px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding: 6px 4px 20px;
        scrollbar-width: thin;
    }

    .promo-card-home {
        position: relative;
        border-radius: 20px;
        color: #ffffff;
        padding: 24px 26px;
        overflow: hidden;
        scroll-snap-align: start;
        box-shadow: var(--shadow-md);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 190px;
        border: 1px solid rgba(255, 255, 255, 0.18);
    }

        /* Rãnh vé máy bay 2 bên */
        .promo-card-home::before,
        .promo-card-home::after {
            content: "";
            position: absolute;
            top: 62%;
            width: 24px;
            height: 24px;
            background: var(--surface-bg);
            border-radius: 50%;
            z-index: 2;
        }

        .promo-card-home::before {
            left: -13px;
        }

        .promo-card-home::after {
            right: -13px;
        }

    .promo-card-top {
        position: relative;
        z-index: 1;
        padding-bottom: 14px;
        border-bottom: 1px dashed rgba(255, 255, 255, 0.35);
        margin-bottom: 14px;
    }

    .promo-badge-mini {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 3px 9px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.2);
        margin-bottom: 8px;
    }

    .promo-card-home h3 {
        margin: 0 0 6px;
        font-size: 1.3rem;
        font-weight: 800;
        letter-spacing: -0.01em;
    }

    .promo-card-home p {
        margin: 0;
        font-size: 0.88rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.88);
        line-height: 1.45;
    }

    .promo-card-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        position: relative;
        z-index: 1;
    }

    .promo-code-pill {
        font-family: monospace;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        background: rgba(0, 0, 0, 0.22);
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .promo-copy-btn {
        border: none;
        border-radius: 10px;
        padding: 9px 16px;
        background: #ffffff;
        color: var(--navy-900);
        font-size: 0.84rem;
        font-weight: 800;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        transition: all 0.2s ease;
    }

        .promo-copy-btn:hover {
            transform: translateY(-2px);
            background: var(--navy-900);
            color: #ffffff;
        }

    .promo-toast {
        position: fixed;
        left: 50%;
        bottom: 30px;
        transform: translateX(-50%) translateY(20px);
        opacity: 0;
        padding: 12px 22px;
        border-radius: 999px;
        background: var(--navy-900);
        border: 1px solid var(--gold-500);
        color: var(--gold-400);
        font-weight: 700;
        font-size: 0.9rem;
        z-index: 9999;
        box-shadow: var(--shadow-lg);
        transition: 0.25s;
        pointer-events: none;
    }

        .promo-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

    /* ================= TOUR CARDS (BESPOKE OTA STYLE) ================= */
    .tour-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px;
    }

    .tour-card {
        background: var(--surface-card);
        border-radius: var(--radius-lg);
        overflow: hidden;
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-sm);
        transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .tour-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
            border-color: #cbd5e1;
        }

    .tour-image-wrap {
        position: relative;
        height: 240px;
        overflow: hidden;
        background: var(--navy-900);
    }

        .tour-image-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        }

    .tour-card:hover .tour-image-wrap img {
        transform: scale(1.07);
    }

    .tour-image-wrap::after {
        content: "";
        position: absolute;
        inset: auto 0 0 0;
        height: 45%;
        background: linear-gradient(to top, rgba(6, 13, 26, 0.65), transparent);
        pointer-events: none;
    }

    .tour-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(11, 22, 44, 0.78);
        border: 1px solid rgba(212, 163, 89, 0.5);
        backdrop-filter: blur(8px);
        color: var(--gold-400);
        font-weight: 700;
        font-size: 0.74rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .tour-duration-pill {
        position: absolute;
        bottom: 14px;
        left: 16px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(6px);
        color: var(--navy-900);
        font-size: 0.78rem;
        font-weight: 700;
    }

    .tour-body {
        padding: 22px 24px 24px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .tour-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
    }

    .tour-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #f1f5f9;
        color: var(--text-secondary);
    }

    .tag-blue {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .tag-yellow {
        background: #fef3c7;
        color: #b45309;
    }

    .tag-cyan {
        background: #ecfdf5;
        color: #047857;
    }

    .tour-title {
        font-size: 1.16rem;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 8px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3.2em;
    }

    .tour-desc {
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.55;
        margin-bottom: 20px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
